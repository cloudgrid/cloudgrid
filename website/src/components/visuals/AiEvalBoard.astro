---
/**
 * Mock AI evaluation scoreboard. Uses current product language: dataset
 * evaluation, model alias, metric deltas, row evidence, and trace links.
 */
const summary = [
  { label: "Exact match", value: "82%", delta: "+14pp", tone: "good" },
  { label: "Pass rate", value: "91%", delta: "+9pp", tone: "good" },
  { label: "p95 latency", value: "420 ms", delta: "-18%", tone: "good" },
  { label: "Regressions", value: "3", delta: "-5", tone: "warn" },
  { label: "Improvements", value: "28", delta: "+11", tone: "good" },
];

const rows = [
  {
    caseId: "cls-041",
    input: "refund request",
    expected: "billing_refund",
    actual: "billing_refund",
    score: "pass",
    summary: "Matched refund intent and ignored invoice wording.",
    trace: "trc_92ad",
  },
  {
    caseId: "ext-018",
    input: "order email",
    expected: "ORD-10482",
    actual: "ORD-10482",
    score: "pass",
    summary: "Extracted order id, total, currency, and two items.",
    trace: "trc_a18f",
  },
  {
    caseId: "cls-077",
    input: "cancel + VAT",
    expected: "cancellation",
    actual: "billing_invoice",
    score: "fail",
    summary: "Overweighted VAT detail; needs prompt example.",
    trace: "trc_c443",
  },
  {
    caseId: "ext-022",
    input: "chat order",
    expected: "FR",
    actual: "FR",
    score: "pass",
    summary: "Normalized country name and retained item quantity.",
    trace: "trc_d091",
  },
];

const scoreClass = (score: string) =>
  score === "pass"
    ? "text-[color:var(--color-emerald)] bg-emerald-soft"
    : "text-[color:var(--color-rose)] bg-rose-soft";

const toneColor = (tone: string) =>
  tone === "good"
    ? "var(--color-emerald)"
    : tone === "warn"
      ? "var(--color-amber)"
      : "var(--color-rose)";
---

<div class="bg-recessed p-3 sm:p-4">
  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-border-subtle pb-3">
    <div class="min-w-0">
      <div class="text-xs font-semibold text-text">Evaluation run · support-quality-validation</div>
      <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-text-muted font-mono">
        <span>dataset: support-intents-v7</span>
        <span>split: validation</span>
        <span>model alias: judge-fast</span>
        <span>rows: 124</span>
      </div>
    </div>
    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-soft px-2 py-1 text-[10px] font-semibold text-[color:var(--color-emerald)]">
      <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-emerald)]"></span>
      complete
    </span>
  </div>

  <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-5">
    {summary.map((item) => (
      <div class="rounded-lg border border-border-subtle bg-surface p-3">
        <div class="text-[10px] text-text-muted">{item.label}</div>
        <div class="mt-1 text-base font-semibold text-text font-mono">{item.value}</div>
        <div class="mt-0.5 text-[10px] font-mono" style={`color:${toneColor(item.tone)}`}>
          {item.delta}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-3 overflow-hidden rounded-lg border border-border-subtle bg-surface">
    <div class="overflow-x-auto">
      <div class="min-w-[760px]">
        <div class="grid grid-cols-[72px_96px_112px_112px_64px_minmax(180px,1fr)_72px] gap-2 border-b border-border-subtle bg-recessed px-3 py-2 text-[10px] font-medium uppercase tracking-wider text-text-muted">
          <div>row</div>
          <div>input</div>
          <div>expected</div>
          <div>actual</div>
          <div>metric</div>
          <div>trajectory summary</div>
          <div>trace</div>
        </div>
        {rows.map((row) => (
          <div class="grid grid-cols-[72px_96px_112px_112px_64px_minmax(180px,1fr)_72px] gap-2 border-b border-border-subtle px-3 py-2 text-xs last:border-b-0">
            <span class="font-mono text-text-secondary">{row.caseId}</span>
            <span class="truncate text-text-secondary">{row.input}</span>
            <span class="truncate font-mono text-text">{row.expected}</span>
            <span class="truncate font-mono text-text">{row.actual}</span>
            <span class={`w-fit rounded px-1.5 py-0.5 text-[10px] font-semibold ${scoreClass(row.score)}`}>
              {row.score}
            </span>
            <span class="truncate text-text-secondary">{row.summary}</span>
            <span class="font-mono text-[color:var(--color-brand)]">{row.trace}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
