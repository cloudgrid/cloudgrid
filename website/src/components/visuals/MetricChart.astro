---
/**
 * Flat metric chart: two stacked series with an exemplar pin.
 */
const w = 720;
const h = 280;
const padL = 48;
const padR = 16;
const padT = 24;
const padB = 36;

// Generate two deterministic series (no Math.random, so the build is stable).
function series(seed: number, n = 32) {
  const pts: number[] = [];
  let v = 0.5;
  for (let i = 0; i < n; i++) {
    const x = i / (n - 1);
    const drift = Math.sin(x * Math.PI * 2 + seed) * 0.18 + Math.sin(x * 13 + seed * 3) * 0.06;
    v = Math.max(0.05, Math.min(0.95, 0.5 + drift));
    pts.push(v);
  }
  return pts;
}

const a = series(1.2);
const b = series(2.7);

const xFor = (i: number, n: number) => padL + (i / (n - 1)) * (w - padL - padR);
const yFor = (v: number) => h - padB - v * (h - padT - padB);

const pathFor = (pts: number[]) =>
  pts
    .map((p, i) => `${i === 0 ? "M" : "L"} ${xFor(i, pts.length).toFixed(1)} ${yFor(p).toFixed(1)}`)
    .join(" ");

const areaFor = (pts: number[]) =>
  `${pathFor(pts)} L ${xFor(pts.length - 1, pts.length).toFixed(1)} ${h - padB} L ${xFor(0, pts.length).toFixed(1)} ${h - padB} Z`;
---

<svg viewBox={`0 0 ${w} ${h}`} xmlns="http://www.w3.org/2000/svg" class="block w-full h-auto" role="img" aria-label="Metric chart">
  <!-- y grid -->
  {[0, 0.25, 0.5, 0.75, 1].map((v) => (
    <g>
      <line
        x1={padL}
        x2={w - padR}
        y1={yFor(v)}
        y2={yFor(v)}
        stroke="var(--color-border-subtle)"
        stroke-width="1"
      />
      <text x={padL - 8} y={yFor(v) + 3} font-size="9" text-anchor="end" fill="var(--color-text-muted)" font-family="JetBrains Mono, monospace">
        {(v * 100).toFixed(0)}
      </text>
    </g>
  ))}

  <!-- x labels -->
  {["−30m", "−25m", "−20m", "−15m", "−10m", "−5m", "now"].map((t, i) => (
    <text
      x={xFor(i * 5, 32)}
      y={h - 12}
      font-size="9"
      text-anchor="middle"
      fill="var(--color-text-muted)"
      font-family="JetBrains Mono, monospace"
    >
      {t}
    </text>
  ))}

  <!-- series A (brand) -->
  <path d={areaFor(a)} fill="var(--color-brand)" fill-opacity="0.12" />
  <path d={pathFor(a)} fill="none" stroke="var(--color-brand)" stroke-width="1.8" />

  <!-- series B (cyan) -->
  <path d={pathFor(b)} fill="none" stroke="var(--color-cyan)" stroke-width="1.8" stroke-dasharray="3 3" />

  <!-- exemplar pin -->
  <g transform={`translate(${xFor(22, 32)}, ${yFor(a[22])})`}>
    <circle r="5" fill="var(--color-violet)" />
    <circle r="9" fill="var(--color-violet)" fill-opacity="0.18" />
    <text x="10" y="-8" font-size="10" fill="var(--color-text)" font-family="Inter, sans-serif" font-weight="600">
      exemplar · trace 1a7b…c901
    </text>
  </g>

  <!-- legend -->
  <g transform="translate(48, 8)">
    <g>
      <line x1="0" x2="14" y1="6" y2="6" stroke="var(--color-brand)" stroke-width="2" />
      <text x="20" y="9" font-size="10" fill="var(--color-text-secondary)" font-family="Inter, sans-serif">
        http.server.duration · p95
      </text>
    </g>
    <g transform="translate(200, 0)">
      <line x1="0" x2="14" y1="6" y2="6" stroke="var(--color-cyan)" stroke-width="2" stroke-dasharray="3 3" />
      <text x="20" y="9" font-size="10" fill="var(--color-text-secondary)" font-family="Inter, sans-serif">
        gen_ai.token.count · sum
      </text>
    </g>
  </g>
</svg>
