---
const adapters = [
  {
    title: "Storage",
    port: "storage-read · storage-write",
    v1: "SurrealDB",
    color: "var(--color-cyan)",
    bullets: ["filter & facet pushdown", "idempotent persistence", "live trace fanout"],
  },
  {
    title: "Message bridge",
    port: "request/reply · streams · live · alert dispatch",
    v1: "NATS JetStream",
    color: "var(--color-brand)",
    bullets: ["durable ingest", "typed request/reply", "ephemeral session fanout"],
  },
  {
    title: "Alert delivery",
    port: "dispatch request · delivery result",
    v1: "in-app · email · webhook",
    color: "var(--color-amber)",
    bullets: ["core-owned alert state", "safe summaries only", "provider adapters over bridge"],
  },
  {
    title: "Auth provider",
    port: "OIDC/OAuth · session boundary",
    v1: "GitHub · Google · Entra ID",
    color: "var(--color-emerald)",
    bullets: ["BFF-managed cookies", "provider tokens stay server-side", "claim canonicalization"],
  },
  {
    title: "Evaluation execution",
    port: "run · score · optimize",
    v1: "adapter-backed",
    color: "var(--color-violet)",
    bullets: [
      "W3C trace context preserved",
      "provider refs stay controlled",
      "idempotent retries",
    ],
  },
];
---

<div class="grid sm:grid-cols-2 gap-5">
  {adapters.map((a, i) => (
    <div
      class="card spotlight is-interactive flex h-full flex-col p-6"
      data-delay={(i + 1) as any}
      style={`--accent: ${a.color};`}
    >
      <div class="flex items-center justify-between">
        <div class="chip" style={`background: color-mix(in srgb, ${a.color} 14%, transparent); color: ${a.color};`}>
          {a.title}
        </div>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border border-border-default bg-recessed text-text-muted">
          v1
        </span>
      </div>

      <div class="mt-5 flex items-stretch gap-3">
        <div class="flex-1 rounded-lg border border-dashed border-border-default px-3 py-2.5 text-xs font-mono text-text-secondary">
          {a.port}
        </div>
        <div class="flex items-center text-text-muted">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </div>
        <div
          class="flex-1 rounded-lg px-3 py-2.5 text-xs font-mono font-semibold"
          style={`background: color-mix(in srgb, ${a.color} 14%, transparent); color: ${a.color}; border: 1px solid color-mix(in srgb, ${a.color} 40%, transparent);`}
        >
          {a.v1}
        </div>
      </div>

      <ul class="mt-5 space-y-1.5 text-xs text-text-secondary">
        {a.bullets.map((b) => (
          <li class="flex gap-2 items-start">
            <span
              class="mt-1 inline-block w-1 h-1 rounded-full"
              style={`background:${a.color}`}
            ></span>
            {b}
          </li>
        ))}
      </ul>

      <div class="mt-auto pt-5 text-xs text-text-muted">
        Implement the port. Ship a new adapter. The v1 is one of many.
      </div>
    </div>
  ))}
</div>
