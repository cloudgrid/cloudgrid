---
const adapters = [
  {
    title: "Storage",
    port: "storage-read · storage-write",
    v1: "SurrealDB",
    color: "var(--color-cyan)",
  },
  {
    title: "Message bridge",
    port: "bridge ports · request/reply · streams",
    v1: "NATS JetStream",
    color: "var(--color-brand)",
  },
  {
    title: "Auth",
    port: "auth provider port",
    v1: "GitHub · Google · Entra ID",
    color: "var(--color-emerald)",
  },
  {
    title: "Eval harness",
    port: "harness adapter (HTTP)",
    v1: "puristajs/harness",
    color: "var(--color-violet)",
  },
];
---

<div class="grid sm:grid-cols-2 gap-4">
  {adapters.map((a) => (
    <div class="relative rounded-xl border border-border-default bg-surface p-5 overflow-hidden">
      <div class="flex items-center justify-between mb-3">
        <div class="text-xs font-semibold uppercase tracking-wider" style={`color:${a.color}`}>
          {a.title}
        </div>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border border-border-default bg-recessed text-text-muted">
          v1
        </span>
      </div>

      <!-- Port slot visual -->
      <div class="flex items-stretch gap-2 mb-3">
        <div class="flex-1 rounded-md border border-dashed border-border-default px-3 py-2 text-xs text-text-secondary font-mono">
          {a.port}
        </div>
        <div class="flex items-center text-text-muted">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </div>
        <div
          class="flex-1 rounded-md px-3 py-2 text-xs font-mono"
          style={`background: color-mix(in srgb, ${a.color} 12%, transparent); color:${a.color}; border:1px solid color-mix(in srgb, ${a.color} 35%, transparent);`}
        >
          {a.v1}
        </div>
      </div>

      <div class="text-xs text-text-muted">
        Implement the port; ship a new adapter. The v1 implementation is just one of many.
      </div>
    </div>
  ))}
</div>
