---
/**
 * Mock dashboard with 4 widgets: metric chart, log table, trace table, live counter.
 */
---

<div class="grid grid-cols-12 gap-3 p-4 bg-recessed">
  <!-- Widget: metric chart -->
  <div class="col-span-12 lg:col-span-7 rounded-lg border border-border-subtle bg-surface p-4">
    <div class="flex items-center justify-between mb-3">
      <div>
        <div class="text-xs font-semibold text-text">Request latency · p95</div>
        <div class="text-[10px] text-text-muted font-mono">metric · time-series</div>
      </div>
      <div class="text-[10px] text-text-muted font-mono">last 30m</div>
    </div>
    <svg viewBox="0 0 400 120" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
      {[0, 30, 60, 90].map((y) => (
        <line x1="20" x2="390" y1={20 + y * 0.7} y2={20 + y * 0.7} stroke="var(--color-border-subtle)" stroke-width="1" />
      ))}
      <path
        d="M 20 90 L 50 70 L 80 80 L 110 55 L 140 60 L 170 45 L 200 50 L 230 35 L 260 40 L 290 28 L 320 36 L 350 30 L 380 24"
        fill="none"
        stroke="var(--color-brand)"
        stroke-width="2"
      />
      <path
        d="M 20 90 L 50 70 L 80 80 L 110 55 L 140 60 L 170 45 L 200 50 L 230 35 L 260 40 L 290 28 L 320 36 L 350 30 L 380 24 L 380 110 L 20 110 Z"
        fill="var(--color-brand)"
        fill-opacity="0.1"
      />
    </svg>
  </div>

  <!-- Widget: live counter -->
  <div class="col-span-6 lg:col-span-5 rounded-lg border border-border-subtle bg-surface p-4">
    <div class="flex items-center justify-between mb-3">
      <div>
        <div class="text-xs font-semibold text-text">Spans / sec</div>
        <div class="text-[10px] text-text-muted font-mono">live · subscription</div>
      </div>
      <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-[color:var(--color-emerald)]">
        <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-emerald)]"></span>
        LIVE
      </span>
    </div>
    <div class="text-3xl font-semibold text-text font-mono">1,284</div>
    <div class="text-xs text-text-muted mt-1">+12% vs prior 5m window</div>
    <div class="mt-3 flex gap-0.5 items-end h-10">
      {[7, 9, 6, 11, 8, 13, 10, 12, 9, 14, 11, 15, 13].map((v) => (
        <div class="flex-1 rounded-sm bg-[color:var(--color-emerald)]" style={`opacity:.55; height:${v * 6}%`}></div>
      ))}
    </div>
  </div>

  <!-- Widget: trace table -->
  <div class="col-span-12 lg:col-span-7 rounded-lg border border-border-subtle bg-surface p-4">
    <div class="flex items-center justify-between mb-3">
      <div>
        <div class="text-xs font-semibold text-text">Slowest traces</div>
        <div class="text-[10px] text-text-muted font-mono">trace · table</div>
      </div>
      <div class="text-[10px] text-text-muted font-mono">last 1h</div>
    </div>
    <div class="text-xs">
      {[
        { svc: "agent-svc", op: "agent.run", dur: "612 ms", status: "OK" },
        { svc: "llm-router", op: "llm.chat", dur: "498 ms", status: "OK" },
        { svc: "retrieval", op: "vector.lookup", dur: "264 ms", status: "ERR" },
        { svc: "tool-router", op: "tool.web_search", dur: "212 ms", status: "OK" },
      ].map((r) => (
        <div class="grid grid-cols-[1fr_1fr_60px_40px] gap-2 py-1.5 border-b border-border-subtle last:border-b-0 items-center">
          <span class="font-mono text-text-secondary truncate">{r.svc}</span>
          <span class="font-mono text-text truncate">{r.op}</span>
          <span class="font-mono text-text-secondary text-right">{r.dur}</span>
          <span
            class="font-mono text-[10px] text-right"
            style={`color: ${r.status === "OK" ? "var(--color-emerald)" : "var(--color-rose)"}`}
          >
            {r.status}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Widget: log severity -->
  <div class="col-span-6 lg:col-span-5 rounded-lg border border-border-subtle bg-surface p-4">
    <div class="flex items-center justify-between mb-3">
      <div>
        <div class="text-xs font-semibold text-text">Logs by severity</div>
        <div class="text-[10px] text-text-muted font-mono">log · table</div>
      </div>
      <div class="text-[10px] text-text-muted font-mono">last 1h</div>
    </div>
    {[
      { sev: "ERROR", color: "var(--color-rose)", n: 18, pct: 8 },
      { sev: "WARN", color: "var(--color-amber)", n: 142, pct: 24 },
      { sev: "INFO", color: "var(--color-brand)", n: 12894, pct: 100 },
      { sev: "DEBUG", color: "var(--color-text-muted)", n: 4322, pct: 38 },
    ].map((r) => (
      <div class="grid grid-cols-[60px_1fr_50px] gap-3 items-center py-1.5">
        <span class="text-[10px] font-mono font-semibold" style={`color:${r.color}`}>{r.sev}</span>
        <div class="h-2 rounded-full bg-recessed overflow-hidden">
          <div class="h-full rounded-full" style={`width:${r.pct}%; background:${r.color}; opacity:.7`}></div>
        </div>
        <span class="text-xs font-mono text-text-secondary text-right">{r.n.toLocaleString()}</span>
      </div>
    ))}
  </div>
</div>
