---
/**
 * User-facing AI evaluation flow.
 *
 * Shows the product loop: collected telemetry becomes dataset rows, dataset
 * evaluations produce a scoreboard, comparisons feed optimization, and users
 * explicitly promote the winning target.
 */

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const steps = [
  {
    x: 70,
    y: 120,
    w: 170,
    h: 84,
    title: "Collected evidence",
    detail: "traces · logs · metrics",
    accent: "#4f46e5",
  },
  {
    x: 315,
    y: 120,
    w: 170,
    h: 84,
    title: "Dataset rows",
    detail: "input · expected · reason",
    accent: "#06b6d4",
  },
  {
    x: 560,
    y: 120,
    w: 170,
    h: 84,
    title: "Evaluation run",
    detail: "target · split · model alias",
    accent: "#8b5cf6",
  },
  {
    x: 805,
    y: 120,
    w: 170,
    h: 84,
    title: "Scoreboard",
    detail: "metrics · row evidence",
    accent: "#10b981",
  },
  {
    x: 315,
    y: 400,
    w: 170,
    h: 84,
    title: "Comparison",
    detail: "better · worse · tradeoffs",
    accent: "#f59e0b",
  },
  {
    x: 560,
    y: 400,
    w: 170,
    h: 84,
    title: "Optimization",
    detail: "quick-shot · validation",
    accent: "#8b5cf6",
  },
  {
    x: 805,
    y: 400,
    w: 170,
    h: 84,
    title: "Promote",
    detail: "explicit handoff",
    accent: "#10b981",
  },
];
---

<div class={`relative overflow-hidden rounded-2xl border border-border-default shadow-[var(--shadow-lift)] ${className}`}>
  <div class="canvas-surface relative">
    <svg
      viewBox="0 0 1040 620"
      xmlns="http://www.w3.org/2000/svg"
      class="block h-auto w-full"
      role="img"
      aria-label="CloudGrid AI evaluation workflow"
    >
      <defs>
        <marker id="eval-user-arrow" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
          <path class="cv-arrow-fill" d="M0,0 L12,6 L0,12 Z" />
        </marker>
        <radialGradient id="eval-user-glow" cx="50%" cy="50%" r="65%">
          <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.22" />
          <stop offset="70%" stop-color="#8b5cf6" stop-opacity="0" />
        </radialGradient>
      </defs>

      <circle cx="635" cy="300" r="260" fill="url(#eval-user-glow)" />

      <g class="cv-line" stroke-width="1.6" marker-end="url(#eval-user-arrow)">
        <path d="M240 162 H315" />
        <path d="M485 162 H560" />
        <path d="M730 162 H805" />
        <path d="M890 204 C890 280 890 340 890 400" />
        <path d="M805 442 H730" />
        <path d="M560 442 H485" />
        <path d="M400 400 C400 330 400 275 560 204" stroke-dasharray="4 5" />
      </g>

      <g font-family="Geist Mono, monospace" font-size="10" class="cv-text-faint" letter-spacing="1.5">
        <text x="70" y="74">COLLECT</text>
        <text x="315" y="74">CURATE</text>
        <text x="560" y="74">EVALUATE</text>
        <text x="805" y="74">DECIDE</text>
        <text x="315" y="535">ITERATE WITH EVIDENCE</text>
      </g>

      {steps.map((step) => (
        <g>
          <rect class="cv-node" x={step.x} y={step.y} width={step.w} height={step.h} rx="16" stroke={step.accent} stroke-opacity="0.35" />
          <circle cx={step.x + 24} cy={step.y + 26} r="8" fill={step.accent} fill-opacity="0.22" stroke={step.accent} stroke-width="1.5" />
          <text x={step.x + 44} y={step.y + 32} class="cv-text" font-family="Geist, sans-serif" font-size="13" font-weight="700">
            {step.title}
          </text>
          <text x={step.x + 20} y={step.y + 60} class="cv-text-faint" font-family="Geist Mono, monospace" font-size="10">
            {step.detail}
          </text>
        </g>
      ))}

      <g>
        <rect class="cv-node-accent" x="70" y="400" width="170" height="84" rx="16" stroke="#f43f5e" stroke-opacity="0.35" />
        <text x="94" y="432" class="cv-text" font-family="Geist, sans-serif" font-size="13" font-weight="700">Trace-derived cases</text>
        <text x="94" y="460" class="cv-text-faint" font-family="Geist Mono, monospace" font-size="10">observed output · source link</text>
        <path d="M155 204 C155 280 155 340 155 400" class="cv-line" stroke-width="1.6" marker-end="url(#eval-user-arrow)" />
        <path d="M240 442 H315" class="cv-line" stroke-width="1.6" marker-end="url(#eval-user-arrow)" />
      </g>

      <g font-family="Geist, sans-serif" font-size="12" class="cv-text-muted">
        <text x="70" y="570">The evaluation itself produces metrics and evidence. Promotion stays an explicit user decision.</text>
      </g>
    </svg>
  </div>
</div>
