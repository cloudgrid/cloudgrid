---
/**
 * EvalFlowCanvas — n8n-style flow for the AI evaluation pipeline.
 *
 * Visualizes: agent spans arrive → AI projections persist → online policy
 * matches → harness scorers run → results persist → dashboards / annotation
 * queue. Plus the offline experiment branch: dataset → experiment run →
 * harness optimize → prompt versions.
 *
 * Theme-aware via cv-* tokens. Accent colors carry semantic meaning.
 */

interface Props {
  showLegend?: boolean;
  class?: string;
}
const { showLegend = true, class: className = "" } = Astro.props;
---

<div class={`relative rounded-2xl overflow-hidden border border-border-default shadow-[var(--shadow-lift)] ${className}`}>
  <div class="canvas-surface relative">
    <svg
      viewBox="0 0 1240 760"
      xmlns="http://www.w3.org/2000/svg"
      class="block w-full h-auto"
      role="img"
      aria-label="CloudGrid AI evaluation flow"
    >
      <defs>
        <marker id="ev-arrow" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
          <path class="cv-arrow-fill" d="M0,0 L12,6 L0,12 Z" />
        </marker>
        <marker id="ev-arrow-violet" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
          <path d="M0,0 L12,6 L0,12 Z" fill="#8b5cf6" />
        </marker>
        <marker id="ev-arrow-good" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
          <path d="M0,0 L12,6 L0,12 Z" fill="#10b981" />
        </marker>
        <marker id="ev-arrow-bad" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
          <path d="M0,0 L12,6 L0,12 Z" fill="#f59e0b" />
        </marker>

        <radialGradient id="ev-core-glow" cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.40" />
          <stop offset="60%" stop-color="#8b5cf6" stop-opacity="0" />
        </radialGradient>

        <path id="ev-pAgentProj"   d="M 220 180 C 290 180, 320 180, 360 180" />
        <path id="ev-pProjPolicy"  d="M 500 180 C 560 180, 580 180, 620 180" />
        <path id="ev-pPolicyHarn"  d="M 760 180 C 820 180, 840 180, 880 180" />
        <path id="ev-pHarnResult"  d="M 1020 180 C 1080 180, 1100 220, 1100 280" />
        <path id="ev-pResultPass"  d="M 1100 360 C 1100 410, 1080 440, 1040 460" />
        <path id="ev-pResultFail"  d="M 1100 360 C 1100 430, 1100 480, 1100 540" />
        <path id="ev-pDatasetExp"  d="M 220 510 C 290 510, 320 510, 360 510" />
        <path id="ev-pExpHarn"     d="M 500 510 C 700 510, 800 510, 880 350" />
        <path id="ev-pOptimPrompt" d="M 1020 580 C 970 620, 900 640, 820 640" />
      </defs>

      <!-- Soft glow under the harness node -->
      <circle cx="950" cy="180" r="200" fill="url(#ev-core-glow)" opacity="0.7" />

      <!-- Lane labels -->
      <g font-family="JetBrains Mono, monospace" font-size="10" class="cv-text-faint" letter-spacing="1.5">
        <text x="40" y="80">SOURCE SPANS</text>
        <text x="380" y="80">PROJECTIONS</text>
        <text x="640" y="80">POLICY</text>
        <text x="900" y="80">HARNESS</text>
        <text x="1080" y="80">OUTCOME</text>
        <text x="40" y="450">OFFLINE</text>
        <text x="1080" y="620">PROMOTE</text>
      </g>

      <!-- ONLINE LANE: source spans → projections → policy → harness → result -->
      <g>
        <!-- Agent spans trigger -->
        <path
          class="cv-node"
          d="M 60 145 L 200 145 A 18 18 0 0 1 218 163 L 218 197 A 18 18 0 0 1 200 215 L 60 215 A 35 35 0 0 1 60 145 Z"
          stroke-width="1"
        />
        <g transform="translate(72, 168)">
          <path d="M 7 0 L 0 12 L 5 12 L 3 22 L 12 8 L 7 8 Z" fill="#8b5cf6" />
        </g>
        <text x="106" y="180" class="cv-text" font-family="Inter, sans-serif" font-size="13" font-weight="600">Agent spans</text>
        <text x="106" y="198" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="10">OTel GenAI · OpenInference</text>
      </g>

      <!-- AI projections -->
      <g>
        <rect class="cv-node" x="360" y="140" width="140" height="80" rx="14" />
        <g transform="translate(378, 158)" stroke="#8b5cf6" fill="none" stroke-width="1.6" stroke-linecap="round">
          <rect x="0" y="0" width="20" height="6" rx="1.5" />
          <rect x="0" y="9" width="20" height="6" rx="1.5" />
          <rect x="0" y="18" width="12" height="6" rx="1.5" />
        </g>
        <text x="408" y="172" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600">AI projections</text>
        <text x="408" y="188" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">AgentRun · LlmCall</text>
        <text x="408" y="200" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">ToolCall · RetrievalEvent</text>
        <text x="408" y="212" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">pointer · never copies prompts</text>
      </g>

      <!-- Online policy gate (switch-style) -->
      <g>
        <rect class="cv-node" x="620" y="148" width="140" height="64" rx="12" />
        <g transform="translate(640, 162)" stroke="#06b6d4" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M 6 0 L 6 26" />
          <path d="M 6 4 L 18 4 L 22 8 L 18 12 L 6 12" fill="#06b6d4" fill-opacity="0.18" />
          <path d="M 6 16 L -6 16 L -10 20 L -6 24 L 6 24" fill="#94a3b8" fill-opacity="0.18" stroke="#94a3b8" />
        </g>
        <text x="690" y="172" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600" text-anchor="middle">Online policy</text>
        <text x="690" y="188" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5" text-anchor="middle">match · budget · concurrency</text>
        <text x="690" y="202" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5" text-anchor="middle">sample by agent / env / route</text>
      </g>

      <!-- AI-eval-runner / harness (central) -->
      <g>
        <rect class="cv-node-accent" x="880" y="120" width="140" height="120" rx="18" stroke="#8b5cf6" stroke-width="1.5" />
        <rect x="876" y="116" width="148" height="128" rx="22" fill="none" stroke="#8b5cf6" stroke-opacity="0.22" stroke-width="3" />
        <g transform="translate(902, 138)">
          <circle cx="14" cy="14" r="13" fill="#8b5cf6" fill-opacity="0.18" stroke="#8b5cf6" stroke-width="1.2" />
          <path d="M 8 14 L 14 20 L 22 8" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <text x="950" y="178" class="cv-text" font-family="Inter, sans-serif" font-size="13" font-weight="700" text-anchor="middle">ai-eval-runner</text>
        <text x="950" y="194" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5" text-anchor="middle">Go orchestrator</text>
        <text x="950" y="208" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5" text-anchor="middle">→ harness HTTP</text>

        <!-- adapter slots underneath -->
        <g font-family="JetBrains Mono, monospace" font-size="9" class="cv-text-muted">
          <g transform="translate(894, 240)">
            <path d="M 0 4 L 4 0 L 8 4 L 4 8 Z" fill="#10b981" />
            <text x="-2" y="22">/v1/score</text>
          </g>
          <g transform="translate(950, 240)">
            <path d="M 0 4 L 4 0 L 8 4 L 4 8 Z" fill="#06b6d4" />
            <text x="-2" y="22">/v1/run</text>
          </g>
          <g transform="translate(1000, 240)">
            <path d="M 0 4 L 4 0 L 8 4 L 4 8 Z" fill="#f59e0b" />
            <text x="-10" y="22">/v1/optimize</text>
          </g>
        </g>
      </g>

      <!-- Harness adapter chip below runner -->
      <g>
        <circle cx="950" cy="320" r="26" class="cv-port" />
        <text x="950" y="324" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" font-weight="700" fill="#8b5cf6">harness</text>
        <text x="950" y="368" text-anchor="middle" class="cv-text-muted" font-family="Inter, sans-serif" font-size="11">puristajs / harness</text>
        <text x="950" y="382" text-anchor="middle" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9">eval adapter (HTTP)</text>
        <path d="M 950 250 L 950 294" stroke="rgba(139,92,246,0.55)" stroke-width="1.2" stroke-dasharray="3 4" fill="none" />
      </g>

      <!-- EvalResult node -->
      <g>
        <rect class="cv-node" x="1040" y="280" width="160" height="80" rx="14" />
        <g transform="translate(1058, 298)" stroke="#10b981" fill="none" stroke-width="1.6" stroke-linecap="round">
          <rect x="0" y="0" width="20" height="20" rx="2" />
          <path d="M 4 10 L 9 14 L 16 5" />
        </g>
        <text x="1090" y="312" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600">EvalResult</text>
        <text x="1090" y="328" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">score · pass/fail</text>
        <text x="1090" y="342" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">judge / deterministic</text>
        <text x="1090" y="354" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">evidence summary</text>
      </g>

      <!-- Outcome: Dashboards (pass branch) -->
      <g>
        <rect class="cv-node" x="940" y="430" width="170" height="60" rx="14" />
        <g transform="translate(958, 446)" stroke="#10b981" fill="none" stroke-width="1.8" stroke-linecap="round">
          <rect x="0" y="0" width="9" height="9" rx="1.5" />
          <rect x="13" y="0" width="9" height="9" rx="1.5" opacity="0.6" />
          <rect x="0" y="13" width="9" height="9" rx="1.5" opacity="0.6" />
          <rect x="13" y="13" width="9" height="9" rx="1.5" />
        </g>
        <text x="1025" y="456" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600" text-anchor="middle">Quality dashboards</text>
        <text x="1025" y="472" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5" text-anchor="middle">trend · segment · drift</text>
      </g>
      <text x="1060" y="408" fill="#10b981" font-family="JetBrains Mono, monospace" font-size="10" font-weight="600">good</text>

      <!-- Outcome: Annotation queue (fail/low branch) -->
      <g>
        <rect class="cv-node" x="1040" y="540" width="170" height="60" rx="14" stroke="rgba(245,158,11,0.45)" />
        <g transform="translate(1058, 556)" stroke="#f59e0b" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M 0 0 H 20 V 16 H 14 L 10 22 L 6 16 H 0 Z" />
        </g>
        <text x="1125" y="566" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600" text-anchor="middle">Annotation queue</text>
        <text x="1125" y="582" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5" text-anchor="middle">review · turn into dataset item</text>
      </g>
      <text x="1116" y="510" fill="#f59e0b" font-family="JetBrains Mono, monospace" font-size="10" font-weight="600">low / fail</text>

      <!-- OFFLINE LANE: dataset → experiment → harness -->
      <g>
        <rect class="cv-node" x="60" y="478" width="160" height="64" rx="14" />
        <g transform="translate(78, 496)" stroke="#06b6d4" fill="none" stroke-width="1.8" stroke-linecap="round">
          <rect x="0" y="0" width="20" height="20" rx="2" />
          <line x1="0" y1="6" x2="20" y2="6" />
          <line x1="0" y1="12" x2="20" y2="12" />
          <line x1="0" y1="18" x2="20" y2="18" />
        </g>
        <text x="115" y="498" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600">Dataset</text>
        <text x="115" y="514" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">versioned · split-aware</text>
        <text x="115" y="528" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">holdout protected</text>
      </g>

      <g>
        <rect class="cv-node" x="360" y="478" width="140" height="64" rx="14" />
        <g transform="translate(378, 495)" stroke="#06b6d4" fill="none" stroke-width="2" stroke-linecap="round">
          <circle cx="10" cy="10" r="8" />
          <line x1="10" y1="3" x2="10" y2="10" />
          <line x1="10" y1="10" x2="14" y2="14" />
        </g>
        <text x="408" y="500" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600">ExperimentRun</text>
        <text x="408" y="516" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">immutable manifest</text>
        <text x="408" y="530" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5">progress streamed</text>
      </g>

      <!-- Prompt versions output -->
      <g>
        <rect class="cv-node" x="640" y="610" width="180" height="60" rx="14" />
        <g transform="translate(658, 626)" stroke="#f59e0b" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="0" y="0" width="18" height="22" rx="2" />
          <line x1="3" y1="5" x2="15" y2="5" />
          <line x1="3" y1="11" x2="15" y2="11" />
          <line x1="3" y1="17" x2="11" y2="17" />
        </g>
        <text x="730" y="638" class="cv-text" font-family="Inter, sans-serif" font-size="12" font-weight="600" text-anchor="middle">Prompt candidates</text>
        <text x="730" y="654" class="cv-text-faint" font-family="JetBrains Mono, monospace" font-size="9.5" text-anchor="middle">explicit promote · never auto</text>
      </g>

      <!-- ============ MAIN CONNECTOR LINES ============ -->
      <g class="cv-line" stroke-width="1.5">
        <use href="#ev-pAgentProj" marker-end="url(#ev-arrow)" />
        <use href="#ev-pProjPolicy" marker-end="url(#ev-arrow)" />
        <use href="#ev-pPolicyHarn" marker-end="url(#ev-arrow)" />
        <use href="#ev-pDatasetExp" marker-end="url(#ev-arrow)" />
      </g>
      <g fill="none" stroke="#8b5cf6" stroke-width="1.5">
        <use href="#ev-pHarnResult" marker-end="url(#ev-arrow-violet)" />
        <use href="#ev-pExpHarn" stroke-dasharray="3 4" />
      </g>
      <g fill="none" stroke="#10b981" stroke-width="1.5">
        <use href="#ev-pResultPass" marker-end="url(#ev-arrow-good)" />
      </g>
      <g fill="none" stroke="#f59e0b" stroke-width="1.5">
        <use href="#ev-pResultFail" marker-end="url(#ev-arrow-bad)" />
        <use href="#ev-pOptimPrompt" marker-end="url(#ev-arrow-bad)" />
      </g>

      <!-- Flow dots traveling along the major arteries -->
      <g>
        <circle r="3.5" fill="#8b5cf6">
          <animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#ev-pAgentProj" /></animateMotion>
        </circle>
        <circle r="3.5" fill="#8b5cf6">
          <animateMotion dur="2.6s" begin="-1.3s" repeatCount="indefinite"><mpath href="#ev-pAgentProj" /></animateMotion>
        </circle>
        <circle r="3.5" fill="#06b6d4">
          <animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#ev-pProjPolicy" /></animateMotion>
        </circle>
        <circle r="3.5" fill="#06b6d4">
          <animateMotion dur="2.6s" begin="-1.3s" repeatCount="indefinite"><mpath href="#ev-pProjPolicy" /></animateMotion>
        </circle>
        <circle r="3.5" fill="#8b5cf6">
          <animateMotion dur="2.4s" repeatCount="indefinite"><mpath href="#ev-pPolicyHarn" /></animateMotion>
        </circle>
        <circle r="3" fill="#10b981">
          <animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#ev-pResultPass" /></animateMotion>
        </circle>
        <circle r="3" fill="#f59e0b">
          <animateMotion dur="3.2s" repeatCount="indefinite"><mpath href="#ev-pResultFail" /></animateMotion>
        </circle>
        <circle r="3" fill="#06b6d4">
          <animateMotion dur="2.8s" repeatCount="indefinite"><mpath href="#ev-pDatasetExp" /></animateMotion>
        </circle>
      </g>

      <!-- Honest-scope callout -->
      <g font-family="Inter, sans-serif" font-size="10">
        <rect x="120" y="710" width="1000" height="36" rx="10" class="cv-callout" />
        <text x="620" y="733" text-anchor="middle" class="cv-callout-text" font-weight="600" letter-spacing="0.5">
          prompt + completion content stay on span events · CloudGrid never holds model-provider credentials · all writes via storage-write
        </text>
      </g>
    </svg>
  </div>

  {showLegend && (
    <div class="canvas-surface px-6 py-4 border-t border-border-default flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
      <span class="inline-flex items-center gap-2 text-[color:var(--cv-text-muted)]">
        <span class="inline-block w-3 h-[2px] rounded-full bg-[color:var(--color-violet)]"></span> AI projections
      </span>
      <span class="inline-flex items-center gap-2 text-[color:var(--cv-text-muted)]">
        <span class="inline-block w-3 h-[2px] rounded-full bg-[color:var(--color-cyan)]"></span> dataset / policy
      </span>
      <span class="inline-flex items-center gap-2 text-[color:var(--cv-text-muted)]">
        <span class="inline-block w-3 h-[2px] rounded-full bg-[color:var(--color-emerald)]"></span> good
      </span>
      <span class="inline-flex items-center gap-2 text-[color:var(--cv-text-muted)]">
        <span class="inline-block w-3 h-[2px] rounded-full bg-[color:var(--color-amber)]"></span> low / fail
      </span>
      <span class="inline-flex items-center gap-2 text-[color:var(--cv-text-muted)] ml-auto">
        <span class="inline-block w-3 border-b border-dashed border-[color:var(--cv-text-muted)]"></span> harness HTTP
      </span>
    </div>
  )}
</div>
