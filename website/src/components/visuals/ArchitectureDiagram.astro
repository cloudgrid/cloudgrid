---
/**
 * Flat architecture diagram. SVG, stroke-based, accent only where it carries meaning
 * (the message bridge). All other nodes use theme-aware neutrals.
 */
---

<svg viewBox="0 0 880 460" xmlns="http://www.w3.org/2000/svg" class="block w-full h-auto" role="img" aria-label="CloudGrid service architecture">
  <!-- Boxes helper styles via raw attributes -->
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--color-text-muted)" />
    </marker>
    <marker id="arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--color-brand)" />
    </marker>
  </defs>

  <!-- Lanes -->
  <g font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--color-text-muted)">
    <text x="20" y="50">SENDERS</text>
    <text x="20" y="130">INGEST</text>
    <text x="20" y="220">BRIDGE</text>
    <text x="20" y="320">PRIVATE</text>
    <text x="20" y="410">PUBLIC</text>
  </g>

  <!-- Senders -->
  <g>
    <rect x="120" y="30" width="140" height="40" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="190" y="55" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="var(--color-text)">OTel SDK · services</text>
    <rect x="280" y="30" width="140" height="40" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="350" y="55" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="var(--color-text)">AI agents · harness</text>
    <rect x="440" y="30" width="140" height="40" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="510" y="55" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="var(--color-text)">Cron / batch</text>
  </g>

  <!-- arrows from senders to collector -->
  <g stroke="var(--color-text-muted)" stroke-width="1" fill="none" marker-end="url(#arrow)">
    <line x1="190" y1="72" x2="380" y2="118" />
    <line x1="350" y1="72" x2="400" y2="118" />
    <line x1="510" y1="72" x2="420" y2="118" />
  </g>

  <!-- Ingest -->
  <g>
    <rect x="340" y="120" width="200" height="44" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="440" y="140" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="var(--color-text)" font-weight="600">otlp-collector</text>
    <text x="440" y="156" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--color-text-muted)">Go · /v1/traces /v1/logs /v1/metrics</text>
  </g>

  <!-- Arrow ingest → bridge -->
  <g stroke="var(--color-text-muted)" stroke-width="1" fill="none" marker-end="url(#arrow)">
    <line x1="440" y1="166" x2="440" y2="208" />
  </g>

  <!-- Bridge (accent) -->
  <g>
    <rect x="200" y="210" width="480" height="44" rx="8" fill="var(--color-brand)" fill-opacity="0.08" stroke="var(--color-brand)" stroke-width="1.5" />
    <text x="440" y="232" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" fill="var(--color-text)" font-weight="600">message bridge · NATS JetStream (v1 adapter)</text>
    <text x="440" y="248" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--color-text-muted)">telemetry.ingest.* · telemetry.persisted.* · request/reply queries · live subjects</text>
  </g>

  <!-- Arrows bridge → private services -->
  <g stroke="var(--color-text-muted)" stroke-width="1" fill="none" marker-end="url(#arrow)">
    <line x1="280" y1="256" x2="180" y2="298" />
    <line x1="380" y1="256" x2="350" y2="298" />
    <line x1="520" y1="256" x2="520" y2="298" />
    <line x1="600" y1="256" x2="700" y2="298" />
  </g>

  <!-- Private services -->
  <g>
    <rect x="100" y="300" width="160" height="44" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="180" y="320" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="var(--color-text)" font-weight="600">storage-write</text>
    <text x="180" y="336" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--color-text-muted)">Go · JetStream consumer</text>

    <rect x="270" y="300" width="160" height="44" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="350" y="320" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="var(--color-text)" font-weight="600">storage-read</text>
    <text x="350" y="336" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--color-text-muted)">Go · request/reply + live</text>

    <rect x="440" y="300" width="160" height="44" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="520" y="320" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="var(--color-text)" font-weight="600">control-plane</text>
    <text x="520" y="336" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--color-text-muted)">Go · projects · auth · keys</text>

    <rect x="620" y="300" width="160" height="44" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="700" y="320" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="var(--color-text)" font-weight="600">ai-eval-runner</text>
    <text x="700" y="336" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9.5" fill="var(--color-text-muted)">Go · harness orchestrator</text>
  </g>

  <!-- SurrealDB underneath -->
  <g>
    <rect x="220" y="360" width="260" height="34" rx="8" fill="var(--color-recessed)" stroke="var(--color-border-default)" stroke-dasharray="4 3" />
    <text x="350" y="382" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="var(--color-text-secondary)">SurrealDB (v1 storage adapter)</text>
  </g>

  <!-- storage write/read ↔ DB -->
  <g stroke="var(--color-text-muted)" stroke-width="1" fill="none" marker-end="url(#arrow)">
    <line x1="180" y1="344" x2="280" y2="362" />
    <line x1="350" y1="344" x2="350" y2="358" />
  </g>

  <!-- Public layer (BFF + UI) -->
  <g>
    <rect x="260" y="410" width="180" height="34" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="350" y="432" text-anchor="middle" font-family="Inter, sans-serif" font-size="11.5" fill="var(--color-text)" font-weight="600">TypeScript BFF · GraphQL</text>

    <rect x="460" y="410" width="180" height="34" rx="8" fill="var(--color-surface)" stroke="var(--color-border-default)" />
    <text x="550" y="432" text-anchor="middle" font-family="Inter, sans-serif" font-size="11.5" fill="var(--color-text)" font-weight="600">React · Vite UI</text>
  </g>

  <!-- arrow BFF → bridge -->
  <g stroke="var(--color-brand)" stroke-width="1.2" fill="none" marker-end="url(#arrow-accent)">
    <line x1="350" y1="410" x2="350" y2="262" />
  </g>

  <!-- UI → BFF -->
  <g stroke="var(--color-text-muted)" stroke-width="1" fill="none" marker-end="url(#arrow)">
    <line x1="460" y1="427" x2="440" y2="427" />
  </g>
</svg>
