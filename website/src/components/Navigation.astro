---
import Logo from "./Logo.astro";
import { handbookTopNav } from "../lib/handbook-navigation";

const pathname = Astro.url.pathname;

const features = [
  { label: "Traces", href: "/features/traces", desc: "Distributed tracing" },
  { label: "Logs", href: "/features/logs", desc: "Search-first logs" },
  { label: "Metrics", href: "/features/metrics", desc: "Exploration & descriptors" },
  { label: "Dashboards", href: "/features/dashboards", desc: "Saved typed widgets" },
  { label: "Alerts", href: "/features/alerts", desc: "Rules, history, delivery" },
  { label: "AI Evaluation", href: "/features/ai-evaluation", desc: "Agents, scorers, experiments" },
  { label: "Customizable", href: "/features/adapters", desc: "Branding, adapters, runtime ports" },
];

const enterprise = [
  { label: "Overview", href: "/enterprise", desc: "Ownership, controls, procurement answers" },
  { label: "White-label Solution", href: "/enterprise/whitelabel-solution", desc: "Commercial SaaS and partner path" },
  { label: "Compare", href: "/enterprise/compare", desc: "Risk and licensing vs alternatives" },
];

const topLevel = [
  { label: "Home", href: "/" },
  { label: "Features", href: "/features", children: features },
  { label: "Enterprise", href: "/enterprise", children: enterprise },
  {
    label: "Handbook",
    href: "/handbook",
    children: handbookTopNav.map((item) => ({
      label: item.label,
      href: item.href,
      desc: item.description ?? "",
    })),
  },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<nav
  id="main-nav"
  class="sticky top-0 z-50 border-b border-border-subtle bg-white"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2.5 group">
        <Logo class="w-7 h-7" />
        <span class="text-base font-semibold tracking-tight text-text">CloudGrid</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-0.5">
        {
          topLevel.map((item) => {
            const active = isActive(item.href);
            const baseCls =
              "px-3 py-2 rounded-md text-sm font-medium transition-colors " +
              (active
                ? "text-text bg-surface-hover"
                : "text-text-secondary hover:text-text hover:bg-surface-hover");

            if (item.children) {
              return (
                <div class="relative group/dd">
                  <a href={item.href} class={baseCls + " inline-flex items-center gap-1"}>
                    {item.label}
                    <svg class="w-3 h-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </a>
                  <div class="invisible opacity-0 group-hover/dd:visible group-hover/dd:opacity-100 transition-all duration-150 absolute top-full left-0 pt-2 w-72">
                    <div class="rounded-xl border border-border-default bg-elevated shadow-xl shadow-black/5 p-2">
                      {item.children.map((c) => (
                        <a
                          href={c.href}
                          class="block px-3 py-2 rounded-lg hover:bg-surface-hover transition-colors"
                        >
                          <div class="text-sm font-medium text-text">{c.label}</div>
                          <div class="text-xs text-text-muted mt-0.5">{c.desc}</div>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a href={item.href} class={baseCls}>
                {item.label}
              </a>
            );
          })
        }
      </div>

      <!-- Right cluster: theme toggle + GitHub -->
      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-md border border-border-default text-text-secondary hover:text-text hover:bg-surface-hover transition-colors"
        >
          <!-- Sun (visible in dark mode) -->
          <svg
            id="theme-sun"
            class="w-4 h-4 hidden dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
          <!-- Moon (visible in light mode) -->
          <svg
            id="theme-moon"
            class="w-4 h-4 block dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a
          href="https://github.com/cloudgrid/cloudgrid"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium text-text-secondary hover:text-text hover:bg-surface-hover transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          GitHub
        </a>

        <a
          href="/handbook/getting-started"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md bg-inverse text-text-on-inverse text-sm font-semibold hover:opacity-90 transition-opacity"
        >
          Get started
        </a>

        <!-- Mobile menu -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle menu"
          class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-md border border-border-default text-text-secondary hover:text-text hover:bg-surface-hover transition-colors"
        >
          <svg id="menu-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border-subtle bg-white">
    <div class="px-4 py-4 space-y-1">
      {
        topLevel.map((item) => (
          <div class="border-b border-border-subtle py-2 last:border-b-0">
            <a
              href={item.href}
              class="block px-2 py-2 rounded-md text-sm font-semibold text-text hover:bg-surface-hover"
            >
              {item.label}
            </a>
            {item.children && (
              <div class="mt-1 space-y-0.5 pl-2">
                {item.children.map((c) => (
                  <a
                    href={c.href}
                    class="block px-2 py-1.5 rounded-md text-sm text-text-secondary hover:text-text hover:bg-surface-hover"
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
      <div class="flex items-center gap-2 pt-3">
        <button
          id="theme-toggle-mobile"
          type="button"
          aria-label="Toggle theme"
          class="inline-flex items-center justify-center w-9 h-9 rounded-md border border-border-default text-text-secondary"
        >
          <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <a
          href="https://github.com/cloudgrid/cloudgrid"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md border border-border-default text-sm font-medium text-text"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    function setTheme(theme) {
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
      try {
        localStorage.setItem("cg-theme", theme);
      } catch (_e) {}
    }
    function toggleTheme() {
      var isDark = document.documentElement.classList.contains("dark");
      setTheme(isDark ? "light" : "dark");
    }

    var t1 = document.getElementById("theme-toggle");
    var t2 = document.getElementById("theme-toggle-mobile");
    if (t1) t1.addEventListener("click", toggleTheme);
    if (t2) t2.addEventListener("click", toggleTheme);

    var btn = document.getElementById("mobile-menu-btn");
    var menu = document.getElementById("mobile-menu");
    var menuIcon = document.getElementById("menu-icon");
    var closeIcon = document.getElementById("close-icon");
    if (btn && menu) {
      btn.addEventListener("click", function () {
        var open = !menu.classList.contains("hidden");
        if (open) {
          menu.classList.add("hidden");
          menuIcon && menuIcon.classList.remove("hidden");
          closeIcon && closeIcon.classList.add("hidden");
        } else {
          menu.classList.remove("hidden");
          menuIcon && menuIcon.classList.add("hidden");
          closeIcon && closeIcon.classList.remove("hidden");
        }
      });
    }
  })();
</script>
