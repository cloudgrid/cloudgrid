---
interface Props {
  href: string;
  title: string;
  description: string;
  icon?: "trace" | "log" | "metric" | "dashboard" | "ai" | "adapter";
  accent?: "brand" | "cyan" | "emerald" | "amber" | "violet" | "rose";
}

const { href, title, description, icon = "trace", accent = "brand" } = Astro.props;

const accentColor: Record<string, string> = {
  brand: "var(--color-brand)",
  cyan: "var(--color-cyan)",
  emerald: "var(--color-emerald)",
  amber: "var(--color-amber)",
  violet: "var(--color-violet)",
  rose: "var(--color-rose)",
};

const iconPaths: Record<string, string> = {
  trace: "M3 12h3l2-7 4 14 2-7h7",
  log: "M4 5h16M4 10h16M4 15h10M4 20h13",
  metric: "M3 19V5M3 19h18M7 15l4-5 3 3 5-7",
  dashboard: "M3 3h7v9H3zM14 3h7v5h-7zM14 12h7v9h-7zM3 16h7v5H3z",
  ai: "M9 2h6v3h-6zM6 8h12v9H6zM10 17v3M14 17v3M3 11h3M18 11h3",
  adapter: "M9 4v6h6V4M9 20v-6h6v6M3 12h6M15 12h6",
};

const c = accentColor[accent];
---

<a
  href={href}
  class="card is-interactive spotlight group flex h-full flex-col p-6 sm:p-7"
  style={`--accent: ${c};`}
>
  <div class="flex items-start justify-between mb-5">
    <div
      class="icon-pop w-11 h-11 rounded-xl inline-flex items-center justify-center"
      style={`background: color-mix(in srgb, ${c} 14%, transparent); color: ${c};`}
    >
      <svg
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={iconPaths[icon]}></path>
      </svg>
    </div>
    <svg
      class="w-3.5 h-3.5 text-text-muted opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 12h14M12 5l7 7-7 7"></path>
    </svg>
  </div>
  <h3 class="text-base sm:text-lg font-semibold text-text leading-snug">{title}</h3>
  <p class="mt-2 text-sm text-text-secondary leading-relaxed flex-1">{description}</p>
  <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-text-secondary group-hover:text-text">
    <span class="border-b border-dotted border-text-muted group-hover:border-text">Read more</span>
  </div>
</a>
