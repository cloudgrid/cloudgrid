---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  accent?: "brand" | "cyan" | "emerald" | "amber" | "violet" | "rose";
  /** Optional gradient highlight word, rendered through .text-accent-gradient */
  highlight?: string;
}
const { eyebrow, title, description, accent = "brand", highlight } = Astro.props;

const accentMap: Record<string, string> = {
  brand: "bg-brand-soft text-[var(--color-brand)]",
  cyan: "bg-cyan-soft text-[var(--color-cyan)]",
  emerald: "bg-emerald-soft text-[var(--color-emerald)]",
  amber: "bg-amber-soft text-[var(--color-amber)]",
  violet: "bg-violet-soft text-[var(--color-violet)]",
  rose: "bg-rose-soft text-[var(--color-rose)]",
};

let beforeHighlight = title;
let highlightWord = "";
let afterHighlight = "";
if (highlight && title.includes(highlight)) {
  const i = title.indexOf(highlight);
  beforeHighlight = title.slice(0, i);
  highlightWord = highlight;
  afterHighlight = title.slice(i + highlight.length);
}
---

<header class="max-w-3xl">
  {
    eyebrow && (
      <div class={`reveal chip ${accentMap[accent]}`}>
        {eyebrow}
      </div>
    )
  }
  <h1 class="reveal mt-5 text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-text leading-[1.06] text-balance" data-delay="1">
    {highlight ? (
      <>
        {beforeHighlight}<span class="text-accent-gradient">{highlightWord}</span>{afterHighlight}
      </>
    ) : title}
  </h1>
  {description && (
    <p class="reveal mt-5 text-lg text-text-secondary leading-relaxed max-w-2xl text-balance" data-delay="2">{description}</p>
  )}
</header>
