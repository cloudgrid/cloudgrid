---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  class?: string;
  /** Adds a subtle hover shimmer (primary only by default). */
  shine?: boolean;
}
const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className = "",
  shine,
} = Astro.props;

const useShine = shine ?? variant === "primary";

const base =
  "inline-flex items-center justify-center gap-2 font-semibold rounded-lg transition-all duration-200";
const sizeCls =
  size === "sm"
    ? "text-sm px-3.5 py-2"
    : size === "lg"
      ? "text-base px-5 py-3"
      : "text-sm px-4 py-2.5";
const variantCls =
  variant === "primary"
    ? "bg-inverse text-text-on-inverse hover:opacity-90 hover:-translate-y-0.5 shadow-[0_8px_24px_-12px_rgba(99,102,241,0.4)]"
    : variant === "secondary"
      ? "border border-border-default bg-surface text-text hover:bg-surface-hover hover:border-border-strong"
      : "text-text-secondary hover:text-text hover:bg-surface-hover";
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={`${base} ${sizeCls} ${variantCls} ${useShine ? "btn-shine" : ""} ${className}`}
>
  <slot />
</a>
