---
interface Props {
  id?: string;
  tone?: "default" | "recessed" | "grid" | "canvas" | "dark";
  size?: "sm" | "md" | "lg";
  class?: string;
}
const { id, tone = "default", size = "md", class: className = "" } = Astro.props;

const padding =
  size === "sm" ? "py-14 sm:py-20" : size === "lg" ? "py-24 sm:py-32" : "py-20 sm:py-24";

const bg =
  tone === "recessed"
    ? "section-recessed"
    : tone === "grid"
      ? "section-default relative overflow-hidden"
      : tone === "canvas"
        ? "canvas-surface relative overflow-hidden"
        : tone === "dark"
          ? "section-dark"
          : "section-default";
---

<section id={id} class={`relative ${bg} ${padding} ${className}`}>
  {tone === "grid" && <div class="absolute inset-0 grid-bg pointer-events-none"></div>}
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <slot />
  </div>
</section>
