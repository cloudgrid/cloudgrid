---
interface Item {
  label: string;
  href: string;
  desc: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

const imageByHref: Record<string, string> = {
  "/features/traces": "/hero-backgrounds/features-traces.png",
  "/features/logs": "/hero-backgrounds/features-logs.png",
  "/features/metrics": "/hero-backgrounds/features-metrics.png",
  "/features/dashboards": "/hero-backgrounds/features-dashboards.png",
  "/features/alerts": "/hero-backgrounds/features-alerts.png",
  "/features/ai-evaluation": "/hero-backgrounds/features-ai-evaluation.png",
  "/features/adapters": "/hero-backgrounds/features-adapters.png",
  "/enterprise": "/hero-backgrounds/enterprise.png",
  "/enterprise/whitelabel-solution": "/hero-backgrounds/enterprise-whitelabel.png",
  "/enterprise/compare": "/hero-backgrounds/enterprise-compare.png",
};
---

<div class="related-stack">
  {items.map((it, i) => (
    <a
      href={it.href}
      class="related-stack__item group reveal"
      data-delay={(i + 1) as any}
    >
      <div class="related-stack__media" aria-hidden="true">
        <img src={imageByHref[it.href] ?? "/hero-backgrounds/default.png"} alt="" loading="lazy" decoding="async" />
      </div>
      <div class="related-stack__copy">
        <div class="related-stack__kicker">Related</div>
        <div class="related-stack__title">{it.label}</div>
        <p>{it.desc}</p>
      </div>
      <svg class="related-stack__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  ))}
</div>
