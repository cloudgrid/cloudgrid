---
import { handbookNav, type HandbookNavItem } from "../../lib/handbook-navigation";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

function isActive(href: string): boolean {
  const normalized = currentSlug.replace(/\/$/, "") || "/handbook";
  if (href === "/handbook") return normalized === href;
  return normalized === href || normalized.startsWith(`${href}/`);
}

function hasActiveChild(item: HandbookNavItem): boolean {
  return isActive(item.href) || Boolean(item.children?.some(hasActiveChild));
}
---

<nav aria-label="Handbook navigation" class="cg-handbook-nav">
  {
    handbookNav.map((section) => (
      <details class="cg-nav-group" open={hasActiveChild(section)}>
        <summary class="cg-nav-section-title">
          <span>{section.label}</span>
          <svg aria-hidden="true" class="cg-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div class="cg-nav-group-body">
          <a href={section.href} class={`cg-nav-link ${currentSlug === section.href ? "is-active" : ""}`}>
            {section.label} overview
          </a>
          {section.children?.map((item) => (
            <div class="cg-nav-node">
              <a href={item.href} class={`cg-nav-link ${currentSlug === item.href ? "is-active" : ""}`}>
                {item.label}
              </a>
              {item.children && (
                <div class="cg-nav-nested">
                  {item.children.map((child) => (
                    <a href={child.href} class={`cg-nav-link cg-nav-link-sub ${currentSlug === child.href ? "is-active" : ""}`}>
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </details>
    ))
  }
</nav>
