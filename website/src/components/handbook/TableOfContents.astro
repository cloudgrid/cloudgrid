---
/**
 * Right-rail TOC. Builds from the headings Astro extracts at render time;
 * the JS at the bottom turns the link list into a scroll-spy.
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;

// Only H2 and H3 — H1 is the page title, H4+ are too noisy for a rail TOC.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <div class="text-sm">
    <div class="cg-nav-section-title px-0 pb-3">On this page</div>
    <nav id="cg-toc" aria-label="Table of contents" class="space-y-px">
      {items.map((h) => (
        <a
          href={`#${h.slug}`}
          data-toc-slug={h.slug}
          class={`cg-toc-link depth-${h.depth}`}
        >
          {h.text}
        </a>
      ))}
    </nav>
  </div>
)}

<script is:inline>
  (function () {
    var toc = document.getElementById("cg-toc");
    if (!toc) return;
    var links = Array.prototype.slice.call(toc.querySelectorAll("[data-toc-slug]"));
    if (!links.length) return;
    var bySlug = {};
    var headings = [];
    links.forEach(function (link) {
      var slug = link.getAttribute("data-toc-slug");
      var el = document.getElementById(slug);
      if (!el) return;
      bySlug[slug] = link;
      headings.push(el);
    });
    if (!headings.length) return;

    function setActive(slug) {
      links.forEach(function (l) { l.classList.remove("is-active"); });
      if (slug && bySlug[slug]) bySlug[slug].classList.add("is-active");
    }

    var io = new IntersectionObserver(
      function (entries) {
        // Pick the heading nearest the top that is intersecting.
        var visible = entries
          .filter(function (e) { return e.isIntersecting; })
          .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
        if (visible.length) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "-80px 0px -65% 0px", threshold: [0, 1] }
    );
    headings.forEach(function (h) { io.observe(h); });
    // Default-active: first heading.
    setActive(headings[0].id);
  })();
</script>
