---
/**
 * Three-column shell for handbook pages:
 *
 *   [ left nav ]   [ prose content ]   [ on-this-page ]
 *
 * The center column receives the rendered `<Content />` via slot.
 * Sidebars are sticky; on smaller screens they collapse / hide.
 */
import Layout from "../../layouts/Layout.astro";
import HandbookEnhancements from "./HandbookEnhancements.astro";
import SidebarNav from "./SidebarNav.astro";
import TableOfContents from "./TableOfContents.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  accent?: "brand" | "cyan" | "emerald" | "amber" | "violet" | "rose";
  updated?: Date;
  headings: Heading[];
  currentSlug: string;
}

const {
  title,
  description,
  eyebrow,
  accent = "brand",
  updated,
  headings,
  currentSlug,
} = Astro.props;

const accentMap: Record<string, string> = {
  brand: "bg-brand-soft text-[var(--color-brand)]",
  cyan: "bg-cyan-soft text-[var(--color-cyan)]",
  emerald: "bg-emerald-soft text-[var(--color-emerald)]",
  amber: "bg-amber-soft text-[var(--color-amber)]",
  violet: "bg-violet-soft text-[var(--color-violet)]",
  rose: "bg-rose-soft text-[var(--color-rose)]",
};
---

<Layout title={`${title} — CloudGrid Handbook`} description={description}>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)_240px] gap-8 pt-10 pb-20">
      <!-- LEFT: sidebar nav -->
      <aside class="hidden lg:block">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
          <SidebarNav currentSlug={currentSlug} />
        </div>
      </aside>

      <!-- CENTER: content -->
      <article id="cg-handbook-article" class="min-w-0">
        <header class="mb-10">
          {eyebrow && (
            <div class={`chip ${accentMap[accent]}`}>{eyebrow}</div>
          )}
          <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight text-text leading-[1.08] text-balance">
            {title}
          </h1>
          {description && (
            <p class="mt-4 text-lg text-text-secondary leading-relaxed max-w-2xl text-balance">
              {description}
            </p>
          )}
        </header>

        <!-- Mobile TOC, collapsed -->
        <details class="lg:hidden mb-6 rounded-xl border border-border-default bg-surface px-4 py-3">
          <summary class="text-sm font-medium text-text cursor-pointer">On this page</summary>
          <div class="mt-3">
            <TableOfContents headings={headings} />
          </div>
        </details>

        <div class="cg-prose">
          <slot />
        </div>

        {updated && (
          <p class="mt-12 pt-6 border-t border-border-subtle text-xs text-text-muted">
            Last updated <time datetime={updated.toISOString()}>{updated.toISOString().slice(0, 10)}</time>.
          </p>
        )}
      </article>

      <!-- RIGHT: on-this-page -->
      <aside class="hidden lg:block">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pl-2">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </div>

  <HandbookEnhancements />
</Layout>
