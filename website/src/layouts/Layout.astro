---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  hideFooter?: boolean;
}

const {
  title,
  description = "CloudGrid — own your observability. Source-available, OpenTelemetry-native traces, logs, metrics, dashboards, and AI agent evaluation in one self-hosted system.",
  ogImage = "/og-image.svg",
  hideFooter = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://cloudgrid.dev").toString();
const path = Astro.url.pathname;
const isHandbook = path.startsWith("/handbook");
const background =
  path === "/"
    ? "home"
    : path.startsWith("/features/traces")
      ? "features-traces"
      : path.startsWith("/features/logs")
        ? "features-logs"
        : path.startsWith("/features/metrics")
          ? "features-metrics"
          : path.startsWith("/features/dashboards")
            ? "features-dashboards"
            : path.startsWith("/features/alerts")
              ? "features-alerts"
              : path.startsWith("/features/ai-evaluation")
                ? "features-ai-evaluation"
                : path.startsWith("/features/adapters")
                  ? "features-adapters"
                  : path.startsWith("/features")
                    ? "features"
                    : path.startsWith("/enterprise/compare")
                      ? "enterprise-compare"
                      : path.startsWith("/enterprise/whitelabel-solution")
                        ? "enterprise-whitelabel"
                        : path.startsWith("/enterprise")
                          ? "enterprise"
                          : isHandbook
                            ? "handbook"
                            : "default";
const backgroundStyle = isHandbook
  ? "--hero-bg-image: none;"
  : `--hero-bg-image: url('/hero-backgrounds/${background}.png');`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme bootstrap before paint -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("cg-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = saved || (prefersDark ? "dark" : "light");
          if (theme === "dark") document.documentElement.classList.add("dark");
        } catch (_e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-page text-text antialiased" data-background={isHandbook ? "plain" : "hero"} style={backgroundStyle}>
    <Navigation />
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer />}

    <!--
      Motion engine.
      Runs after first paint. Wires:
        - scroll-direction tracking (adds/removes `is-up` on body)
        - reveal-on-scroll observer (re-triggers on re-entry)
        - SVG path-draw on intersection
        - count-up numbers on intersection
        - spotlight pointer tracking
      Respects prefers-reduced-motion.
    -->
    <script is:inline>
      (function () {
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // 1. Scroll direction
        var lastY = window.scrollY;
        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var y = window.scrollY;
            var dy = y - lastY;
            if (Math.abs(dy) > 4) {
              if (dy < 0) document.body.classList.add("is-up");
              else document.body.classList.remove("is-up");
              lastY = y;
            }
            ticking = false;
          });
        }
        window.addEventListener("scroll", onScroll, { passive: true });

        // 2. Reveal observer — re-triggers on re-entry for forward + reverse scroll feel
        function setupReveal() {
          var els = document.querySelectorAll(".reveal, .reveal-x, .reveal-scale");
          if (!("IntersectionObserver" in window) || reduced) {
            els.forEach(function (el) { el.classList.add("visible"); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
              } else if (entry.boundingClientRect.top > window.innerHeight * 0.9) {
                // Reset only when the element has scrolled well below the viewport — so on
                // scroll-up it animates back in.
                entry.target.classList.remove("visible");
              }
            });
          }, { threshold: 0.08, rootMargin: "0px 0px -40px 0px" });
          els.forEach(function (el) { io.observe(el); });
        }

        // 3. SVG path-draw
        function setupPaths() {
          var paths = document.querySelectorAll(".path-draw");
          paths.forEach(function (p) {
            try {
              var len = p.getTotalLength ? p.getTotalLength() : 1000;
              p.style.setProperty("--path-len", String(len));
              p.style.strokeDasharray = String(len);
              p.style.strokeDashoffset = String(len);
            } catch (_e) {}
          });
          if (reduced) {
            paths.forEach(function (p) { p.classList.add("drawn"); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("drawn");
              } else if (entry.boundingClientRect.top > window.innerHeight * 0.9) {
                entry.target.classList.remove("drawn");
              }
            });
          }, { threshold: 0.2 });
          paths.forEach(function (p) { io.observe(p); });
        }

        // 4. Count-up
        function setupCounters() {
          var els = document.querySelectorAll(".count-up");
          if (reduced) {
            els.forEach(function (el) {
              el.textContent = el.getAttribute("data-target") || el.textContent;
            });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              var target = parseFloat(el.getAttribute("data-target") || "0");
              var prefix = el.getAttribute("data-prefix") || "";
              var suffix = el.getAttribute("data-suffix") || "";
              var dur = parseInt(el.getAttribute("data-duration") || "1100", 10);
              var start = performance.now();
              function tick(now) {
                var t = Math.min(1, (now - start) / dur);
                var eased = 1 - Math.pow(1 - t, 3);
                var v = target * eased;
                var shown = Number.isInteger(target) ? Math.round(v) : v.toFixed(1);
                el.textContent = prefix + shown + suffix;
                if (t < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
              io.unobserve(el);
            });
          }, { threshold: 0.4 });
          els.forEach(function (el) { io.observe(el); });
        }

        // 5. Spotlight pointer tracking
        function setupSpotlight() {
          if (reduced) return;
          document.querySelectorAll(".spotlight").forEach(function (el) {
            el.addEventListener("pointermove", function (e) {
              var rect = el.getBoundingClientRect();
              el.style.setProperty("--mx", ((e.clientX - rect.left) / rect.width) * 100 + "%");
              el.style.setProperty("--my", ((e.clientY - rect.top) / rect.height) * 100 + "%");
            });
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            setupReveal(); setupPaths(); setupCounters(); setupSpotlight();
          });
        } else {
          setupReveal(); setupPaths(); setupCounters(); setupSpotlight();
        }
      })();
    </script>
  </body>
</html>
