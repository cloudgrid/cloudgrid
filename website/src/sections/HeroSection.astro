---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated canvas background -->
  <canvas id="hero-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- Gradient overlays -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-bg-primary/50 to-bg-primary pointer-events-none"></div>
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent-purple/10 rounded-full blur-[128px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-accent-blue/10 rounded-full blur-[128px] pointer-events-none"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
    <div class="reveal">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-border-default mb-8">
        <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></span>
        <span class="text-sm font-medium text-text-secondary">Open Source &middot; Self-Hosted</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.1] mb-6">
        <span class="text-text-primary">Observability for</span>
        <br />
        <span class="gradient-text">AI-native systems</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed">
        CloudGrid ingests OpenTelemetry traces, logs, and metrics through a modern
        message-bridge architecture. Built for engineering teams who need precision
        without the vendor lock-in.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a
          href="/handbook"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white text-bg-primary font-semibold text-base hover:bg-gray-100 transition-colors shadow-lg shadow-white/10"
        >
          Get Started
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="https://github.com/cloudgriddev/cloudgrid"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white/5 border border-border-default text-text-primary font-semibold text-base hover:bg-white/10 transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
      </div>

      <!-- Code preview -->
      <div class="max-w-3xl mx-auto">
        <div class="rounded-xl bg-bg-card border border-border-default overflow-hidden shadow-2xl shadow-black/50">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-border-subtle bg-bg-secondary/50">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="ml-2 text-xs text-text-muted font-mono">docker-compose.yaml</span>
          </div>
          <div class="p-4 sm:p-6 text-left overflow-x-auto">
            <pre class="code-block text-text-secondary"><code><span class="text-accent-purple-light">services</span>:
  <span class="text-accent-blue-light">cloudgrid</span>:
    <span class="text-accent-purple-light">image</span>: <span class="text-accent-green-light">cloudgrid/all-in-one:latest</span>
    <span class="text-accent-purple-light">ports</span>:
      - <span class="text-accent-amber-light">"4318:4318"</span>   <span class="text-text-muted"># OTLP ingest</span>
      - <span class="text-accent-amber-light">"3000:3000"</span>   <span class="text-text-muted"># GraphQL + UI</span>
      - <span class="text-accent-amber-light">"5173:5173"</span>   <span class="text-text-muted"># Frontend</span>
    <span class="text-accent-purple-light">environment</span>:
      <span class="text-accent-blue-light">CLOUDGRID_DEPLOYMENT_MODE</span>: <span class="text-accent-green-light">local</span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-text-muted animate-bounce">
    <span class="text-xs font-medium uppercase tracking-widest">Scroll</span>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let animationId: number;
    let time = 0;

    const resize = () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    };
    resize();
    window.addEventListener('resize', resize);

    const gridSize = 60;
    const dotRadius = 0.8;

    const draw = () => {
      time += 0.005;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const cols = Math.ceil(canvas.width / gridSize) + 1;
      const rows = Math.ceil(canvas.height / gridSize) + 1;

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const x = i * gridSize;
          const y = j * gridSize;

          // Distance from center
          const cx = canvas.width / 2;
          const cy = canvas.height / 2;
          const dist = Math.sqrt((x - cx) ** 2 + (y - cy) ** 2);
          const maxDist = Math.sqrt(cx ** 2 + cy ** 2);
          const normalizedDist = dist / maxDist;

          // Animated wave effect
          const wave = Math.sin(dist * 0.01 - time * 3) * 0.5 + 0.5;
          const alpha = (1 - normalizedDist) * wave * 0.3;

          if (alpha > 0.01) {
            ctx.beginPath();
            ctx.arc(x, y, dotRadius, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(148, 163, 184, ${alpha})`;
            ctx.fill();
          }

          // Draw lines between nearby dots with higher opacity
          if (i < cols - 1) {
            const waveH = Math.sin((dist + gridSize) * 0.01 - time * 3) * 0.5 + 0.5;
            const alphaH = (1 - normalizedDist) * waveH * 0.08;
            if (alphaH > 0.005) {
              ctx.beginPath();
              ctx.moveTo(x, y);
              ctx.lineTo(x + gridSize, y);
              ctx.strokeStyle = `rgba(148, 163, 184, ${alphaH})`;
              ctx.lineWidth = 0.5;
              ctx.stroke();
            }
          }
          if (j < rows - 1) {
            const waveV = Math.sin((dist + gridSize) * 0.01 - time * 3) * 0.5 + 0.5;
            const alphaV = (1 - normalizedDist) * waveV * 0.08;
            if (alphaV > 0.005) {
              ctx.beginPath();
              ctx.moveTo(x, y);
              ctx.lineTo(x, y + gridSize);
              ctx.strokeStyle = `rgba(148, 163, 184, ${alphaV})`;
              ctx.lineWidth = 0.5;
              ctx.stroke();
            }
          }
        }
      }

      animationId = requestAnimationFrame(draw);
    };

    draw();

    // Cleanup on page hide
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(animationId);
      } else {
        draw();
      }
    });
  }
</script>
