---
const layers = [
  {
    title: "Ingest Layer",
    color: "accent-green",
    items: [
      {
        name: "OTLP Collector",
        desc: "Go HTTP service accepting OTLP/JSON & OTLP/protobuf",
        tag: "Go",
      },
    ],
  },
  {
    title: "Message Bridge",
    color: "accent-amber",
    items: [
      { name: "NATS JetStream", desc: "Durable stream with at-least-once delivery", tag: "NATS" },
    ],
  },
  {
    title: "Storage Layer",
    color: "accent-blue",
    items: [
      { name: "storage-write", desc: "JetStream consumer persisting to SurrealDB", tag: "Go" },
      {
        name: "storage-read",
        desc: "Query engine with filter pushdown & live subscriptions",
        tag: "Go",
      },
      { name: "control-plane", desc: "Companies, users, projects, dashboards", tag: "Go" },
      { name: "SurrealDB", desc: "Multi-tenant graph database", tag: "DB" },
    ],
  },
  {
    title: "API Layer",
    color: "accent-purple",
    items: [{ name: "TypeScript BFF", desc: "GraphQL, auth, health, static serving", tag: "TS" }],
  },
  {
    title: "Client Layer",
    color: "accent-cyan",
    items: [
      {
        name: "React + Vite UI",
        desc: "shadcn/ui, Tailwind, project-scoped workspaces",
        tag: "React",
      },
    ],
  },
];

const tagColors: Record<string, string> = {
  Go: "bg-accent-green/10 text-accent-green-light border-accent-green/20",
  NATS: "bg-accent-amber/10 text-accent-amber-light border-accent-amber/20",
  DB: "bg-accent-blue/10 text-accent-blue-light border-accent-blue/20",
  TS: "bg-accent-purple/10 text-accent-purple-light border-accent-purple/20",
  React: "bg-accent-cyan/10 text-accent-cyan-light border-accent-cyan/20",
};
---

<section id="architecture" class="relative py-24 sm:py-32 overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-50"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-accent-purple/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6">
        Architecture built for <span class="gradient-text">scale and security</span>
      </h2>
      <p class="text-lg text-text-secondary leading-relaxed">
        Every telemetry read and write crosses the NATS message bridge.
        No public service accesses SurrealDB directly. Clean boundaries, clear ownership.
      </p>
    </div>

    <!-- Architecture diagram -->
    <div class="reveal max-w-4xl mx-auto">
      <div class="relative rounded-2xl bg-bg-card border border-border-default p-6 sm:p-8 lg:p-10 shadow-2xl shadow-black/30">
        <!-- Data flow arrows -->
        <div class="hidden lg:flex absolute left-1/2 -translate-x-1/2 top-[72px] flex-col items-center gap-1 z-10">
          <svg class="w-5 h-5 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </div>
        <div class="hidden lg:flex absolute left-1/2 -translate-x-1/2 top-[172px] flex-col items-center gap-1 z-10">
          <svg class="w-5 h-5 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </div>
        <div class="hidden lg:flex absolute left-1/2 -translate-x-1/2 top-[380px] flex-col items-center gap-1 z-10">
          <svg class="w-5 h-5 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </div>
        <div class="hidden lg:flex absolute left-1/2 -translate-x-1/2 top-[520px] flex-col items-center gap-1 z-10">
          <svg class="w-5 h-5 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </div>

        <!-- Bidirectional arrow for storage-read -->
        <div class="hidden lg:flex absolute left-[60%] top-[300px] items-center gap-1 z-10">
          <svg class="w-4 h-4 text-accent-blue-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="text-xs text-accent-blue-light font-mono">read</span>
        </div>
        <div class="hidden lg:flex absolute right-[60%] top-[300px] items-center gap-1 z-10">
          <span class="text-xs text-accent-green-light font-mono">write</span>
          <svg class="w-4 h-4 text-accent-green-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </div>

        {layers.map((layer, layerIdx) => (
          <div class={`mb-6 last:mb-0 ${layerIdx === 2 ? 'lg:mb-8' : ''}`}>
            <div class="flex items-center gap-3 mb-3">
              <div class={`w-2 h-2 rounded-full bg-${layer.color}`}></div>
              <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">{layer.title}</span>
            </div>
            <div class={`grid gap-3 ${layer.items.length > 1 ? 'md:grid-cols-2 lg:grid-cols-4' : ''}`}>
              {layer.items.map((item) => (
                <div class={`rounded-xl border border-border-default bg-bg-secondary/50 p-4 hover:border-${layer.color}/30 transition-colors group`}>
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-semibold text-text-primary text-sm">{item.name}</span>
                    <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${tagColors[item.tag]}`}>{item.tag}</span>
                  </div>
                  <p class="text-xs text-text-muted leading-relaxed">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        ))}

        <!-- Ingest flow annotation -->
        <div class="mt-6 pt-6 border-t border-border-subtle">
          <div class="flex flex-wrap items-center gap-4 text-xs text-text-muted font-mono">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent-green"></span>
              Ingest
            </span>
            <span>OTLP Sender</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>Collector</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>NATS</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>storage-write</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>SurrealDB</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Architecture principles -->
    <div class="grid sm:grid-cols-3 gap-6 mt-12 max-w-4xl mx-auto">
      {[
        { title: 'Message Bridge', desc: 'All reads and writes flow through NATS. No service bypasses the bridge.' },
        { title: 'Database Isolation', desc: 'SurrealDB is only reachable from storage and control-plane services.' },
        { title: 'Horizontal Scale', desc: 'Scale BFF, collector, and storage-read independently.' },
      ].map((item, i) => (
        <div class="reveal text-center p-6" style={`transition-delay: ${i * 100}ms`}>
          <h3 class="text-sm font-semibold text-text-primary mb-2">{item.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
