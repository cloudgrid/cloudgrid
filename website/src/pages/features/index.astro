---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import FeatureShowcase from "../../components/FeatureShowcase.astro";

const features = [
  {
    icon: "trace" as const,
    title: "Distributed tracing",
    description:
      "Waterfall timelines, span attributes, span events, status filtering, and live trace receiving over GraphQL subscriptions.",
    href: "/features/traces",
    accent: "brand" as const,
  },
  {
    icon: "log" as const,
    title: "Log analytics",
    description:
      "Search-first log exploration with severity, attribute filters, and one-click pivots into the originating trace.",
    href: "/features/logs",
    accent: "cyan" as const,
  },
  {
    icon: "metric" as const,
    title: "Metrics exploration",
    description:
      "Counters, gauges, histograms, summaries — grouped by descriptor attributes with exemplar pivots back into traces.",
    href: "/features/metrics",
    accent: "emerald" as const,
  },
  {
    icon: "dashboard" as const,
    title: "Dashboards",
    description:
      "Compose saved dashboards from typed widgets — metric, log, trace, live feed — pinned to your project sidebar.",
    href: "/features/dashboards",
    accent: "amber" as const,
  },
  {
    icon: "alert" as const,
    title: "Alerts",
    description:
      "Core-owned rule evaluation, alert state, in-app history, email delivery, and bridge-backed delivery adapters.",
    href: "/features/alerts",
    accent: "amber" as const,
  },
  {
    icon: "ai" as const,
    title: "AI agent evaluation",
    description:
      "Datasets, evaluations, comparisons, optimization, and promotion evidence from the telemetry you already collect.",
    href: "/features/ai-evaluation",
    accent: "violet" as const,
  },
  {
    icon: "adapter" as const,
    title: "Customizable foundation",
    description:
      "Branding, colors, packaging, auth, message bridge, storage, and evaluation execution can adapt behind explicit boundaries.",
    href: "/features/adapters",
    accent: "rose" as const,
  },
];

const truths = [
  {
    title: "Collected evidence stays usable across workflows.",
    body: "The same project data supports incident investigation, alerting, dashboards, dataset curation, evaluation results, and optimization decisions.",
  },
  {
    title: "Project is the isolation primitive.",
    body: "Every trace, log, metric, dashboard, dataset, and evaluation belongs to a project, so teams keep customer and environment evidence clearly separated.",
  },
  {
    title: "Advanced integrations stay replaceable.",
    body: "Branding, packaging, storage, transport, auth, and evaluation execution are explicit extension points, while day-to-day users stay focused on workflows and results.",
  },
];
---

<Layout title="Features — CloudGrid">
  <Section size="lg">
    <PageHeader
      eyebrow="Features"
      title="Everything you need to observe modern systems."
      description="CloudGrid covers the full OpenTelemetry signal spectrum and extends it with first-class AI agent evaluation — in one self-hosted product."
    />
  </Section>

  <Section tone="recessed">
    <FeatureShowcase items={features} />
  </Section>

  <Section>
    <div class="max-w-3xl mb-8 reveal">
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
        The three truths that hold across every feature.
      </h2>
      <p class="mt-3 text-text-secondary">Capabilities change. These stay constant.</p>
    </div>
    <div class="truth-stack">
      {truths.map((t, i) => (
        <div class="truth-stack__item reveal" data-delay={(i + 1) as any}>
          <div class="truth-stack__index">{String(i + 1).padStart(2, "0")}</div>
          <div>
            <div class="truth-stack__title">{t.title}</div>
            <p>{t.body}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>
</Layout>
