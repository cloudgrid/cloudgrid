---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import FeatureShowcase from "../../components/FeatureShowcase.astro";

const features = [
  {
    icon: "trace" as const,
    title: "Distributed tracing",
    description:
      "Start with the request path when a customer, workflow, or service behaves unexpectedly.",
    href: "/features/traces",
    accent: "brand" as const,
  },
  {
    icon: "log" as const,
    title: "Log analytics",
    description:
      "Search operational text without losing the trace and span context that explains where it happened.",
    href: "/features/logs",
    accent: "cyan" as const,
  },
  {
    icon: "metric" as const,
    title: "Metrics exploration",
    description:
      "Read health, latency, volume, token, and cost signals as project data with linkable exemplars.",
    href: "/features/metrics",
    accent: "emerald" as const,
  },
  {
    icon: "dashboard" as const,
    title: "Dashboards",
    description:
      "Turn repeated operational questions into saved project views for reviews and daily work.",
    href: "/features/dashboards",
    accent: "amber" as const,
  },
  {
    icon: "alert" as const,
    title: "Alerts",
    description:
      "Let CloudGrid core evaluate rules and manage alert state while delivery can extend through adapters.",
    href: "/features/alerts",
    accent: "amber" as const,
  },
  {
    icon: "ai" as const,
    title: "AI agent evaluation",
    description:
      "Use production evidence to curate datasets, run evaluations, compare candidates, and optimize safely.",
    href: "/features/ai-evaluation",
    accent: "violet" as const,
  },
  {
    icon: "adapter" as const,
    title: "Customizable foundation",
    description:
      "Adapt brand, packaging, auth, bridge, storage, delivery, and execution without changing the product idea.",
    href: "/features/adapters",
    accent: "rose" as const,
  },
];

const truths = [
  {
    title: "The project is the durable operating boundary.",
    body: "Traces, logs, metrics, dashboards, alerts, datasets, evaluation runs, and optimization results belong to the same project, so ownership and access stay clear.",
  },
  {
    title: "The links between signals are product features.",
    body: "A trace can explain a log, a metric exemplar can point to a trace, and an AI evaluation row can keep its source evidence visible during review.",
  },
  {
    title: "The runtime stays modular around pressure points.",
    body: "Ingestion, persistence, reads, live delivery, alert dispatch, and evaluation execution can be sized or extended around the customer workload.",
  },
];
---

<Layout title="Features — CloudGrid">
  <Section size="lg">
    <PageHeader
      eyebrow="Features"
      title="One product surface for the evidence teams need every day."
      description="CloudGrid starts with OpenTelemetry signals, then keeps dashboards, alerts, datasets, evaluations, and optimization results connected to the same project record. The result is easier to operate, easier to review, and easier to extend."
    />
  </Section>

  <Section tone="recessed">
    <FeatureShowcase items={features} />
  </Section>

  <Section>
    <div class="max-w-3xl mb-8 reveal">
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
        The product shape behind the feature set.
      </h2>
      <p class="mt-3 text-text-secondary">
        The feature pages go deeper, but these principles are what make the system useful for
        enterprise operations rather than just another telemetry catalog.
      </p>
    </div>
    <div class="truth-stack">
      {truths.map((t, i) => (
        <div class="truth-stack__item reveal" data-delay={(i + 1) as any}>
          <div class="truth-stack__index">{String(i + 1).padStart(2, "0")}</div>
          <div>
            <div class="truth-stack__title">{t.title}</div>
            <p>{t.body}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>
</Layout>
