---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import CheckList from "../../components/CheckList.astro";
import RelatedFeatures from "../../components/RelatedFeatures.astro";
---

<Layout title="Distributed tracing — CloudGrid">
  <Section size="lg">
    <PageHeader
      eyebrow="Traces"
      accent="brand"
      title="Every span, every attribute, every event — preserved."
      description="CloudGrid receives OTLP traces and renders them as waterfall timelines you can dig into. Span attributes, span events, and W3C trace context are kept end-to-end. Logs, metrics, and AI evaluation evidence can all link back to the trace that explains what happened."
    />
  </Section>

  <Section>
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">What you can do today</h2>
        <CheckList
          items={[
            "OTLP HTTP ingest on /v1/traces with JSON and protobuf encodings.",
            "Project-scoped trace list with service, operation, status, and duration filters.",
            "Full waterfall view with span attributes, span events, and trace-context links.",
            "Live trace receiving over GraphQL subscriptions — filter by service, status, or duration.",
            "Trace-id pivots from any log, metric exemplar, or AI evaluation row.",
            "Use trace evidence as source material for dataset candidates when an AI workflow produces a wrong or surprising output.",
          ]}
        />
      </div>
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">Current scope</h2>
        <CheckList
          muted
          items={[
            "OTLP HTTP on :4318 and OTLP/gRPC on :4317 — both shipped.",
            "OpenTelemetry-native trace preservation — what your OTel SDK sent is what is stored.",
            "Sampling decisions stay in your SDK / collector pipeline.",
            "Long-term cold storage is delivered through alternative storage adapters.",
          ]}
        />
      </div>
    </div>
  </Section>

  <Section tone="recessed">
    <div class="max-w-3xl mb-6 reveal">
      <h2 class="text-xl font-semibold text-text">Architecture, briefly.</h2>
      <p class="mt-2 text-text-secondary">
        Trace persistence is a one-direction flow: collector → bridge → storage-write. Reads are a
        request/reply over the bridge; live trace receiving uses storage-read's ephemeral live
        subjects scoped to the calling BFF session. SurrealDB client access stays inside the
        private storage services.
      </p>
    </div>
    <RelatedFeatures
      items={[
        { label: "Logs", href: "/features/logs", desc: "Every log row already knows its trace id." },
        { label: "Alerts", href: "/features/alerts", desc: "Trace match, count, latency, and error rules." },
        { label: "AI Evaluation", href: "/features/ai-evaluation", desc: "Turn trace-backed failures into dataset rows and evaluation evidence." },
      ]}
    />
  </Section>
</Layout>
