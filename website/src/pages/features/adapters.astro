---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import AdapterDiagram from "../../components/visuals/AdapterDiagram.astro";
import CheckList from "../../components/CheckList.astro";
import RelatedFeatures from "../../components/RelatedFeatures.astro";

const customizationSurfaces = [
  {
    title: "Brand and product identity",
    body: "Replace the visible product identity with your logo, naming, support links, legal links, and product copy for the audience you serve.",
  },
  {
    title: "Color and visual system",
    body: "Adapt the interface theme to your brand tokens while keeping CloudGrid's operational layout, accessibility baseline, and telemetry workflows intact.",
  },
  {
    title: "Deployment and packaging",
    body: "Run CloudGrid in your environment, product cloud, customer VPC, or managed tenant model using the same self-hosted service boundaries.",
  },
  {
    title: "Adapters and runtime ports",
    body: "Swap or extend storage, message bridge, auth, and evaluation execution boundaries while keeping the public BFF focused.",
  },
];

const extensionSurfaces = [
  {
    label: "Brand layer",
    text: "Logo, naming, colors, product copy, help links, and packaging.",
  },
  {
    label: "Access layer",
    text: "OIDC/OAuth providers, BFF-owned sessions, project membership, and tenant-aware access rules.",
  },
  {
    label: "Bridge layer",
    text: "Request/reply, durable ingest, live subjects, and alert delivery dispatch behind the message broker port.",
  },
  {
    label: "Data layer",
    text: "Storage-read and storage-write own telemetry query and persistence semantics.",
  },
  {
    label: "Execution layer",
    text: "Evaluation targets, scorers, and external workflows can integrate through an execution adapter.",
  },
];
---

<Layout title="Customizable CloudGrid — white-label and adapter extensibility">
  <Section size="lg">
    <PageHeader
      eyebrow="Customizable"
      accent="rose"
      highlight="your"
      title="Make CloudGrid feel like your product."
      description="CloudGrid is built for teams that want more than a technical adapter surface. Logos, naming, color tokens, deployment packaging, auth, bridge, storage, and evaluation execution can be adapted so CloudGrid can sit inside your product portfolio or customer environment."
    />
  </Section>

  <Section tone="recessed">
    <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
      <div class="reveal-x">
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          Customization starts with the product your customers see.
        </h2>
        <p class="mt-3 text-text-secondary leading-relaxed">
          Adapters are one part of the story. The larger idea is that CloudGrid can be branded,
          packaged, and extended as a source-available observability foundation. With the Commons
          Clause license, internal self-hosted use stays straightforward, while SaaS, resale, and
          white-label offerings use a commercial agreement.
        </p>
        <div class="mt-6">
          <a
            href="/enterprise/whitelabel-solution"
            class="inline-flex items-center gap-2 text-sm font-semibold text-text hover:text-text-secondary"
          >
            See the white-label solution
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {customizationSurfaces.map((item, i) => (
          <div class="card spotlight p-5 flex h-full flex-col reveal" data-delay={(i + 1) as any}>
            <h3 class="text-base font-semibold text-text">{item.title}</h3>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed flex-1">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section>
    <div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-12 items-start">
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">What can be customized</h2>
        <CheckList
          items={[
            "Visible identity: logo, product name, support destinations, legal links, and product language.",
            "Design tokens: colors, brand accents, and theme variables while preserving telemetry workflows.",
            "Runtime dependencies: storage, bridge, auth providers, alert delivery, and evaluation execution through explicit ports.",
            "Deployment posture: self-hosted, managed customer environment, or commercial white-label SaaS by agreement.",
          ]}
        />
      </div>
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">How the modular model helps</h2>
        <div class="space-y-3">
          {extensionSurfaces.map((item) => (
            <div class="rounded-lg border border-border-default bg-surface px-4 py-3">
              <div class="text-sm font-semibold text-text">{item.label}</div>
              <p class="mt-1 text-sm text-text-secondary leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <Section tone="recessed">
    <div class="max-w-3xl mb-8 reveal">
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        Adapters are real extension points inside the broader customization story.
      </h2>
      <p class="mt-3 text-text-secondary leading-relaxed">
        CloudGrid keeps technical dependencies behind contracts so brand and business
        customization keeps the architecture strong. The BFF stays public-facing;
        private services keep storage and telemetry semantics; the message broker is the bridge
        between them.
      </p>
    </div>
    <div class="reveal">
      <AdapterDiagram />
    </div>
  </Section>

  <Section>
    <div class="rounded-xl border border-border-default bg-surface p-6 sm:p-8 reveal">
      <div class="grid lg:grid-cols-[1fr_auto] gap-4 items-center">
        <div>
          <div class="text-base sm:text-lg font-semibold text-text">
            Building a commercial white-label or SaaS offering?
          </div>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed max-w-3xl">
            The public Commons Clause license is for source-available self-hosted adoption. Hosted
            resale, white-label packaging, and product-portfolio use are handled through a separate
            commercial path.
          </p>
        </div>
        <a
          href="/enterprise/whitelabel-solution"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-inverse text-text-on-inverse text-sm font-semibold hover:opacity-90"
        >
          White-label solution
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </Section>

  <Section>
    <RelatedFeatures
      items={[
        { label: "White-label solution", href: "/enterprise/whitelabel-solution", desc: "Commercial path for SaaS, resale, and embedded product use." },
        { label: "Alerts", href: "/features/alerts", desc: "Core alerting plus bridge-backed delivery adapters." },
        { label: "Adapter authoring", href: "/handbook/adapters", desc: "Technical guide for storage, bridge, auth, and execution adapters." },
      ]}
    />
  </Section>
</Layout>
