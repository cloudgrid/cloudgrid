---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import MockFrame from "../../components/visuals/MockFrame.astro";
import DashboardGrid from "../../components/visuals/DashboardGrid.astro";
import CheckList from "../../components/CheckList.astro";
import RelatedFeatures from "../../components/RelatedFeatures.astro";
---

<Layout title="Dashboards — CloudGrid">
  <Section size="lg">
    <PageHeader
      eyebrow="Dashboards"
      accent="amber"
      title="Saved views. Typed widgets. Pinned where you work."
      description="Dashboards compose from a small, opinionated set of typed widgets — metric time-series, log table, trace table, live trace feed, and project evidence views. Saved per-project, pinned to your project sidebar."
    />
  </Section>

  <Section tone="recessed">
    <div class="reveal">
      <MockFrame title="cloudgrid · /dashboards · agent-platform · overview">
        <DashboardGrid />
      </MockFrame>
    </div>
  </Section>

  <Section>
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">What you can do today</h2>
        <CheckList
          items={[
            "Compose dashboards from typed widgets — metric, log, trace, live feed.",
            "Pin dashboards to the project sidebar for instant access.",
            "Each widget binds to a project-scoped query — isolation enforced server-side.",
            "Live-feed widgets use GraphQL subscriptions with the same auth as queries.",
            "Share evaluation summaries as project evidence without turning dashboards into release gates.",
            "Dashboards are versioned records in the control plane, not opaque JSON blobs.",
          ]}
        />
      </div>
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">Honest about scope</h2>
        <CheckList
          muted
          items={[
            "Free-form ad-hoc exploration lives in /metrics, /traces, /logs — not in dashboards.",
            "Cross-project dashboards are intentionally out of scope today.",
            "Dashboard sharing across companies / external links is a planned capability.",
            "There is no notebook surface or scripted analytics widget. Yet.",
          ]}
        />
      </div>
    </div>
  </Section>

  <Section tone="recessed">
    <RelatedFeatures
      items={[
        { label: "Metrics", href: "/features/metrics", desc: "Where ad-hoc metric work happens." },
        { label: "Traces", href: "/features/traces", desc: "Trace tables and live feed widgets." },
        { label: "AI Evaluation", href: "/features/ai-evaluation", desc: "Evaluation scoreboards explain what changed and why." },
      ]}
    />
  </Section>
</Layout>
