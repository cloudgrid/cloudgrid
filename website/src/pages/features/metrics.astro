---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import CheckList from "../../components/CheckList.astro";
import RelatedFeatures from "../../components/RelatedFeatures.astro";
---

<Layout title="Metrics — CloudGrid">
  <Section size="lg">
    <PageHeader
      eyebrow="Metrics"
      accent="emerald"
      title="Metric exploration that respects descriptors, attributes, and exemplars."
      description="CloudGrid ingests OTLP metrics as a first-class project-scoped signal — counters, gauges, histograms, summaries, exemplars. Pivot from any exemplar straight into the trace that produced it, and keep model latency, token, and cost signals beside evaluation results."
    />
  </Section>

  <Section>
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">What you can do today</h2>
        <CheckList
          items={[
            "OTLP HTTP ingest on /v1/metrics with JSON and protobuf encodings.",
            "Browse metric descriptors with units, types, and attribute key inventories.",
            "Time-series exploration with group-by descriptor attributes and aggregation.",
            "Exemplar pivots back into the originating trace.",
            "AI runtime metrics — token totals, model-call counts, latency, and cost signals — ingested as standard OTLP.",
          ]}
        />
      </div>
      <div class="reveal">
        <h2 class="text-xl font-semibold text-text mb-4">Current scope</h2>
        <CheckList
          muted
          items={[
            "Long-term metric retention runs on the v1 SurrealDB adapter — alternative backends are the natural next adapter.",
            "CloudGrid uses GraphQL view models with explicit aggregations for metric exploration.",
            "Recording-rule and downsampling pipelines are owned by your collector layer for now.",
            "Metric threshold and absence rules are managed in the project alerting workspace.",
          ]}
        />
      </div>
    </div>
  </Section>

  <Section tone="recessed">
    <RelatedFeatures
      items={[
        { label: "Dashboards", href: "/features/dashboards", desc: "Save metric explorations as typed widgets." },
        { label: "Alerts", href: "/features/alerts", desc: "Create threshold and absence rules from metric semantics." },
        { label: "Traces", href: "/features/traces", desc: "Exemplars are linkable trace IDs." },
      ]}
    />
  </Section>
</Layout>
