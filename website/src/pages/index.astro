---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import FeatureCard from "../components/FeatureCard.astro";
import MockFrame from "../components/visuals/MockFrame.astro";
import TraceWaterfall from "../components/visuals/TraceWaterfall.astro";
import SystemCanvas from "../components/visuals/SystemCanvas.astro";
import AdapterDiagram from "../components/visuals/AdapterDiagram.astro";
import AiEvalBoard from "../components/visuals/AiEvalBoard.astro";
import CompareTable from "../components/visuals/CompareTable.astro";
import { vendors, rows } from "../data/compare";

// Slim comparison teaser
const teaserVendors = vendors.filter((v) =>
  ["cloudgrid", "datadog", "lgtm", "langfuse"].includes(v.key),
);
const teaserRowNames = [
  "Open source",
  "Self-hostable",
  "Traces · Logs · Metrics in one product",
  "First-class AI agent evaluation",
  "Adapter-swappable storage",
  "No telemetry-volume / per-host pricing",
];
const slimRows = rows.filter((r) => teaserRowNames.includes(r.criterion));

const signalPillars = [
  {
    icon: "trace" as const,
    title: "Traces",
    description: "Distributed waterfalls, span attributes, events, live receiving.",
    href: "/features/traces",
    accent: "brand" as const,
  },
  {
    icon: "log" as const,
    title: "Logs",
    description: "Search-first analytics with trace-id pivots out of the box.",
    href: "/features/logs",
    accent: "cyan" as const,
  },
  {
    icon: "metric" as const,
    title: "Metrics",
    description: "Descriptors, attributes, exemplar pivots back into traces.",
    href: "/features/metrics",
    accent: "emerald" as const,
  },
  {
    icon: "dashboard" as const,
    title: "Dashboards",
    description: "Saved typed widgets, pinned where you work.",
    href: "/features/dashboards",
    accent: "amber" as const,
  },
  {
    icon: "ai" as const,
    title: "AI Evaluation",
    description: "Agent runs, datasets, scorers, prompt optimization.",
    href: "/features/ai-evaluation",
    accent: "violet" as const,
  },
  {
    icon: "adapter" as const,
    title: "Adapters",
    description: "Storage, message bridge, auth, eval harness — all pluggable.",
    href: "/features/adapters",
    accent: "rose" as const,
  },
];

// Tech marquee — what CloudGrid speaks
const techRow = [
  "OpenTelemetry",
  "OTLP HTTP",
  "OTLP gRPC",
  "NATS JetStream",
  "SurrealDB",
  "GraphQL",
  "OIDC",
  "GitHub",
  "Google",
  "Microsoft Entra ID",
  "GenAI spans",
  "OpenInference",
  "W3C Trace Context",
  "Go",
  "TypeScript",
  "React",
];
---

<Layout title="CloudGrid — own your observability">
  <!-- HERO -->
  <Section size="lg" tone="grid" class="!pt-28 sm:!pt-36 !pb-20">
    <div class="aurora"></div>
    <div class="relative grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-6">
        <div class="reveal chip bg-emerald-soft text-[var(--color-emerald)]">
          <span class="pulse-dot inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--color-emerald)]"></span>
          Open source · Self-hosted · Apache 2.0
        </div>
        <h1 class="reveal mt-5 text-4xl sm:text-5xl lg:text-[3.7rem] font-semibold tracking-tight leading-[1.04] text-text text-balance" data-delay="1">
          Own your <span class="text-accent-gradient">observability</span>.
        </h1>
        <p class="reveal mt-5 text-lg text-text-secondary leading-relaxed max-w-xl" data-delay="2">
          CloudGrid is the OpenTelemetry-native platform you actually own. Traces, logs, metrics,
          dashboards, and first-class AI agent evaluation — in one self-hosted system. No vendor
          lock-in. No telemetry leaving your network.
        </p>
        <div class="reveal mt-8 flex flex-wrap gap-3" data-delay="3">
          <Button href="/handbook/getting-started" size="lg">
            Get started
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </Button>
          <Button href="https://github.com/cloudgrid/cloudgrid" variant="secondary" size="lg" external>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
            </svg>
            Star on GitHub
          </Button>
        </div>

        <dl class="reveal mt-12 grid grid-cols-3 gap-6 max-w-xl" data-delay="4">
          <div>
            <dt class="text-xs text-text-muted uppercase tracking-wider">Signals</dt>
            <dd class="mt-1 text-xl font-semibold text-text font-mono">
              <span class="count-up" data-target="5" data-suffix="">0</span>
            </dd>
            <dd class="text-xs text-text-muted mt-0.5">traces · logs · metrics · dash · ai-eval</dd>
          </div>
          <div>
            <dt class="text-xs text-text-muted uppercase tracking-wider">Services</dt>
            <dd class="mt-1 text-xl font-semibold text-text font-mono">
              <span class="count-up" data-target="5" data-suffix="">0</span>
            </dd>
            <dd class="text-xs text-text-muted mt-0.5">single-purpose · message-bridged</dd>
          </div>
          <div>
            <dt class="text-xs text-text-muted uppercase tracking-wider">Start</dt>
            <dd class="mt-1 text-xl font-semibold text-text font-mono">1 cmd</dd>
            <dd class="text-xs text-text-muted mt-0.5">docker compose up</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-6 reveal-scale">
        <MockFrame title="cloudgrid · /traces · agent.run">
          <div class="p-4 bg-surface">
            <TraceWaterfall />
          </div>
        </MockFrame>
      </div>
    </div>

    <!-- Tech marquee -->
    <div class="relative mt-16 reveal" data-delay="5">
      <div class="text-center text-xs uppercase tracking-wider text-text-muted mb-4">Speaks the open standards your stack already speaks</div>
      <div class="marquee py-3">
        <div class="marquee-track">
          {[...techRow, ...techRow].map((t) => (
            <span class="text-sm font-mono text-text-muted whitespace-nowrap">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- SIGNAL PILLARS -->
  <Section tone="recessed">
    <div class="max-w-3xl mb-10 reveal">
      <div class="chip bg-brand-soft text-[var(--color-brand)]">Five signals, one system</div>
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
        One self-hosted system. Five signals. One contract.
      </h2>
      <p class="mt-3 text-text-secondary">
        Everything you need to observe modern systems — including the agentic ones — without
        gluing five tools together.
      </p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {signalPillars.map((p, i) => (
        <div class="reveal" data-delay={(((i % 3) + 1)) as any}>
          <FeatureCard {...p} />
        </div>
      ))}
    </div>
  </Section>

  <!-- WEDGE -->
  <Section>
    <div class="max-w-3xl reveal">
      <div class="chip bg-amber-soft text-[var(--color-amber)]">The wedge</div>
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
        You shouldn't have to choose.
      </h2>
    </div>
    <div class="mt-10 grid md:grid-cols-3 gap-5">
      {[
        { eyebrow: "SaaS APM", vendors: "Datadog · Honeycomb · New Relic", body: "Polished UI and deep correlations — but your telemetry lives on someone else's disk, with per-host and per-GB pricing that punishes the workloads that need observability most." },
        { eyebrow: "OSS LGTM stacks", vendors: "Grafana · Tempo · Loki · Mimir · SigNoz", body: "You own the data and the components are interchangeable — but you're operating three to five systems with three to five query languages, and signal correlation is glue you wrote." },
        { eyebrow: "AI-eval point tools", vendors: "Langfuse · Arize · Braintrust · Helicone", body: "Built for LLM and agent traces — but they only see the AI slice. Your non-AI services and your evaluations live in different worlds." },
      ].map((c, i) => (
        <div class="card spotlight is-interactive flex h-full flex-col p-6 reveal" data-delay={(i + 1) as any}>
          <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">{c.eyebrow}</div>
          <div class="mt-1 text-sm text-text-secondary font-mono">{c.vendors}</div>
          <p class="mt-4 text-sm text-text leading-relaxed flex-1">{c.body}</p>
        </div>
      ))}
    </div>

    <div class="reveal mt-10 card spotlight p-7 sm:p-9">
      <div class="grid lg:grid-cols-[1fr_auto] gap-4 items-center">
        <div>
          <div class="text-base sm:text-lg font-semibold text-text">
            CloudGrid: one OpenTelemetry-native system that does both.
          </div>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed max-w-3xl">
            Real general-purpose traces · logs · metrics · dashboards <em>and</em> first-class AI
            agent evaluation. Self-hosted, Apache 2.0-licensed, adapter-driven. Compare every cell.
          </p>
        </div>
        <Button href="/enterprise/compare" variant="primary">
          See the head-to-head
        </Button>
      </div>
    </div>
  </Section>

  <!-- ARCHITECTURE / SYSTEM CANVAS -->
  <Section tone="recessed">
    <div class="max-w-3xl mb-8 reveal">
      <div class="chip bg-brand-soft text-[var(--color-brand)]">Architecture</div>
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
        Wired like a workflow. Audited like infrastructure.
      </h2>
      <p class="mt-3 text-text-secondary max-w-2xl">
        A trigger fires. Ingest validates. The bridge routes. Storage commits. The switch enforces
        project authorization. Live updates fan out. Adapters hang off the side — swap one without
        touching the others.
      </p>
    </div>
    <div class="reveal-scale">
      <SystemCanvas />
    </div>
    <div class="mt-6 reveal flex flex-wrap gap-3">
      <Button href="/handbook/architecture" variant="secondary">
        Architecture deep dive
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </Button>
      <Button href="/features/adapters" variant="ghost">
        Adapter-driven extensibility →
      </Button>
    </div>
  </Section>

  <!-- ADAPTER STORY -->
  <Section>
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-4 reveal-x">
        <div class="chip bg-cyan-soft text-[var(--color-cyan)]">Adapter-driven</div>
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
          Every dependency sits behind a port.
        </h2>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Storage backend, message bridge, auth providers, evaluation harness — all behind explicit,
          typed ports. v1 ships SurrealDB, NATS JetStream, GitHub/Google/Entra ID SSO, and the
          <code class="font-mono text-xs px-1 py-0.5 rounded bg-recessed border border-border-subtle">puristajs/harness</code>
          adapter. Implement your own without forking the platform.
        </p>
        <div class="mt-6">
          <Button href="/features/adapters" variant="secondary">
            Adapter overview
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </Button>
        </div>
      </div>
      <div class="lg:col-span-8">
        <AdapterDiagram />
      </div>
    </div>
  </Section>

  <!-- AI EVAL -->
  <Section tone="recessed">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 reveal-x">
        <div class="chip bg-violet-soft text-[var(--color-violet)]">AI-native</div>
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
          Evaluate agents next to the spans they came from.
        </h2>
        <p class="mt-4 text-text-secondary leading-relaxed">
          CloudGrid projects OpenTelemetry GenAI / OpenInference spans into first-class entities —
          AgentRun, LlmCall, ToolCall, RetrievalEvent — and lets you build datasets, define
          deterministic and judge scorers, run experiments, and optimize prompts through a harness
          adapter.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-text-secondary">
          <li class="flex gap-2"><span class="text-[color:var(--color-emerald)]">✓</span> Prompt and completion content stays on span events — nothing copied to a separate AI database.</li>
          <li class="flex gap-2"><span class="text-[color:var(--color-emerald)]">✓</span> Harness owns model-provider calls. CloudGrid never holds provider credentials.</li>
          <li class="flex gap-2"><span class="text-[color:var(--color-emerald)]">✓</span> Same project isolation as the rest of your telemetry.</li>
        </ul>
        <div class="mt-6">
          <Button href="/features/ai-evaluation" variant="secondary">
            AI evaluation features →
          </Button>
        </div>
      </div>
      <div class="lg:col-span-7 reveal-scale">
        <MockFrame title="cloudgrid · /ai-eval/experiments/faq_router_optim_v3">
          <AiEvalBoard />
        </MockFrame>
      </div>
    </div>
  </Section>

  <!-- COMPARE TEASER -->
  <Section>
    <div class="max-w-3xl mb-8 reveal">
      <div class="chip bg-rose-soft text-[var(--color-rose)]">Honest comparison</div>
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text text-balance">
        How CloudGrid stacks up.
      </h2>
      <p class="mt-3 text-text-secondary">
        A few rows from the full head-to-head. Each named, each fact-checked, each linkable.
      </p>
    </div>
    <div class="reveal">
      <CompareTable vendors={teaserVendors} rows={slimRows} />
    </div>
    <div class="mt-6 reveal">
      <Button href="/enterprise/compare" variant="primary">
        See the full comparison (13 rows · 9 vendors)
      </Button>
    </div>
  </Section>

  <!-- OPEN-SOURCE CLOSE -->
  <Section tone="recessed">
    <div class="card spotlight p-8 sm:p-10 grid lg:grid-cols-[1fr_auto] gap-6 items-center reveal">
      <div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          Built in the open. Run on your own terms.
        </h2>
        <p class="mt-3 text-text-secondary max-w-2xl">
          Apache 2.0-licensed. No open-core split, no hidden enterprise switches, no telemetry leaving
          your network unless you wire it to.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <Button href="https://github.com/cloudgrid/cloudgrid" variant="primary" external>
          Star on GitHub
        </Button>
        <Button href="/handbook" variant="secondary">
          Read the handbook
        </Button>
      </div>
    </div>
  </Section>
</Layout>
