---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import FeatureCard from "../components/FeatureCard.astro";
import MockFrame from "../components/visuals/MockFrame.astro";
import TraceWaterfall from "../components/visuals/TraceWaterfall.astro";
import ArchitectureDiagram from "../components/visuals/ArchitectureDiagram.astro";
import AdapterDiagram from "../components/visuals/AdapterDiagram.astro";
import AiEvalBoard from "../components/visuals/AiEvalBoard.astro";
import CompareTable from "../components/visuals/CompareTable.astro";
import { vendors, rows } from "../data/compare";

// For the home-page teaser, show the top 4 rows + a slim vendor set.
const teaserVendors = vendors.filter((v) =>
  ["cloudgrid", "datadog", "lgtm", "langfuse"].includes(v.key)
);
const teaserRows = [
  "Open source",
  "Self-hostable",
  "Traces · Logs · Metrics in one product",
  "First-class AI agent evaluation",
  "Adapter-swappable storage",
  "No telemetry-volume / per-host pricing",
];
const slimRows = rows.filter((r) => teaserRows.includes(r.criterion));

const signalPillars = [
  {
    icon: "trace" as const,
    title: "Traces",
    description: "Distributed waterfalls, span attributes, events, live receiving.",
    href: "/features/traces",
    accent: "brand" as const,
  },
  {
    icon: "log" as const,
    title: "Logs",
    description: "Search-first analytics with trace-id pivots out of the box.",
    href: "/features/logs",
    accent: "cyan" as const,
  },
  {
    icon: "metric" as const,
    title: "Metrics",
    description: "Descriptors, attributes, exemplar pivots back into traces.",
    href: "/features/metrics",
    accent: "emerald" as const,
  },
  {
    icon: "dashboard" as const,
    title: "Dashboards",
    description: "Saved typed widgets, pinned where you work.",
    href: "/features/dashboards",
    accent: "amber" as const,
  },
  {
    icon: "ai" as const,
    title: "AI Evaluation",
    description: "Agent runs, datasets, scorers, prompt optimization.",
    href: "/features/ai-evaluation",
    accent: "violet" as const,
  },
  {
    icon: "adapter" as const,
    title: "Adapters",
    description: "Storage, message bridge, auth, eval harness — all pluggable.",
    href: "/features/adapters",
    accent: "rose" as const,
  },
];
---

<Layout title="CloudGrid — own your observability">
  <!-- HERO -->
  <Section size="lg" tone="grid" class="!pt-24 sm:!pt-32">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-6 reveal">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-soft text-[color:var(--color-emerald)] text-xs font-semibold tracking-wide uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-emerald)]"></span>
          Open source · self-hosted · MIT
        </div>
        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.05] text-text">
          Own your observability.
        </h1>
        <p class="mt-5 text-lg text-text-secondary leading-relaxed max-w-xl">
          CloudGrid is the OpenTelemetry-native platform you actually own. Traces, logs, metrics,
          dashboards, and first-class AI agent evaluation — in one self-hosted system. No vendor
          lock-in. No telemetry leaving your network.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/handbook/getting-started" size="lg">
            Get started
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </Button>
          <Button href="https://github.com/cloudgriddev/cloudgrid" variant="secondary" size="lg" external>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
            </svg>
            Star on GitHub
          </Button>
        </div>

        <!-- One-line proof bar -->
        <dl class="mt-10 grid grid-cols-3 gap-6 max-w-xl">
          <div>
            <dt class="text-xs text-text-muted uppercase tracking-wider">Signals</dt>
            <dd class="mt-1 text-xl font-semibold text-text font-mono">Traces · Logs · Metrics</dd>
          </div>
          <div>
            <dt class="text-xs text-text-muted uppercase tracking-wider">License</dt>
            <dd class="mt-1 text-xl font-semibold text-text font-mono">MIT</dd>
          </div>
          <div>
            <dt class="text-xs text-text-muted uppercase tracking-wider">Start</dt>
            <dd class="mt-1 text-xl font-semibold text-text font-mono">1 command</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-6 reveal">
        <MockFrame title="cloudgrid · /traces · agent.run">
          <div class="p-4 bg-surface">
            <TraceWaterfall />
          </div>
        </MockFrame>
      </div>
    </div>
  </Section>

  <!-- SIGNAL PILLARS -->
  <Section tone="recessed">
    <div class="max-w-3xl mb-10 reveal">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        One self-hosted system. Five signals. One contract.
      </h2>
      <p class="mt-3 text-text-secondary">
        Everything you need to observe modern systems — including the agentic ones — without
        gluing five tools together.
      </p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {signalPillars.map((p) => (
        <div class="reveal">
          <FeatureCard {...p} />
        </div>
      ))}
    </div>
  </Section>

  <!-- THE WEDGE -->
  <Section>
    <div class="max-w-3xl reveal">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-soft text-[color:var(--color-brand)] text-xs font-semibold tracking-wide uppercase">
        The wedge
      </div>
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        You shouldn't have to choose.
      </h2>
    </div>
    <div class="mt-10 grid md:grid-cols-3 gap-5">
      <div class="reveal rounded-xl border border-border-default bg-surface p-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">SaaS APM</div>
        <div class="text-sm text-text-secondary mb-3">Datadog · Honeycomb · New Relic</div>
        <p class="text-sm text-text leading-relaxed">
          Polished UI and deep correlations — but your telemetry lives on someone else's disk, with
          per-host and per-GB pricing that punishes the workloads that need observability most.
        </p>
      </div>
      <div class="reveal rounded-xl border border-border-default bg-surface p-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">OSS LGTM stacks</div>
        <div class="text-sm text-text-secondary mb-3">Grafana · Tempo · Loki · Mimir · SigNoz</div>
        <p class="text-sm text-text leading-relaxed">
          You own the data and the components are interchangeable — but you're operating three to
          five systems with three to five query languages, and signal correlation is glue you wrote.
        </p>
      </div>
      <div class="reveal rounded-xl border border-border-default bg-surface p-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">AI-eval point tools</div>
        <div class="text-sm text-text-secondary mb-3">Langfuse · Arize · Braintrust · Helicone</div>
        <p class="text-sm text-text leading-relaxed">
          Built specifically for LLM/agent traces and evaluations — but they only see the AI slice.
          Your non-AI services and your evaluations live in different worlds.
        </p>
      </div>
    </div>

    <div class="mt-10 rounded-xl border border-border-default bg-surface p-6 sm:p-8 reveal">
      <div class="grid lg:grid-cols-[1fr_auto] gap-4 items-center">
        <div>
          <div class="text-base sm:text-lg font-semibold text-text">
            CloudGrid: one OpenTelemetry-native system that does both.
          </div>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed max-w-3xl">
            Real general-purpose traces · logs · metrics · dashboards <em>and</em> first-class AI
            agent evaluation. Self-hosted, MIT-licensed, adapter-driven. Compare every cell.
          </p>
        </div>
        <Button href="/enterprise/compare" variant="primary">
          See the head-to-head
        </Button>
      </div>
    </div>
  </Section>

  <!-- ARCHITECTURE TEASER -->
  <Section tone="recessed">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-4 reveal">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-soft text-[color:var(--color-brand)] text-xs font-semibold tracking-wide uppercase">
          Architecture
        </div>
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          No public service touches the database.
        </h2>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Every read and every write crosses a message bridge. The TypeScript backend-for-frontend
          owns transport only. Go storage services own query semantics, persistence, and live
          fanout. The blast radius of a bad query is bounded by a request/reply contract — not by
          a SQL connection pool.
        </p>
        <div class="mt-6">
          <Button href="/handbook/architecture" variant="secondary">
            Architecture deep dive
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </Button>
        </div>
      </div>
      <div class="lg:col-span-8 reveal">
        <div class="rounded-xl border border-border-default bg-surface p-4 sm:p-6">
          <ArchitectureDiagram />
        </div>
      </div>
    </div>
  </Section>

  <!-- ADAPTER STORY -->
  <Section>
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-4 reveal">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-cyan-soft text-[color:var(--color-cyan)] text-xs font-semibold tracking-wide uppercase">
          Adapter-driven
        </div>
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          Every dependency sits behind a port.
        </h2>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Storage backend, message bridge, auth providers, evaluation harness — all behind explicit,
          typed ports. v1 ships SurrealDB, NATS JetStream, GitHub/Google/Entra ID SSO, and the
          <code class="font-mono text-xs px-1 py-0.5 rounded bg-recessed border border-border-subtle">puristajs/harness</code>
          adapter. You can implement your own without forking the platform.
        </p>
        <div class="mt-6">
          <Button href="/features/adapters" variant="secondary">
            Adapter overview
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </Button>
        </div>
      </div>
      <div class="lg:col-span-8 reveal">
        <AdapterDiagram />
      </div>
    </div>
  </Section>

  <!-- AI EVAL -->
  <Section tone="recessed">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 reveal">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-violet-soft text-[color:var(--color-violet)] text-xs font-semibold tracking-wide uppercase">
          AI-native
        </div>
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          Evaluate your agents next to the spans they came from.
        </h2>
        <p class="mt-4 text-text-secondary leading-relaxed">
          CloudGrid projects OpenTelemetry GenAI / OpenInference spans into first-class entities —
          AgentRun, LlmCall, ToolCall, RetrievalEvent — and lets you build datasets, define
          deterministic and judge scorers, run experiments, and optimize prompts through a harness
          adapter.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-text-secondary">
          <li class="flex gap-2"><span class="text-[color:var(--color-emerald)]">✓</span> Prompt and completion content stays on span events. Nothing is copied into a separate AI database.</li>
          <li class="flex gap-2"><span class="text-[color:var(--color-emerald)]">✓</span> Harness owns model-provider calls. CloudGrid never holds provider credentials.</li>
          <li class="flex gap-2"><span class="text-[color:var(--color-emerald)]">✓</span> Same project isolation as the rest of your telemetry.</li>
        </ul>
        <div class="mt-6">
          <Button href="/features/ai-evaluation" variant="secondary">
            AI evaluation features
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </Button>
        </div>
      </div>
      <div class="lg:col-span-7 reveal">
        <MockFrame title="cloudgrid · /ai-eval/experiments/faq_router_optim_v3">
          <AiEvalBoard />
        </MockFrame>
      </div>
    </div>
  </Section>

  <!-- COMPARE TEASER -->
  <Section>
    <div class="max-w-3xl mb-8 reveal">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-rose-soft text-[color:var(--color-rose)] text-xs font-semibold tracking-wide uppercase">
        Honest comparison
      </div>
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        How CloudGrid stacks up.
      </h2>
      <p class="mt-3 text-text-secondary">
        A few rows from the full head-to-head. Each named, each fact-checked, each linkable.
      </p>
    </div>
    <div class="reveal">
      <CompareTable vendors={teaserVendors} rows={slimRows} />
    </div>
    <div class="mt-6 reveal">
      <Button href="/enterprise/compare" variant="primary">
        See the full comparison (13 rows · 9 vendors)
      </Button>
    </div>
  </Section>

  <!-- OPEN-SOURCE FOOTER BLOCK -->
  <Section tone="recessed">
    <div class="grid lg:grid-cols-12 gap-6 items-center reveal">
      <div class="lg:col-span-8">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          Built in the open. Run on your own terms.
        </h2>
        <p class="mt-3 text-text-secondary max-w-2xl">
          MIT-licensed. Spec-driven. No open-core split, no hidden enterprise switches, no telemetry
          leaving your network unless you wire it to. The roadmap is a directory of markdown files.
        </p>
      </div>
      <div class="lg:col-span-4 flex flex-wrap gap-3 lg:justify-end">
        <Button href="https://github.com/cloudgriddev/cloudgrid" variant="primary" external>
          Star on GitHub
        </Button>
        <Button href="/handbook" variant="secondary">
          Read the handbook
        </Button>
      </div>
    </div>
  </Section>
</Layout>
