---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import Button from "../../components/Button.astro";
import PerimeterDiagram from "../../components/visuals/PerimeterDiagram.astro";

// Key questions decision makers ask. Each one is a card with: who asks it,
// the question in plain words, and CloudGrid's concrete answer.
const concerns = [
  {
    who: "Security & Audit",
    accent: "var(--color-brand)",
    icon: "M12 2 4 6v6c0 5 3.4 9.3 8 10 4.6-.7 8-5 8-10V6l-8-4Z",
    q: "Where does telemetry physically live?",
    a: "On disks you operate. CloudGrid is self-hosted; SurrealDB (the v1 storage adapter) runs inside your VPC, on-prem, or in your regulated cloud. Your spans, logs, and metrics stay inside the deployment you control.",
    proof: "Self-hosted deployment. Storage adapter is swappable; the database lives where you run it.",
  },
  {
    who: "Privacy & DPO",
    accent: "var(--color-violet)",
    icon: "M12 2c4 0 7 3 7 7v3l2 4-2 1v3a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-3l-2-1 2-4V9c0-4 3-7 7-7Z",
    q: "What about PII inside spans, logs, datasets, or AI outputs?",
    a: "Redaction is owned by the OTel pipeline and dataset policies you control. CloudGrid stores what you send and keeps evaluation datasets, observed outputs, reasons, and source links inside your deployment boundary. Provider settings are stored as references; raw provider secrets stay server-side.",
    proof:
      "Telemetry, datasets, evaluation results, and provider settings stay project-scoped and self-hosted.",
  },
  {
    who: "Legal & Procurement",
    accent: "var(--color-emerald)",
    icon: "M3 7h18v12H3zM3 7l9-4 9 4M8 12h8M8 16h5",
    q: "What is the license, and what are the IP & sub-processor risks?",
    a: "Apache 2.0 with Commons Clause. Internal company use and use inside your own products are permitted. Commercial SaaS, white-label, hosted resale, or managed-service offerings are available through a separate agreement. One source-available distribution, source review end-to-end, and zero CloudGrid sub-processors touching your telemetry.",
    proof:
      "Apache 2.0 + Commons Clause. Source-reviewable distribution. Zero telemetry sub-processors.",
  },
  {
    who: "Identity & Access",
    accent: "var(--color-cyan)",
    icon: "M12 7a4 4 0 1 1 0 8 4 4 0 0 1 0-8ZM4 21a8 8 0 0 1 16 0",
    q: "How do users sign in and how are sessions protected?",
    a: "Deployed mode uses GitHub, Google, or Microsoft Entra ID through a BFF-managed session: HttpOnly cookies, server-side OAuth exchange, and provider tokens kept out of browser storage. Project membership is enforced server-side at every query and live subscription.",
    proof: "OIDC/OAuth. BFF-managed sessions. Project membership enforced at read time.",
  },
  {
    who: "Risk & Compliance",
    accent: "var(--color-amber)",
    icon: "M12 2 2 22h20L12 2Zm0 6v6m0 3v.01",
    q: "What is the blast radius if something goes wrong?",
    a: "Bounded by a request/reply contract. Public services stay on the BFF and bridge side of the boundary. Storage services own query semantics and enforce authorization, so database access stays inside private services.",
    proof: "BFF uses bridge contracts. Storage clients stay inside private services.",
  },
  {
    who: "Finance & FinOps",
    accent: "var(--color-rose)",
    icon: "M4 7h16M4 12h10M4 17h16",
    q: "Will observability costs grow with traffic the way our SaaS bills do?",
    a: "CloudGrid pricing is independent of telemetry volume. You pay for compute and storage in your cloud, on hardware you control. Costs scale with infrastructure capacity rather than span, host, or GB meters.",
    proof: "Self-priced. Volume scaling is a capacity-planning question.",
  },
];

// Compliance / control posture rows. Honest "supported / your control / on the roadmap".
const posture = [
  { control: "Data residency", cg: "supported", note: "You choose the region." },
  { control: "Self-hosting", cg: "supported", note: "Local, Compose, Kubernetes." },
  { control: "SSO (OIDC/OAuth)", cg: "supported", note: "GitHub, Google, Microsoft Entra ID." },
  {
    control: "RBAC — company + project roles",
    cg: "supported",
    note: "admin / user · viewer / editor / admin.",
  },
  { control: "Project isolation", cg: "supported", note: "API, message, persistence layers." },
  {
    control: "Structured logs (JSON + trace context)",
    cg: "supported",
    note: "One JSON object per line, Kubernetes-ready.",
  },
  {
    control: "Read authorization on every query and subscription",
    cg: "supported",
    note: "Live subs respect the same auth as queries.",
  },
  {
    control: "Audit log of admin actions",
    cg: "your-control",
    note: "Ship it via OTLP into the same CloudGrid.",
  },
  {
    control: "Retention policy per project",
    cg: "supported",
    note: "Configurable in control-plane.",
  },
  {
    control: "PII redaction",
    cg: "your-control",
    note: "Done in your OTel pipeline before ingest.",
  },
  {
    control: "Encryption at rest",
    cg: "your-control",
    note: "SurrealDB + your filesystem / volume encryption.",
  },
  {
    control: "Encryption in transit",
    cg: "your-control",
    note: "TLS at the BFF / collector — your terminator of choice.",
  },
  {
    control: "Backup / DR",
    cg: "your-control",
    note: "SurrealDB backups, your DR posture.",
  },
  {
    control: "Alerting routing to PagerDuty / Opsgenie / Slack",
    cg: "maturing",
    note: "Foundations shipped; integrations evolving.",
  },
  { control: "Long-term cold storage offload", cg: "roadmap", note: "Future storage adapter." },
];

const postureBadge: Record<string, { label: string; color: string }> = {
  supported: { label: "supported", color: "var(--color-emerald)" },
  "your-control": { label: "your control", color: "var(--color-amber)" },
  maturing: { label: "maturing", color: "var(--color-cyan)" },
  roadmap: { label: "on the roadmap", color: "var(--color-violet)" },
};

const licensePaths = [
  {
    title: "Use CloudGrid in your own environment",
    label: "Allowed by default",
    accent: "var(--color-emerald)",
    body: "Run CloudGrid for your company, your teams, and your own products. You can study the source, modify it, deploy it internally, and use it to observe commercial systems you operate.",
  },
  {
    title: "Offer CloudGrid as your own SaaS or white-label product",
    label: "Commercial path",
    accent: "var(--color-brand)",
    body: "Hosted access, white-label packaging, managed hosting, embedded observability products, and commercial services built substantially around CloudGrid can be covered by a separate commercial license.",
  },
];

// Quick-answer brief — the procurement reviewer one-pager.
const brief = [
  { k: "License", v: "Apache 2.0 + Commons Clause" },
  { k: "Commercial SaaS / white-label", v: "Available by separate license" },
  { k: "Self-hostable", v: "Yes — primary deployment model" },
  { k: "Telemetry sub-processors", v: "Zero CloudGrid-operated sub-processors" },
  { k: "Telemetry egress from CloudGrid", v: "Stays inside your deployment by default" },
  { k: "Auth (deployed)", v: "GitHub · Google · Microsoft Entra ID via OIDC/OAuth" },
  { k: "Session model", v: "BFF-managed HttpOnly cookies" },
  { k: "Data residency", v: "Wherever you deploy" },
  { k: "Isolation primitive", v: "Project (API, message, persistence)" },
  { k: "OTLP ingest", v: "HTTP :4318 + gRPC :4317 — traces, logs, metrics" },
  {
    k: "AI evaluation",
    v: "Project-scoped datasets, evaluations, comparisons, and optimization evidence",
  },
  { k: "Backups & DR", v: "Your control — SurrealDB tooling + your runbook" },
  { k: "Cost model", v: "Self-priced compute + storage" },
];
---

<Layout title="Enterprise — CloudGrid">
  <!-- HERO -->
  <Section size="lg">
    <PageHeader
      eyebrow="Enterprise"
      accent="brand"
      highlight="own"
      title="Observability you own. End of clause."
      description="CloudGrid is the OpenTelemetry-native platform you deploy inside your own perimeter. Telemetry stays in the environment you control, and procurement-grade questions have one-line answers here."
    />
    <div class="reveal mt-7 flex flex-wrap gap-3" data-delay="3">
      <Button href="#perimeter" variant="primary">See the data perimeter</Button>
      <Button href="/enterprise/whitelabel-solution" variant="secondary">White-label solution</Button>
      <Button href="/enterprise/compare" variant="secondary">Compare risk vs alternatives</Button>
    </div>
  </Section>

  <!-- KEY QUESTIONS / ANSWERS -->
  <Section tone="recessed">
    <div class="max-w-3xl reveal">
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        The six questions your reviewers will ask.
      </h2>
      <p class="mt-3 text-text-secondary">
        Each is the version we hear most from enterprise procurement, security, legal, and finance.
        Each has a one-paragraph answer and a one-line proof point.
      </p>
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-5">
      {concerns.map((c, i) => (
        <div
          class="card spotlight flex h-full flex-col p-6"
          data-delay={(((i % 3) + 1)) as any}
          style={`--accent: ${c.accent};`}
        >
          <div class="flex items-start justify-between gap-4">
            <div
              class="w-10 h-10 rounded-lg inline-flex items-center justify-center icon-pop"
              style={`background: color-mix(in srgb, ${c.accent} 14%, transparent); color: ${c.accent};`}
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={c.icon}></path>
              </svg>
            </div>
            <div class="chip" style={`background: color-mix(in srgb, ${c.accent} 12%, transparent); color: ${c.accent};`}>
              {c.who}
            </div>
          </div>
          <h3 class="mt-5 text-base sm:text-lg font-semibold text-text leading-snug">
            “{c.q}”
          </h3>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed flex-1">{c.a}</p>
          <div class="mt-5 pt-4 border-t border-border-subtle">
            <div class="text-[10px] uppercase tracking-wider font-semibold text-text-muted mb-1">Proof</div>
            <div class="text-xs text-text">{c.proof}</div>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- LICENSE PATHS -->
  <Section id="license-paths">
    <div class="grid lg:grid-cols-[0.85fr_1.45fr] gap-10 items-start">
      <div class="reveal-x">
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          Clear for operators. Flexible for partners.
        </h2>
        <p class="mt-3 text-text-secondary leading-relaxed">
          CloudGrid's public license is designed for self-hosted adoption with one reviewable
          source-available distribution.
          Product companies can use it for their own systems. Service providers, white-label
          vendors, and hosted observability businesses can use a commercial license when CloudGrid
          itself becomes the product being offered.
        </p>
        <p class="mt-4 text-sm text-text-muted leading-relaxed">
          The short version: use it to observe your products; use the commercial path when
          CloudGrid becomes your hosted, white-label, or managed-service offer.
        </p>
      </div>

      <div class="grid gap-4">
        {licensePaths.map((path) => (
          <div
            class="card spotlight p-5"
            style={`--accent: ${path.accent};`}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <h3 class="text-base font-semibold text-text">{path.title}</h3>
              <span class="chip" style={`background: color-mix(in srgb, ${path.accent} 12%, transparent); color: ${path.accent};`}>
                {path.label}
              </span>
            </div>
            <p class="mt-3 text-sm text-text-secondary leading-relaxed">{path.body}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- DATA PERIMETER -->
  <Section id="perimeter">
    <div class="grid lg:grid-cols-[1fr_1.4fr] gap-10 items-start">
      <div class="reveal-x">
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          What leaves your perimeter is what you wire to leave.
        </h2>
        <p class="mt-4 text-text-secondary leading-relaxed">
          CloudGrid runs inside your infrastructure and renders traces from services you operate.
          Outbound channels are the ones you configure — your SSO IdP for sign-in, and your model
          provider when an enabled evaluation or optimization target needs that
          provider.
        </p>
        <ul class="mt-6 space-y-2.5 text-sm">
          <li class="flex gap-3 items-start">
            <span class="mt-1 inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--color-emerald)]"></span>
            <span class="text-text"><strong>Allowed by default:</strong> inbound OTLP from your senders, outbound SSO callbacks to your IdP.</span>
          </li>
          <li class="flex gap-3 items-start">
            <span class="mt-1 inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--color-amber)]"></span>
            <span class="text-text"><strong>Opt-in integrations:</strong> evaluation target → model provider, alert routing to Slack / PagerDuty, etc.</span>
          </li>
          <li class="flex gap-3 items-start">
            <span class="mt-1 inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--color-rose)]"></span>
            <span class="text-text"><strong>Telemetry stays local:</strong> CloudGrid runs inside your deployment boundary.</span>
          </li>
        </ul>
      </div>

      <div class="reveal-scale">
        <PerimeterDiagram />
      </div>
    </div>
  </Section>

  <!-- CONTROL POSTURE -->
  <Section tone="recessed">
    <div class="max-w-3xl reveal">
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        What's enforced, what's yours, what's coming.
      </h2>
      <p class="mt-3 text-text-secondary">
        Honest map of which controls CloudGrid enforces in code, which controls live in your
        control, and which are still maturing. Hand it to your security reviewer.
      </p>
    </div>

    <div class="mt-8 reveal">
      <div class="card overflow-hidden p-0">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-recessed border-b border-border-default">
              <tr>
                <th class="text-left px-5 py-3 text-xs font-semibold uppercase tracking-wider text-text-muted">Control</th>
                <th class="text-left px-5 py-3 text-xs font-semibold uppercase tracking-wider text-text-muted w-44">Status</th>
                <th class="text-left px-5 py-3 text-xs font-semibold uppercase tracking-wider text-text-muted">Note</th>
              </tr>
            </thead>
            <tbody>
              {posture.map((r) => {
                const b = postureBadge[r.cg];
                return (
                  <tr class="border-b border-border-subtle last:border-b-0 hover:bg-surface-hover transition-colors">
                    <td class="px-5 py-3 font-medium text-text">{r.control}</td>
                    <td class="px-5 py-3">
                      <span class="chip" style={`background: color-mix(in srgb, ${b.color} 12%, transparent); color: ${b.color};`}>
                        {b.label}
                      </span>
                    </td>
                    <td class="px-5 py-3 text-text-secondary">{r.note}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </Section>

  <!-- ONE-PAGE BRIEF -->
  <Section>
    <div class="grid lg:grid-cols-[1fr_1.5fr] gap-10 items-start">
      <div class="reveal-x">
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-text">
          The procurement-grade summary.
        </h2>
        <p class="mt-3 text-text-secondary">
          Print this. Send it to the security questionnaire owner. It answers most of what they
          need to start, and it's honest about what stays in your control.
        </p>
        <div class="mt-6">
          <Button href="/enterprise/compare" variant="primary">
            Compare CloudGrid to your current stack
          </Button>
        </div>
      </div>

      <div class="reveal">
        <div class="card overflow-hidden p-0">
          <dl class="divide-y divide-border-subtle">
            {brief.map((row) => (
              <div class="grid grid-cols-[180px_1fr] gap-4 px-5 py-3">
                <dt class="text-xs uppercase tracking-wider font-semibold text-text-muted">{row.k}</dt>
                <dd class="text-sm text-text">{row.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </Section>

  <!-- CLOSE -->
  <Section tone="recessed">
    <div class="card spotlight p-8 sm:p-10 grid lg:grid-cols-[1fr_auto] gap-6 items-center reveal">
      <div>
        <h2 class="text-2xl font-semibold text-text">Bring it past the security review.</h2>
        <p class="mt-3 text-text-secondary max-w-2xl">
          The Handbook has the operational detail — deployment topology, SSO setup, isolation
          model, scaling guidance. The compare page is for when you want to put CloudGrid against
          your current vendor on a single page.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <Button href="/handbook/deployment" variant="primary">Deployment guide</Button>
        <Button href="/enterprise/whitelabel-solution" variant="secondary">White-label solution</Button>
        <Button href="/enterprise/compare" variant="secondary">Side-by-side comparison</Button>
      </div>
    </div>
  </Section>
</Layout>
