---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import CompareTable from "../../components/visuals/CompareTable.astro";
import { vendors, rows } from "../../data/compare";

const vendorNotes = [
  {
    name: "Datadog",
    body:
      "The most complete commercial APM. Polished UI, vast integration catalogue, mature AI Observability add-on. Trade-off: SaaS-only, your telemetry lives on Datadog's disks, per-host and per-GB pricing makes the workloads that need observability most also the workloads that get rate-limited first. CloudGrid trades polish for ownership and predictable cost.",
  },
  {
    name: "Honeycomb",
    body:
      "Best-in-class wide-event tracing UX and BubbleUp-style exploration. SaaS-only, no first-class logs or AI evaluation today. CloudGrid is closer to Honeycomb than to Datadog in spirit — but self-hostable, with logs and AI-eval included.",
  },
  {
    name: "Grafana LGTM (Tempo + Loki + Mimir/Prometheus)",
    body:
      "The reference open-source observability stack. Strong components, ubiquitous deployment patterns, and you own everything. Trade-off: you're operating three to five products with three to five query languages, and signal correlation is glue you wrote. CloudGrid is one product, one query path, one storage adapter — with AI evaluation in the same box.",
  },
  {
    name: "SigNoz",
    body:
      "Closest single-product OSS competitor: traces, logs, metrics in one UI. Tight ClickHouse coupling and no adapter port for storage. AI evaluation is not its focus. CloudGrid's wedge vs SigNoz is adapter-driven extensibility and first-class AI eval.",
  },
  {
    name: "Jaeger (+ Tempo)",
    body:
      "Mature, well-understood, multi-backend distributed tracing. Tracing only — no logs, no metrics, no AI-eval. Great as a tracing backend; not the whole observability story.",
  },
  {
    name: "Langfuse",
    body:
      "Strong AI-eval product with prompt versioning, judge scorers, and tracing for LLM apps. Open-core: cloud and enterprise tiers gate features. CloudGrid covers the same AI-eval surface, MIT-licensed, evaluating agents inside a full observability platform — so the non-AI parts of your stack are visible in the same UI.",
  },
  {
    name: "Arize Phoenix",
    body:
      "Excellent OSS evaluation and tracing tool for AI applications, strong in retrieval-augmented generation analysis. Single-purpose: it doesn't replace your APM or your logs system. CloudGrid covers both jobs with shared isolation and authorization.",
  },
  {
    name: "Braintrust",
    body:
      "Polished commercial AI-eval platform with dataset, scorer, and experiment management. SaaS-only, proprietary. CloudGrid covers the same eval workflows in OSS, with the rest of your stack visible alongside.",
  },
  {
    name: "Helicone (and similar gateways)",
    body:
      "LLM proxy / observability tools that sit in front of model providers. Useful for cost capture and rate limiting; not a general-purpose observability platform. Complementary, not a substitute — CloudGrid ingests OTLP from whichever proxy you choose.",
  },
];
---

<Layout title="Compare CloudGrid vs Datadog, Honeycomb, Grafana, Langfuse — CloudGrid">
  <Section size="lg">
    <PageHeader
      eyebrow="Compare"
      accent="brand"
      title="How CloudGrid stacks up — named, fact-checked, honest."
      description="Every column is a real product. Every cell is a single, defensible claim. Where CloudGrid loses or only partially wins, we say so."
    />
    <p class="mt-5 text-sm text-text-muted max-w-3xl">
      Legend: <span class="font-semibold text-[color:var(--color-emerald)]">✓</span> yes ·
      <span class="font-semibold text-[color:var(--color-amber)]">◐</span> partial ·
      <span class="font-semibold text-[color:var(--color-rose)]">✗</span> no ·
      <span class="font-mono text-text-muted">—</span> not applicable. Mouse over cells with notes for detail.
    </p>
  </Section>

  <Section tone="recessed" size="sm">
    <div class="reveal">
      <CompareTable vendors={vendors} rows={rows} />
    </div>
  </Section>

  <Section>
    <div class="max-w-3xl mb-8 reveal">
      <h2 class="text-2xl font-semibold tracking-tight text-text">Per-vendor notes</h2>
      <p class="mt-3 text-text-secondary">
        Each of these tools is good at what it does. The notes describe what they're great at and
        what trade-off CloudGrid offers if you choose differently.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {vendorNotes.map((v, i) => (
        <div class="card spotlight is-interactive flex h-full flex-col p-6 reveal" data-delay={(((i % 3) + 1)) as any}>
          <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Vendor</div>
          <div class="mt-1 text-lg font-semibold text-text">{v.name}</div>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed flex-1">{v.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="recessed">
    <div class="rounded-xl border border-border-default bg-surface p-6 sm:p-8 reveal">
      <h2 class="text-xl font-semibold text-text">A short take</h2>
      <p class="mt-3 text-text-secondary leading-relaxed">
        Pick CloudGrid when you want one self-hosted, OpenTelemetry-native system that does
        traces, logs, metrics, dashboards, <em>and</em> AI agent evaluation — with every
        infrastructure dependency sitting behind a swappable port. Pick a SaaS APM when you'd
        rather not run the system at all. Pick a Grafana stack when you want best-of-breed
        components and you have the operational appetite to wire them. Pick a Langfuse / Arize /
        Braintrust when AI-eval is the whole problem and you don't care about the rest of the
        stack.
      </p>
    </div>
  </Section>
</Layout>
