---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import PageHeader from "../../components/PageHeader.astro";
import CompareTable from "../../components/visuals/CompareTable.astro";
import { vendors, rows } from "../../data/compare";

const vendorNotes = [
  {
    name: "Datadog",
    body: "The most complete commercial APM. Polished UI, vast integration catalogue, mature AI Observability add-on. Trade-off: vendor-operated storage and per-host / per-GB pricing. CloudGrid emphasizes ownership and infrastructure-based cost control.",
  },
  {
    name: "Honeycomb",
    body: "Best-in-class wide-event tracing UX and BubbleUp-style exploration. CloudGrid is closer to Honeycomb than to Datadog in spirit, with self-hosting, logs, and AI-eval included.",
  },
  {
    name: "Grafana LGTM (Tempo + Loki + Mimir/Prometheus)",
    body: "The reference open-source observability stack. Strong components, ubiquitous deployment patterns, and you own everything. Trade-off: you're operating three to five products with three to five query languages, and signal correlation is glue you wrote. CloudGrid is one product, one query path, one storage adapter — with AI evaluation in the same box.",
  },
  {
    name: "SigNoz",
    body: "Closest single-product OSS competitor: traces, logs, metrics in one UI. CloudGrid's difference is adapter-driven extensibility, storage-port ownership, and first-class AI eval.",
  },
  {
    name: "Jaeger (+ Tempo)",
    body: "Mature, well-understood, multi-backend distributed tracing. Great as a tracing backend; CloudGrid adds logs, metrics, dashboards, and AI-eval in one product.",
  },
  {
    name: "Langfuse",
    body: "Strong AI-eval product with prompt management, datasets, evaluations, and tracing for LLM apps. Open-core: cloud and enterprise tiers gate features. CloudGrid's difference is that AI behavior is evaluated beside the same traces, logs, metrics, dashboards, and project controls used for the rest of the system.",
  },
  {
    name: "Arize Phoenix",
    body: "Excellent OSS evaluation and tracing tool for AI applications, strong in retrieval-augmented generation analysis. CloudGrid focuses on one project workspace where telemetry evidence, datasets, evaluation runs, and optimization decisions remain connected across AI and general service telemetry.",
  },
  {
    name: "Braintrust",
    body: "Polished commercial AI-eval platform with dataset and evaluation management. CloudGrid offers the evaluation loop in a source-available, self-hosted observability product, so promotion decisions can reference full-stack telemetry evidence.",
  },
  {
    name: "Helicone (and similar gateways)",
    body: "LLM proxy / observability tools that sit in front of model providers. Useful for cost capture and rate limiting; complementary to a general-purpose observability platform. CloudGrid ingests OTLP from whichever proxy you choose.",
  },
];
---

<Layout title="Compare CloudGrid vs Datadog, Honeycomb, Grafana, Langfuse — CloudGrid">
  <Section size="lg">
    <PageHeader
      eyebrow="Compare"
      accent="brand"
      title="How CloudGrid stacks up — named, fact-checked, honest."
      description="Every column is a real product. Every cell is a single, defensible claim. Coverage differences are stated directly."
    />
  </Section>

  <Section tone="recessed" size="sm">
    <div class="reveal">
      <CompareTable vendors={vendors} rows={rows} />
      <p class="mt-4 text-sm text-text-muted max-w-3xl">
        Legend: <span class="font-semibold text-[color:var(--color-emerald)]">✓</span> yes ·
        <span class="font-semibold text-[color:var(--color-amber)]">◐</span> partial ·
        <span class="font-semibold text-[color:var(--color-rose)]">○</span> different focus ·
        <span class="font-mono text-text-muted">—</span> context-specific. Mouse over cells with notes for detail.
      </p>
    </div>
  </Section>

  <Section>
    <div class="max-w-3xl mb-8 reveal">
      <h2 class="text-2xl font-semibold tracking-tight text-text">Per-vendor notes</h2>
      <p class="mt-3 text-text-secondary">
        Each of these tools is good at what it does. The notes describe what they're great at and
        what trade-off CloudGrid offers if you choose differently.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {vendorNotes.map((v, i) => (
        <div class="card spotlight is-interactive flex h-full flex-col p-6 reveal" data-delay={(((i % 3) + 1)) as any}>
          <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Vendor</div>
          <div class="mt-1 text-lg font-semibold text-text">{v.name}</div>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed flex-1">{v.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="recessed">
    <div class="rounded-xl border border-border-default bg-surface p-6 sm:p-8 reveal">
      <h2 class="text-xl font-semibold text-text">A short take</h2>
      <p class="mt-3 text-text-secondary leading-relaxed">
        Pick CloudGrid when you want one self-hosted, OpenTelemetry-native system that does
        traces, logs, metrics, dashboards, <em>and</em> AI evaluation and optimization — with every
        infrastructure dependency sitting behind a swappable port. Pick a SaaS APM when a
        vendor-operated platform is the right fit. Pick a Grafana stack when you want
        best-of-breed components and you have the operational appetite to wire them. Pick a
        Langfuse / Arize / Braintrust when AI-eval is the focused scope.
      </p>
    </div>
  </Section>
</Layout>
