---
import { render } from "astro:content";
import HandbookLayout from "../../components/handbook/HandbookLayout.astro";
import { findHandbookEntry } from "../../lib/handbook";

const entry = await findHandbookEntry("");
if (!entry) throw new Error("handbook root index.md is missing or has an unexpected id");
const { Content, headings } = await render(entry);
---

<HandbookLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.eyebrow}
  accent={entry.data.accent}
  updated={entry.data.updated}
  headings={headings}
  currentSlug="/handbook"
>
  <Content />
</HandbookLayout>
