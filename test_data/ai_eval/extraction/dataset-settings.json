{
  "evaluationFamily": "extraction",
  "inputType": "json",
  "expectedType": "json",
  "inputJsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["text"],
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "string",
        "enum": ["email", "sms", "chat"]
      }
    }
  },
  "expectedJsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["orderId", "customerEmail", "orderDate", "currency", "total", "items"],
    "properties": {
      "orderId": {
        "type": "string",
        "pattern": "^ORD-[0-9]{5}$"
      },
      "customerEmail": {
        "type": "string",
        "format": "email"
      },
      "orderDate": {
        "type": "string",
        "format": "date"
      },
      "currency": {
        "type": "string",
        "enum": ["EUR", "USD", "GBP"]
      },
      "total": {
        "type": "number",
        "minimum": 0
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sku", "quantity"],
          "properties": {
            "sku": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "discountCode": {
        "type": "string"
      },
      "shippingCountry": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2
      }
    }
  },
  "expectedValueOptions": [],
  "defaultSplit": "training",
  "intakePolicy": {
    "manualDefaultStatus": "ready",
    "importDefaultStatus": "ready",
    "traceDefaultStatus": "needs_expected"
  },
  "traceIntakeRules": [],
  "anonymizationPolicy": {
    "mode": "realistic",
    "policyId": null,
    "policyVersion": null,
    "consistencyScope": "dataset",
    "blockedEntityTypes": []
  },
  "defaultMetricSettings": [
    {
      "metricId": "extraction.field_match_rate",
      "options": {
        "extraction": {
          "requiredOnly": false,
          "extraFieldPolicy": "schema",
          "arrayModeByPath": {
            "$.items": "ordered"
          },
          "stringComparisonByPath": {
            "$.customerEmail": "case_insensitive",
            "$.shippingCountry": "exact"
          },
          "numericToleranceByPath": {
            "$.total": 0
          },
          "dateFormatByPath": {
            "$.orderDate": "date"
          }
        }
      }
    }
  ],
  "retentionProfile": "balanced"
}
