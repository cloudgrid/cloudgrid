{
  "name": "Order confirmation extraction",
  "description": "Extract normalized order data from short transactional messages.",
  "inputValueType": "json",
  "expectedOutputValueType": "json",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["text"],
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "string",
        "enum": ["email", "sms", "chat"]
      }
    }
  },
  "expectedOutputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["orderId", "customerEmail", "orderDate", "currency", "total", "items"],
    "properties": {
      "orderId": {
        "type": "string",
        "pattern": "^ORD-[0-9]{5}$"
      },
      "customerEmail": {
        "type": "string",
        "format": "email"
      },
      "orderDate": {
        "type": "string",
        "format": "date"
      },
      "currency": {
        "type": "string",
        "enum": ["EUR", "USD", "GBP"]
      },
      "total": {
        "type": "number",
        "minimum": 0
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sku", "quantity"],
          "properties": {
            "sku": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "discountCode": {
        "type": "string"
      },
      "shippingCountry": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2
      }
    }
  },
  "defaultSplit": "validation",
  "defaultReviewStatus": "ready",
  "defaultMetric": "extraction.exact_json_match"
}
