{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-114",
  "title": "OptimizationRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "status",
    "baselineTargetSnapshotId",
    "objective",
    "searchPolicy",
    "candidateTargetSnapshotIds",
    "causedEvaluationRunIds",
    "quickShotPolicy",
    "comparisonIds",
    "budgetSnapshot",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "projectId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "pausing",
        "paused",
        "cancelling",
        "cancelled",
        "completed",
        "failed"
      ]
    },
    "baselineTargetSnapshotId": { "type": "string" },
    "objective": { "$ref": "#/$defs/optimizationObjective" },
    "searchPolicy": { "$ref": "#/$defs/optimizationSearchPolicy" },
    "trainingEvaluationDefinitionId": { "type": "string" },
    "trainingSplitSelector": { "$ref": "./evaluation-definition.schema.json#/$defs/splitSelector" },
    "validationEvaluationDefinitionId": { "type": "string" },
    "validationSplitSelector": {
      "$ref": "./evaluation-definition.schema.json#/$defs/splitSelector"
    },
    "testEvaluationDefinitionId": { "type": "string" },
    "testSplitSelector": { "$ref": "./evaluation-definition.schema.json#/$defs/splitSelector" },
    "candidateTargetSnapshotIds": { "type": "array", "items": { "type": "string" }, "default": [] },
    "causedEvaluationRunIds": { "type": "array", "items": { "type": "string" }, "default": [] },
    "quickShotPolicy": { "$ref": "#/$defs/quickShotPolicy" },
    "comparisonIds": { "type": "array", "items": { "type": "string" }, "default": [] },
    "selectedCandidateSnapshotId": { "type": "string" },
    "promotionRecordId": { "type": "string" },
    "budgetSnapshot": { "type": "object", "additionalProperties": true },
    "skillOptimization": { "$ref": "#/$defs/skillOptimizationDetail" },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" }
  },
  "anyOf": [
    { "required": ["trainingEvaluationDefinitionId"] },
    { "required": ["trainingSplitSelector"] }
  ],
  "$defs": {
    "optimizationObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryMetricId",
        "secondaryMetricIds",
        "constraints",
        "tradeoffMetricIds",
        "rankingPolicy",
        "tieBreakers",
        "minimumEvidence"
      ],
      "properties": {
        "primaryMetricId": { "type": "string", "minLength": 1 },
        "secondaryMetricIds": { "type": "array", "items": { "type": "string" }, "default": [] },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/objectiveConstraint" },
          "default": []
        },
        "tradeoffMetricIds": { "type": "array", "items": { "type": "string" }, "default": [] },
        "rankingPolicy": {
          "type": "string",
          "enum": ["primary_then_constraints", "weighted_score", "pareto"]
        },
        "tieBreakers": { "type": "array", "items": { "type": "string" }, "default": [] },
        "minimumEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minItems", "requiredSplits"],
          "properties": {
            "minItems": { "type": "integer", "minimum": 1 },
            "requiredSplits": {
              "type": "array",
              "items": { "type": "string", "enum": ["training", "validation", "test"] },
              "default": []
            }
          }
        }
      }
    },
    "optimizationSearchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimizerKind",
        "editablePartKinds",
        "maxEpochs",
        "maxSteps",
        "rolloutBatchSize",
        "reflectionMinibatchSize",
        "editBudget",
        "minEditBudget",
        "editSchedule",
        "gateMetricId",
        "gateMode",
        "selectionSplit",
        "allowSlowUpdate",
        "allowMetaMemory"
      ],
      "properties": {
        "optimizerKind": {
          "type": "string",
          "enum": ["bootstrap_fewshot", "critic_mutate_judge_pick", "skill_text_edit"]
        },
        "editablePartKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "prompt",
              "examples",
              "model_config",
              "tool_config",
              "skill",
              "workflow",
              "agent_config",
              "adapter_metadata"
            ]
          }
        },
        "maxEpochs": { "type": "integer", "minimum": 1 },
        "maxSteps": { "type": "integer", "minimum": 0 },
        "rolloutBatchSize": { "type": "integer", "minimum": 1 },
        "reflectionMinibatchSize": { "type": "integer", "minimum": 1 },
        "editBudget": { "type": "integer", "minimum": 1 },
        "minEditBudget": { "type": "integer", "minimum": 1 },
        "editSchedule": { "type": "string", "enum": ["constant", "linear", "cosine", "autonomous"] },
        "gateMetricId": { "type": "string", "minLength": 1 },
        "gateMode": { "type": "string", "enum": ["strict_improvement"] },
        "selectionSplit": { "type": "string", "enum": ["validation"] },
        "allowSlowUpdate": { "type": "boolean" },
        "allowMetaMemory": { "type": "boolean" },
        "skillPolicy": { "$ref": "#/$defs/skillOptimizationPolicy" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "optimizerKind": { "const": "skill_text_edit" } },
            "required": ["optimizerKind"]
          },
          "then": { "required": ["skillPolicy"] }
        }
      ]
    },
    "skillOptimizationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPackageBytes",
        "maxSkillBytes",
        "maxSkillTokens",
        "allowedEditOps",
        "editableFileGlobs",
        "protectedFileGlobs",
        "allowScriptEdits",
        "preserveSections",
        "exportBestSkill"
      ],
      "properties": {
        "maxPackageBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "maxSkillBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maxSkillTokens": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "allowedEditOps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["append", "insert_after", "replace", "delete"] }
        },
        "editableFileGlobs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "default": ["SKILL.md", "references/**/*.md", "examples/**/*.md"]
        },
        "protectedFileGlobs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["scripts/**", "**/*.lock", "**/*.{png,jpg,jpeg,gif,webp,pdf,zip,tar,gz}"]
        },
        "allowScriptEdits": { "type": "boolean", "default": false },
        "preserveSections": { "type": "array", "items": { "type": "string" }, "default": [] },
        "exportBestSkill": { "type": "boolean" }
      }
    },
    "skillOptimizationDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineSkillDigest",
        "acceptedStepCount",
        "rejectedStepCount",
        "skippedStepCount",
        "failedStepCount"
      ],
      "properties": {
        "baselineSkillDigest": { "type": "string", "minLength": 1 },
        "currentSkillDigest": { "type": "string" },
        "bestSkillDigest": { "type": "string" },
        "bestTargetSnapshotId": { "type": "string" },
        "exportedSkillContentRef": { "type": "string" },
        "acceptedStepCount": { "type": "integer", "minimum": 0 },
        "rejectedStepCount": { "type": "integer", "minimum": 0 },
        "skippedStepCount": { "type": "integer", "minimum": 0 },
        "failedStepCount": { "type": "integer", "minimum": 0 }
      }
    },
    "objectiveConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "operator", "value"],
      "properties": {
        "metricId": { "type": "string" },
        "operator": { "type": "string", "enum": ["lt", "lte", "eq", "gte", "gt", "no_regression"] },
        "value": { "type": "number" },
        "hard": { "type": "boolean", "default": true }
      }
    },
    "quickShotPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDatasetVersionId",
        "split",
        "selectionStrategy",
        "selectedItemRevisionIds",
        "minimumSampleSize",
        "metricSettingsSnapshot",
        "runPolicySnapshot"
      ],
      "properties": {
        "sourceDatasetVersionId": { "type": "string" },
        "split": { "type": "string", "enum": ["training", "validation", "test"] },
        "selectionStrategy": {
          "type": "string",
          "enum": [
            "failed_categories",
            "weak_fields",
            "edge_cases",
            "high_cost_rows",
            "recent_failures",
            "representative_clusters",
            "stratified_random"
          ]
        },
        "selectedItemRevisionIds": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "seed": { "type": "integer" },
        "minimumSampleSize": { "type": "integer", "minimum": 1 },
        "metricSettingsSnapshot": {
          "$ref": "./evaluation-definition.schema.json#/$defs/metricSettings"
        },
        "runPolicySnapshot": { "$ref": "./eval-run-policy.schema.json" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "selectionStrategy": { "const": "stratified_random" } },
            "required": ["selectionStrategy"]
          },
          "then": { "required": ["seed"] }
        }
      ]
    }
  }
}
