{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-006",
  "title": "DatasetItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "datasetId",
    "latestRevisionId",
    "latestRevisionVersion",
    "latestRevisionDigest",
    "createdAt",
    "createdBy",
    "updatedAt",
    "updatedBy"
  ],
  "properties": {
    "id": { "type": "string" },
    "projectId": { "type": "string" },
    "datasetId": { "type": "string" },
    "latestRevisionId": { "type": "string" },
    "latestRevisionVersion": { "type": "integer", "minimum": 1 },
    "latestRevisionDigest": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string" }
  }
}
