{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-022",
  "title": "EvalResultPayloads",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultKind", "metrics", "breakdown", "visualization"],
  "properties": {
    "resultKind": {
      "type": "string",
      "enum": [
        "classification",
        "json_schema",
        "llm_judge",
        "pairwise_judge",
        "semantic_similarity",
        "rag",
        "tool_correctness",
        "trajectory",
        "workflow",
        "human_review",
        "composite",
        "deterministic"
      ]
    },
    "metrics": { "type": "object", "additionalProperties": true },
    "breakdown": { "type": "object", "additionalProperties": true },
    "visualization": { "type": "object", "additionalProperties": true },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "allOf": [
    {
      "if": { "properties": { "resultKind": { "const": "classification" } } },
      "then": {
        "properties": {
          "metrics": { "$ref": "#/$defs/classificationMetrics" },
          "breakdown": { "$ref": "#/$defs/classificationBreakdown" },
          "visualization": { "$ref": "#/$defs/confusionMatrixVisualization" }
        }
      }
    },
    {
      "if": { "properties": { "resultKind": { "const": "llm_judge" } } },
      "then": {
        "properties": {
          "metrics": { "$ref": "#/$defs/llmJudgeMetrics" },
          "breakdown": { "$ref": "#/$defs/llmJudgeBreakdown" },
          "visualization": { "$ref": "#/$defs/factCoverageVisualization" }
        }
      }
    },
    {
      "if": { "properties": { "resultKind": { "const": "rag" } } },
      "then": {
        "properties": {
          "metrics": { "$ref": "#/$defs/ragMetrics" },
          "breakdown": { "$ref": "#/$defs/ragBreakdown" },
          "visualization": { "$ref": "#/$defs/ragVisualization" }
        }
      }
    },
    {
      "if": { "properties": { "resultKind": { "const": "tool_correctness" } } },
      "then": {
        "properties": {
          "metrics": { "$ref": "#/$defs/toolMetrics" },
          "breakdown": { "$ref": "#/$defs/toolBreakdown" },
          "visualization": { "$ref": "#/$defs/toolVisualization" }
        }
      }
    },
    {
      "if": { "properties": { "resultKind": { "enum": ["trajectory", "workflow"] } } },
      "then": {
        "properties": {
          "metrics": { "$ref": "#/$defs/stepMetrics" },
          "breakdown": { "$ref": "#/$defs/stepBreakdown" },
          "visualization": { "$ref": "#/$defs/stepsVisualization" }
        }
      }
    },
    {
      "if": { "properties": { "resultKind": { "const": "composite" } } },
      "then": {
        "properties": {
          "metrics": { "$ref": "#/$defs/compositeMetrics" },
          "breakdown": { "$ref": "#/$defs/compositeBreakdown" },
          "visualization": { "$ref": "#/$defs/compositeVisualization" }
        }
      }
    }
  ],
  "$defs": {
    "classificationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "support"],
      "properties": {
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "support": { "type": "integer", "minimum": 0 },
        "macroF1": { "type": "number", "minimum": 0, "maximum": 1 },
        "weightedF1": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "classificationBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "accuracy", "support"],
            "properties": {
              "label": { "type": "string" },
              "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
              "support": { "type": "integer", "minimum": 0 },
              "precision": { "type": "number", "minimum": 0, "maximum": 1 },
              "recall": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "confusionMatrixVisualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "labels", "matrix"],
      "properties": {
        "kind": { "type": "string", "const": "confusion_matrix" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "matrix": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        },
        "examples": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/exampleRef" } }
      }
    },
    "llmJudgeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "primaryFactCoverage"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "primaryFactCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "secondaryFactCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "unsupportedClaimCount": { "type": "integer", "minimum": 0 }
      }
    },
    "llmJudgeBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rubric": { "type": "array", "items": { "$ref": "#/$defs/rubricCriterion" } },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/factCheck" } },
        "missingCriticalFacts": { "type": "array", "items": { "type": "string" } },
        "unsupportedClaims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "factCoverageVisualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "primary", "secondary"],
      "properties": {
        "kind": { "type": "string", "enum": ["fact_coverage", "rubric_breakdown"] },
        "primary": { "$ref": "#/$defs/factCoverageGroup" },
        "secondary": { "$ref": "#/$defs/factCoverageGroup" }
      }
    },
    "ragMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "faithfulness": { "type": "number", "minimum": 0, "maximum": 1 },
        "contextRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "answerRelevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "citationCoverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ragBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supportedClaims": { "type": "array", "items": { "type": "string" } },
        "unsupportedClaims": { "type": "array", "items": { "type": "string" } },
        "missingEvidence": { "type": "array", "items": { "type": "string" } },
        "documentRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ragVisualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "const": "rag_grounding" },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "toolMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredCallMatchRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "extraCallCount": { "type": "integer", "minimum": 0 },
        "missingCallCount": { "type": "integer", "minimum": 0 },
        "argumentIssueCount": { "type": "integer", "minimum": 0 }
      }
    },
    "toolBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missingCalls": { "type": "array", "items": { "type": "string" } },
        "extraCalls": { "type": "array", "items": { "type": "string" } },
        "argumentIssues": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "orderViolations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "toolVisualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rows"],
      "properties": {
        "kind": { "type": "string", "const": "tool_call_diff" },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "stepMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredStepMatchRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "forbiddenStepCount": { "type": "integer", "minimum": 0 },
        "loopLimitExceeded": { "type": "boolean" }
      }
    },
    "stepBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "handoffIssues": { "type": "array", "items": { "type": "string" } },
        "finalOutcomeIssues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stepsVisualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps"],
      "properties": {
        "kind": { "type": "string", "enum": ["trajectory_steps", "workflow_steps"] },
        "steps": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "compositeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "passed"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": { "type": "boolean" },
        "blocked": { "type": "boolean" }
      }
    },
    "compositeBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "children": { "type": "array", "items": { "$ref": "#/$defs/compositeChild" } },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compositeVisualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": { "type": "string", "const": "composite_gate" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/compositeChild" } }
      }
    },
    "rubricCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "score", "passed"],
      "properties": {
        "name": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": { "type": "boolean" },
        "comment": { "type": "string", "maxLength": 1000 }
      }
    },
    "factCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "importance", "present"],
      "properties": {
        "id": { "type": "string" },
        "importance": { "type": "string", "enum": ["primary", "secondary"] },
        "present": { "type": "boolean" },
        "quote": { "type": "string", "maxLength": 500 }
      }
    },
    "factCoverageGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "compositeChild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scorerId", "weight", "passed", "score"],
      "properties": {
        "scorerId": { "type": "string" },
        "weight": { "type": "number", "minimum": 0 },
        "passed": { "type": "boolean" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "blocking": { "type": "boolean" }
      }
    },
    "exampleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "label"],
      "properties": {
        "targetId": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRefs": { "type": "array", "items": { "type": "string" } },
        "quotes": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 }
        },
        "traceRefs": { "type": "array", "items": { "type": "string" } },
        "toolCallRefs": { "type": "array", "items": { "type": "string" } },
        "documentRefs": { "type": "array", "items": { "type": "string" } },
        "rationaleSummary": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
