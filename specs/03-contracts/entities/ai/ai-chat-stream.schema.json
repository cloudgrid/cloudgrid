{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIC-007",
  "title": "AiChatStream",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [{ "$ref": "#/$defs/streamRequest" }, { "$ref": "#/$defs/streamEvent" }],
  "$defs": {
    "userMessagePart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "type": "string", "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "streamRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "projectId", "userMessageClientId", "idempotencyKey", "parts"],
      "properties": {
        "conversationId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "userMessageClientId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 160 },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/userMessagePart" },
          "minItems": 1,
          "maxItems": 16
        },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "streamEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conversationId", "runId", "sequence", "createdAt", "payload"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "run.started",
            "message.created",
            "text.delta",
            "tool.started",
            "tool.completed",
            "artifact.created",
            "action.proposed",
            "compaction.started",
            "compaction.saved",
            "run.completed",
            "run.failed",
            "heartbeat"
          ]
        },
        "conversationId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/runStartedPayload" },
            { "$ref": "#/$defs/messageCreatedPayload" },
            { "$ref": "#/$defs/textDeltaPayload" },
            { "$ref": "#/$defs/toolStatusPayload" },
            { "$ref": "#/$defs/artifactCreatedPayload" },
            { "$ref": "#/$defs/actionProposedPayload" },
            { "$ref": "#/$defs/compactionPayload" },
            { "$ref": "#/$defs/runTerminalPayload" },
            { "$ref": "#/$defs/heartbeatPayload" }
          ]
        }
      }
    },
    "runStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "const": "streaming" }
      }
    },
    "messageCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "role"],
      "properties": {
        "messageId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["user", "assistant"] }
      }
    },
    "textDeltaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "text"],
      "properties": {
        "messageId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "toolStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "toolName", "label", "status"],
      "properties": {
        "toolCallId": { "type": "string", "minLength": 1 },
        "toolName": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_.]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["running", "completed", "failed"] },
        "durationMs": { "type": "integer", "minimum": 0 },
        "errorCode": { "type": "string", "minLength": 1 }
      }
    },
    "artifactCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "artifactId", "renderer", "label", "renderSpec"],
      "properties": {
        "messageId": { "type": "string", "minLength": 1 },
        "artifactId": { "type": "string", "minLength": 1 },
        "renderer": {
          "type": "string",
          "enum": [
            "metric_timeseries",
            "metric_bar",
            "table",
            "key_value",
            "trace_waterfall",
            "log_list",
            "mermaid",
            "json_tree",
            "diff",
            "status_summary",
            "action_approval"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "renderSpec": { "type": "object", "additionalProperties": true },
        "sourceToolCallIds": { "type": "array", "items": { "type": "string" } },
        "artifactIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actionProposedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "actionProposalId", "risk", "actionKind"],
      "properties": {
        "messageId": { "type": "string", "minLength": 1 },
        "actionProposalId": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "destructive"] },
        "actionKind": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" }
      }
    },
    "compactionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["started", "saved"] },
        "compactionId": { "type": "string" }
      }
    },
    "runTerminalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "failed"] },
        "problem": { "type": "object", "additionalProperties": true },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "heartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "const": "alive" }
      }
    }
  }
}
