{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-007",
  "title": "Scorer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "definition", "version"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "deterministic",
        "schema_json",
        "semantic",
        "rag",
        "llm_judge",
        "pairwise_judge",
        "tool_correctness",
        "trajectory",
        "workflow",
        "human",
        "composite"
      ]
    },
    "definition": { "$ref": "./scorer-definition.schema.json" },
    "judgeModelRef": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "calibration": { "type": "object", "additionalProperties": true }
  }
}
