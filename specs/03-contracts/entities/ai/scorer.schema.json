{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-007",
  "title": "Scorer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "definition", "version"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "kind": { "type": "string", "enum": ["deterministic", "rag", "llm_judge", "human"] },
    "definition": { "type": "object", "additionalProperties": true },
    "judgeModelRef": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "calibration": { "type": "object", "additionalProperties": true }
  }
}
