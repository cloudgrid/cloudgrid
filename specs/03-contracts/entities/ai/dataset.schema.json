{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-005",
  "title": "Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "name",
    "settings",
    "currentVersionId",
    "currentVersion",
    "currentDigest",
    "itemCount",
    "readyItemCount",
    "splitCounts",
    "health",
    "createdAt",
    "createdBy",
    "updatedAt",
    "updatedBy"
  ],
  "properties": {
    "id": { "type": "string" },
    "projectId": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "settings": { "$ref": "#/$defs/datasetSettings" },
    "currentVersionId": { "type": "string" },
    "currentVersion": { "type": "integer", "minimum": 1 },
    "currentDigest": { "type": "string", "minLength": 1 },
    "itemCount": { "type": "integer", "minimum": 0 },
    "readyItemCount": { "type": "integer", "minimum": 0 },
    "splitCounts": { "$ref": "#/$defs/splitCounts" },
    "health": { "type": "object", "additionalProperties": true },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "metadata": { "type": "object", "additionalProperties": true, "default": {} },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string" }
  },
  "$defs": {
    "datasetSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationFamily",
        "inputType",
        "expectedType",
        "defaultSplit",
        "intakePolicy",
        "defaultMetricSettings",
        "retentionProfile"
      ],
      "properties": {
        "evaluationFamily": { "$ref": "#/$defs/evaluationFamily" },
        "inputType": { "type": "string", "enum": ["text", "json"] },
        "expectedType": { "type": "string", "enum": ["text", "json"] },
        "inputJsonSchema": { "$ref": "#/$defs/jsonSchemaOrNull" },
        "expectedJsonSchema": { "$ref": "#/$defs/jsonSchemaOrNull" },
        "defaultSplit": { "$ref": "#/$defs/split" },
        "intakePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manual", "import", "trace"],
          "properties": {
            "manual": { "$ref": "#/$defs/curationStatus" },
            "import": { "$ref": "#/$defs/curationStatus" },
            "trace": { "$ref": "#/$defs/curationStatus" },
            "candidate": { "$ref": "#/$defs/curationStatus" }
          }
        },
        "expectedValueOptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedValueOption" },
          "default": []
        },
        "traceIntakeRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/traceIntakeRule" },
          "default": []
        },
        "anonymizationPolicy": { "type": "object", "additionalProperties": true },
        "defaultMetricSettings": { "$ref": "#/$defs/metricSettings" },
        "retentionProfile": { "$ref": "#/$defs/retentionProfile" }
      },
      "allOf": [
        {
          "if": { "properties": { "inputType": { "const": "text" } }, "required": ["inputType"] },
          "then": { "properties": { "inputJsonSchema": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "expectedType": { "const": "text" } },
            "required": ["expectedType"]
          },
          "then": { "properties": { "expectedJsonSchema": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "expectedType": { "const": "json" } },
            "required": ["expectedType"]
          },
          "then": {
            "required": ["expectedJsonSchema"],
            "properties": { "expectedJsonSchema": { "type": "object" } }
          }
        }
      ]
    },
    "evaluationFamily": {
      "type": "string",
      "enum": [
        "classification",
        "extraction",
        "freeform_answer",
        "tool_use",
        "agent_loop",
        "workflow",
        "skill"
      ]
    },
    "expectedValueOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {},
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "traceIntakeRule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "enabled", "match", "mappings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean", "default": true },
        "match": { "type": "object", "additionalProperties": true },
        "mappings": { "type": "object", "additionalProperties": true },
        "defaults": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "jsonSchemaOrNull": {
      "oneOf": [{ "type": "object", "additionalProperties": true }, { "type": "null" }]
    },
    "split": { "type": "string", "enum": ["training", "validation", "test"] },
    "splitCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training", "validation", "test"],
      "properties": {
        "training": { "type": "integer", "minimum": 0 },
        "validation": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 }
      }
    },
    "curationStatus": {
      "type": "string",
      "enum": ["draft", "needs_expected", "needs_review", "ready", "rejected"]
    },
    "metricSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricIds", "options"],
      "properties": {
        "metricIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "primaryMetricId": { "type": "string", "minLength": 1 },
        "options": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "retentionProfile": {
      "type": "string",
      "enum": ["balanced", "fast_iteration", "audit_friendly", "minimal_storage"]
    }
  }
}
