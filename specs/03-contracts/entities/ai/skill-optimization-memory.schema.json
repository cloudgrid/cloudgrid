{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-125",
  "title": "SkillOptimizationMemory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "optimizationRunId",
    "projectId",
    "rejectedEditBuffer",
    "updatedAt"
  ],
  "properties": {
    "optimizationRunId": { "type": "string" },
    "projectId": { "type": "string" },
    "rejectedEditBuffer": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "./skill-optimization-step.schema.json#/$defs/edit" },
      "default": []
    },
    "slowUpdateContent": { "type": "string", "maxLength": 8192 },
    "metaMemoryContent": { "type": "string", "maxLength": 8192 },
    "truncated": { "type": "boolean", "default": false },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
