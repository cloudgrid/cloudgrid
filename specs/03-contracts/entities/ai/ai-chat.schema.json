{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIC-001",
  "title": "AiChat",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/conversation" },
    { "$ref": "#/$defs/message" },
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/artifact" },
    { "$ref": "#/$defs/actionProposal" },
    { "$ref": "#/$defs/compaction" }
  ],
  "$defs": {
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "companyId",
        "projectId",
        "userId",
        "title",
        "status",
        "lastMessageAt",
        "lastRunStatus",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "companyId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "providerProfileSnapshot": { "type": "object", "additionalProperties": true },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "lastRunStatus": {
          "type": "string",
          "enum": ["idle", "streaming", "failed", "awaiting_approval"]
        },
        "latestCompactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "messagePart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text",
            "artifact",
            "tool_status",
            "action_proposal",
            "approval_result",
            "error",
            "compaction_summary"
          ]
        },
        "text": { "type": "string" },
        "artifactId": { "type": "string" },
        "renderer": {
          "type": "string",
          "enum": [
            "metric_timeseries",
            "metric_bar",
            "table",
            "key_value",
            "trace_waterfall",
            "log_list",
            "mermaid",
            "json_tree",
            "diff",
            "status_summary",
            "action_approval"
          ]
        },
        "actionProposalId": { "type": "string" },
        "toolCallId": { "type": "string" },
        "toolName": { "type": "string" },
        "label": { "type": "string" },
        "status": { "type": "string" },
        "problem": { "type": "object", "additionalProperties": true }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "conversationId", "role", "parts", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["user", "assistant", "tool", "system"] },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/messagePart" },
          "minItems": 1
        },
        "tokenEstimate": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conversationId",
        "projectId",
        "userId",
        "status",
        "toolCallCount",
        "sandboxScriptCount",
        "artifactCount",
        "startedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["queued", "streaming", "completed", "failed", "cancelled", "awaiting_approval"]
        },
        "providerKind": { "type": "string" },
        "model": { "type": "string" },
        "traceId": { "type": "string" },
        "toolCallCount": { "type": "integer", "minimum": 0 },
        "sandboxScriptCount": { "type": "integer", "minimum": 0 },
        "artifactCount": { "type": "integer", "minimum": 0 },
        "inputTokenCount": { "type": "integer", "minimum": 0 },
        "outputTokenCount": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conversationId",
        "runId",
        "kind",
        "label",
        "mediaType",
        "sizeBytes",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["json_render", "data_file", "script", "script_output"]
        },
        "label": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "renderSpec": { "type": "object", "additionalProperties": true },
        "fileRef": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "actionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conversationId",
        "runId",
        "projectId",
        "risk",
        "status",
        "actionKind",
        "inputPreview",
        "requiresApproval",
        "idempotencyKey",
        "expiresAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "destructive"] },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "executing",
            "succeeded",
            "failed",
            "expired"
          ]
        },
        "actionKind": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
        "graphqlMutation": { "type": "string" },
        "inputPreview": { "type": "object", "additionalProperties": true },
        "requiresApproval": { "type": "boolean" },
        "approvedByUserId": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conversationId",
        "sourceMessageCount",
        "summary",
        "retainedMessageIds",
        "artifactSummaries",
        "pendingActionIds",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "sourceMessageCount": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "retainedMessageIds": { "type": "array", "items": { "type": "string" } },
        "artifactSummaries": { "type": "array", "items": { "type": "string" } },
        "pendingActionIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
