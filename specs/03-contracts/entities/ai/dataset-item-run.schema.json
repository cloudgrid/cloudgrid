{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-011",
  "title": "DatasetItemRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "experimentRunId", "datasetItemId", "output", "latencyMs"],
  "properties": {
    "id": { "type": "string" },
    "experimentRunId": { "type": "string" },
    "datasetItemId": { "type": "string" },
    "harnessRunId": { "type": "string" },
    "output": true,
    "latencyMs": { "type": "number", "minimum": 0 },
    "tokenTotals": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "evalResultIds": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
