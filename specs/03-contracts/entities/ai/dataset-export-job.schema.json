{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-023",
  "title": "DatasetExportJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "datasetId",
    "datasetVersionId",
    "datasetVersion",
    "datasetDigest",
    "status",
    "format",
    "rowCount",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "projectId": { "type": "string" },
    "datasetId": { "type": "string" },
    "datasetVersionId": { "type": "string" },
    "datasetVersion": { "type": "integer", "minimum": 1 },
    "datasetDigest": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["queued", "ready", "failed", "expired"] },
    "format": { "type": "string", "enum": ["jsonl", "json_array", "csv", "hugging_face_jsonl"] },
    "rowCount": { "type": "integer", "minimum": 0 },
    "sizeBytes": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string" },
    "downloadUrl": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
