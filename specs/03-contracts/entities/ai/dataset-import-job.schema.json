{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-022",
  "title": "DatasetImportJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "datasetId",
    "status",
    "format",
    "sourceFiles",
    "mapping",
    "defaults",
    "previewRows",
    "totalRows",
    "validRows",
    "errorRows",
    "warnings",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "projectId": { "type": "string" },
    "datasetId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["staged", "preview_ready", "committed", "failed", "expired"]
    },
    "format": {
      "type": "string",
      "enum": ["jsonl", "json_array", "csv", "zip", "hugging_face_jsonl", "hugging_face_csv"]
    },
    "sourceFiles": { "type": "array", "items": { "$ref": "#/$defs/sourceFile" } },
    "mapping": { "$ref": "#/$defs/importMapping" },
    "defaults": { "$ref": "#/$defs/importDefaults" },
    "previewRows": { "type": "array", "items": { "$ref": "#/$defs/previewRow" } },
    "totalRows": { "type": "integer", "minimum": 0 },
    "validRows": { "type": "integer", "minimum": 0 },
    "errorRows": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "committedDatasetVersionId": { "type": "string" },
    "committedDatasetVersion": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "sizeBytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["jsonl", "json_array", "csv", "zip", "hugging_face_jsonl", "hugging_face_csv"]
        },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" }
      }
    },
    "importMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "expected", "reason", "split", "metadata"],
      "properties": {
        "input": { "type": "string" },
        "expected": { "type": "string" },
        "observedOutput": { "type": "string" },
        "reason": { "type": "string" },
        "split": { "type": "string" },
        "metadata": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "importDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "curationStatus", "contentTreatment"],
      "properties": {
        "split": { "type": "string", "enum": ["training", "validation", "test"] },
        "curationStatus": {
          "type": "string",
          "enum": ["draft", "needs_expected", "needs_review", "ready", "rejected"]
        },
        "contentTreatment": {
          "type": "string",
          "enum": ["original", "realistic_anonymized", "redacted", "synthetic"]
        },
        "metadata": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "previewRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowNumber", "filePath", "errors", "warnings"],
      "properties": {
        "rowNumber": { "type": "integer", "minimum": 1 },
        "filePath": { "type": "string" },
        "item": { "$ref": "#/$defs/itemPreview" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/issue" }, "default": [] },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/issue" }, "default": [] }
      }
    },
    "itemPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "metadata", "split", "curationStatus", "contentTreatment"],
      "properties": {
        "input": true,
        "expected": true,
        "observedOutput": true,
        "reason": { "type": "string", "default": "" },
        "metadata": { "type": "object", "additionalProperties": true, "default": {} },
        "split": { "type": "string", "enum": ["training", "validation", "test"] },
        "curationStatus": {
          "type": "string",
          "enum": ["draft", "needs_expected", "needs_review", "ready", "rejected"]
        },
        "contentTreatment": {
          "type": "string",
          "enum": ["original", "realistic_anonymized", "redacted", "synthetic"]
        },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "./dataset-item-revision.schema.json#/$defs/sourceRef" },
          "default": []
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
