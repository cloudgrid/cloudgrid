{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-019",
  "title": "ExperimentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "digest",
    "experimentRunId",
    "experimentId",
    "datasetId",
    "datasetVersion",
    "splitSelector",
    "datasetItemIds",
    "scorerRefs",
    "solverRef",
    "promptVersionRefs",
    "skillSnapshotRefs",
    "toolSnapshotRefs",
    "providerProfileRefs",
    "budget",
    "concurrency",
    "runPolicy",
    "createdAt"
  ],
  "properties": {
    "schema": { "type": "string", "const": "cloudgrid.ai-eval.experiment-manifest.v1" },
    "version": { "type": "integer", "const": 1 },
    "digest": { "type": "string", "minLength": 16 },
    "experimentRunId": { "type": "string" },
    "experimentId": { "type": "string" },
    "datasetId": { "type": "string" },
    "datasetVersion": { "type": "integer", "minimum": 1 },
    "splitSelector": { "$ref": "#/$defs/splitSelector" },
    "datasetItemIds": { "type": "array", "items": { "type": "string" } },
    "scorerRefs": { "type": "array", "items": { "$ref": "#/$defs/versionedRef" } },
    "baselineRef": { "$ref": "./eval-run-ref.schema.json#/$defs/baselineRef" },
    "solverRef": { "$ref": "./eval-run-ref.schema.json#/$defs/solverRef" },
    "optimizationConfig": { "$ref": "./eval-run-ref.schema.json#/$defs/optimizationConfig" },
    "promptVersionRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "skillSnapshotRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "toolSnapshotRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "providerProfileRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "budget": { "$ref": "./eval-run-policy.schema.json#/$defs/costBudget" },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxParallelRequests"],
      "properties": {
        "maxParallelRequests": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "runPolicy": { "$ref": "./eval-run-policy.schema.json" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "splitSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["splits", "reviewedOnly", "includeSynthetic"],
      "properties": {
        "splits": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["dev", "optimization", "validation", "regression", "holdout"]
          }
        },
        "reviewedOnly": { "type": "boolean" },
        "includeSynthetic": { "type": "boolean" }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
