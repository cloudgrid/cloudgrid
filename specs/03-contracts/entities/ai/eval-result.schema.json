{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-008",
  "title": "EvalResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scorerId",
    "scorerVersion",
    "targetKind",
    "targetId",
    "score",
    "passed",
    "producedAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "scorerId": { "type": "string" },
    "scorerVersion": { "type": "integer", "minimum": 1 },
    "targetKind": { "type": "string", "enum": ["agentRun", "span", "datasetItemRun"] },
    "targetId": { "type": "string" },
    "experimentRunId": { "type": "string" },
    "score": { "type": "number" },
    "passed": { "type": "boolean" },
    "evidence": { "type": "object", "additionalProperties": true },
    "judgeRunRef": { "type": "string" },
    "producedAt": { "type": "string", "format": "date-time" }
  }
}
