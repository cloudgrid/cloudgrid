{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-014",
  "title": "ProjectAiSettings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "enabled",
    "providerProfiles",
    "modelAliases",
    "onlinePolicies",
    "budget",
    "sampling",
    "runPolicyDefaults",
    "datasetPipeline",
    "datasetDefaults",
    "version",
    "updatedAt",
    "updatedByUserId"
  ],
  "properties": {
    "projectId": { "type": "string" },
    "enabled": { "type": "boolean" },
    "defaultProviderProfileId": { "type": "string" },
    "defaultJudgeProfileId": { "type": "string" },
    "defaultOptimizerProfileId": { "type": "string" },
    "defaultEmbeddingProfileId": { "type": "string" },
    "providerProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerProfile" },
      "default": []
    },
    "modelAliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/modelAlias" },
      "default": []
    },
    "onlinePolicies": {
      "type": "array",
      "items": { "$ref": "#/$defs/onlinePolicy" },
      "default": []
    },
    "budget": { "$ref": "#/$defs/budget" },
    "sampling": { "$ref": "#/$defs/sampling" },
    "runPolicyDefaults": { "$ref": "./eval-run-policy.schema.json" },
    "datasetPipeline": { "$ref": "#/$defs/datasetPipeline" },
    "datasetDefaults": { "$ref": "#/$defs/datasetDefaults" },
    "effective": { "$ref": "#/$defs/effective" },
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedByUserId": { "type": "string" }
  },
  "$defs": {
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "label", "providerKind", "models", "timeoutMs"],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "providerKind": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "azure_openai",
            "google_vertex",
            "bedrock",
            "openai_compatible",
            "local_harness",
            "custom_harness"
          ]
        },
        "baseUrl": { "type": "string" },
        "credentialRef": { "type": "string" },
        "models": { "type": "object", "additionalProperties": true },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 100 },
        "disabledAt": { "type": "string", "format": "date-time" }
      }
    },
    "modelAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "providerProfileId", "model", "purpose", "parameters"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "providerProfileId": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "purpose": {
          "type": "string",
          "enum": ["judge", "optimizer", "embedding", "replay", "default"]
        },
        "parameters": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "onlinePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "name",
        "target",
        "scorerIds",
        "sampleRate",
        "contentAllowance",
        "maxLatencyClass",
        "annotationRules"
      ],
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "target": { "$ref": "#/$defs/onlinePolicyTarget" },
        "scorerIds": { "type": "array", "items": { "type": "string" } },
        "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxDailyRuns": { "type": "integer", "minimum": 1 },
        "contentAllowance": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "metadata_only",
              "captured_content",
              "dataset_content",
              "retrieved_document_content"
            ]
          },
          "default": ["metadata_only"]
        },
        "maxLatencyClass": {
          "type": "string",
          "enum": ["inline", "near_realtime", "batch"],
          "default": "batch"
        },
        "annotationRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotationRule" },
          "default": []
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedByUserId": { "type": "string" }
      }
    },
    "onlinePolicyTarget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "agentId": { "type": "string", "minLength": 1 },
        "agentName": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "serviceName": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "routePrefix": { "type": "string", "minLength": 1 },
        "toolName": { "type": "string", "minLength": 1 },
        "retrievalSource": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "promptVersionId": { "type": "string", "minLength": 1 },
        "experimentRunId": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/onlinePolicyAttributeFilter" },
          "default": []
        }
      }
    },
    "onlinePolicyAttributeFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$"
        },
        "operator": {
          "type": "string",
          "enum": ["eq", "neq", "contains", "exists", "gt", "gte", "lt", "lte", "in", "not_in"]
        },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            {
              "type": "array",
              "items": {
                "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
              }
            }
          ]
        }
      }
    },
    "annotationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" },
        "assignTo": { "type": "string" },
        "datasetId": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dailyUsd", "deterministicOnly"],
      "properties": {
        "dailyUsd": { "type": "number", "minimum": 0 },
        "perRunUsd": { "type": "number", "minimum": 0 },
        "deterministicOnly": { "type": "boolean", "default": false },
        "spentTodayUsd": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultOnlineSampleRate",
        "maxOnlineSampleRate",
        "maxConcurrentExperimentItems",
        "maxConcurrentOptimizationCandidates"
      ],
      "properties": {
        "defaultOnlineSampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxOnlineSampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxConcurrentExperimentItems": { "type": "integer", "minimum": 1 },
        "maxConcurrentOptimizationCandidates": { "type": "integer", "minimum": 1 }
      }
    },
    "datasetDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splitAllocation",
        "smallDatasetReviewedThreshold",
        "requireReviewForRegression"
      ],
      "properties": {
        "splitAllocation": { "type": "object", "additionalProperties": true },
        "smallDatasetReviewedThreshold": { "type": "integer", "minimum": 1, "default": 30 },
        "requireReviewForRegression": { "type": "boolean", "default": true }
      }
    },
    "datasetPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateSuggestionsEnabled",
        "requireReviewBeforeCommit",
        "anonymizationMode",
        "anonymizationConsistencyScope",
        "preserveLocale",
        "preserveTemporalDistance",
        "blockedEntityTypes"
      ],
      "properties": {
        "candidateSuggestionsEnabled": { "type": "boolean", "default": true },
        "requireReviewBeforeCommit": { "type": "boolean", "default": true },
        "anonymizationMode": {
          "type": "string",
          "enum": ["off", "realistic", "redact"],
          "default": "realistic"
        },
        "anonymizationPolicyId": { "type": "string" },
        "anonymizationPolicyVersion": { "type": "integer", "minimum": 1 },
        "anonymizationConsistencyScope": {
          "type": "string",
          "enum": ["project", "dataset"],
          "default": "dataset"
        },
        "preserveLocale": { "type": "boolean", "default": true },
        "preserveTemporalDistance": { "type": "boolean", "default": true },
        "blockedEntityTypes": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warnings",
        "deterministicOnly",
        "missingProviderProfiles",
        "disabledProviderProfiles",
        "budgetExhausted"
      ],
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
        "deterministicOnly": { "type": "boolean" },
        "missingProviderProfiles": { "type": "array", "items": { "type": "string" } },
        "disabledProviderProfiles": { "type": "array", "items": { "type": "string" } },
        "budgetExhausted": { "type": "boolean" }
      }
    }
  }
}
