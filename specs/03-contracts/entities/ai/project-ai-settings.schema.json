{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-014",
  "title": "ProjectAiSettings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "enabled",
    "providerProfiles",
    "modelAliases",
    "onlinePolicies",
    "budget",
    "sampling",
    "runPolicyDefaults",
    "datasetPipeline",
    "datasetDefaults",
    "evaluationDefaults",
    "optimizationDefaults",
    "version",
    "updatedAt",
    "updatedByUserId"
  ],
  "properties": {
    "projectId": { "type": "string" },
    "enabled": { "type": "boolean" },
    "defaultProviderProfileId": { "type": "string" },
    "defaultJudgeProfileId": { "type": "string" },
    "defaultOptimizerProfileId": { "type": "string" },
    "defaultEmbeddingProfileId": { "type": "string" },
    "providerProfiles": { "type": "array", "items": { "$ref": "#/$defs/providerProfile" }, "default": [] },
    "modelAliases": { "type": "array", "items": { "$ref": "#/$defs/modelAlias" }, "default": [] },
    "onlinePolicies": { "type": "array", "items": { "$ref": "#/$defs/onlinePolicy" }, "default": [] },
    "budget": { "$ref": "#/$defs/budget" },
    "sampling": { "$ref": "#/$defs/sampling" },
    "runPolicyDefaults": { "$ref": "./eval-run-policy.schema.json" },
    "datasetPipeline": { "$ref": "#/$defs/datasetPipeline" },
    "datasetDefaults": { "$ref": "#/$defs/datasetDefaults" },
    "evaluationDefaults": { "$ref": "#/$defs/evaluationDefaults" },
    "optimizationDefaults": { "$ref": "#/$defs/optimizationDefaults" },
    "effective": { "$ref": "#/$defs/effective" },
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedByUserId": { "type": "string" }
  },
  "$defs": {
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "label", "providerKind", "models", "timeoutMs"],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "providerKind": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "azure_openai",
            "google_vertex",
            "bedrock",
            "openai_compatible",
            "local_harness",
            "custom_harness"
          ]
        },
        "baseUrl": { "type": "string" },
        "credentialRef": { "type": "string" },
        "models": { "type": "object", "additionalProperties": true },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 100 },
        "disabledAt": { "type": "string", "format": "date-time" }
      }
    },
    "modelAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "providerProfileId", "model", "purpose", "parameters"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "providerProfileId": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "enum": ["judge", "optimizer", "embedding", "replay", "default"] },
        "parameters": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "onlinePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "name",
        "target",
        "metricIds",
        "sampleRate",
        "contentAllowance",
        "maxLatencyClass",
        "annotationRules"
      ],
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "target": { "$ref": "./evaluation-target-ref.schema.json" },
        "metricIds": { "type": "array", "items": { "type": "string" }, "default": [] },
        "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxDailyRuns": { "type": "integer", "minimum": 1 },
        "contentAllowance": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["none", "metadata_only", "captured_content", "dataset_content", "retrieved_document_content"]
          },
          "default": ["metadata_only"]
        },
        "maxLatencyClass": { "type": "string", "enum": ["inline", "near_realtime", "batch"], "default": "batch" },
        "annotationRules": { "type": "array", "items": { "$ref": "#/$defs/annotationRule" }, "default": [] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedByUserId": { "type": "string" }
      }
    },
    "annotationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" },
        "assignTo": { "type": "string" },
        "datasetId": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dailyUsd", "deterministicOnly"],
      "properties": {
        "dailyUsd": { "type": "number", "minimum": 0 },
        "perRunUsd": { "type": "number", "minimum": 0 },
        "deterministicOnly": { "type": "boolean", "default": false },
        "spentTodayUsd": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultOnlineSampleRate",
        "maxOnlineSampleRate",
        "maxConcurrentEvaluationItems",
        "maxConcurrentOptimizationCandidates"
      ],
      "properties": {
        "defaultOnlineSampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxOnlineSampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxConcurrentEvaluationItems": { "type": "integer", "minimum": 1 },
        "maxConcurrentOptimizationCandidates": { "type": "integer", "minimum": 1 }
      }
    },
    "datasetDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultSplit", "requireReviewBeforeReady", "retentionProfile"],
      "properties": {
        "defaultSplit": { "type": "string", "enum": ["training", "validation", "test"] },
        "requireReviewBeforeReady": { "type": "boolean", "default": true },
        "retentionProfile": {
          "type": "string",
          "enum": ["balanced", "fast_iteration", "audit_friendly", "minimal_storage"],
          "default": "balanced"
        }
      }
    },
    "datasetPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateSuggestionsEnabled",
        "requireReviewBeforeCommit",
        "anonymizationMode",
        "anonymizationConsistencyScope",
        "preserveLocale",
        "preserveTemporalDistance",
        "blockedEntityTypes"
      ],
      "properties": {
        "candidateSuggestionsEnabled": { "type": "boolean", "default": true },
        "requireReviewBeforeCommit": { "type": "boolean", "default": true },
        "anonymizationMode": { "type": "string", "enum": ["off", "realistic", "redact"], "default": "realistic" },
        "anonymizationPolicyId": { "type": "string" },
        "anonymizationPolicyVersion": { "type": "integer", "minimum": 1 },
        "anonymizationConsistencyScope": { "type": "string", "enum": ["project", "dataset"], "default": "dataset" },
        "preserveLocale": { "type": "boolean", "default": true },
        "preserveTemporalDistance": { "type": "boolean", "default": true },
        "blockedEntityTypes": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "evaluationDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetVersionPolicy", "splitSelector", "metricIds", "retentionProfile"],
      "properties": {
        "datasetVersionPolicy": { "type": "string", "enum": ["latest_ready", "pinned"], "default": "latest_ready" },
        "splitSelector": {
          "type": "array",
          "items": { "type": "string", "enum": ["training", "validation", "test"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "metricIds": { "type": "array", "items": { "type": "string" }, "default": [] },
        "retentionProfile": {
          "type": "string",
          "enum": ["balanced", "fast_iteration", "audit_friendly", "minimal_storage"],
          "default": "balanced"
        }
      }
    },
    "optimizationDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSampleSize", "allowedTargetPartKinds"],
      "properties": {
        "minimumSampleSize": { "type": "integer", "minimum": 1, "default": 20 },
        "allowedTargetPartKinds": {
          "type": "array",
          "items": { "type": "string", "enum": ["prompt", "examples", "model_config"] },
          "default": ["prompt", "examples", "model_config"]
        }
      }
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings", "deterministicOnly", "missingProviderProfiles", "disabledProviderProfiles", "budgetExhausted"],
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
        "deterministicOnly": { "type": "boolean" },
        "missingProviderProfiles": { "type": "array", "items": { "type": "string" } },
        "disabledProviderProfiles": { "type": "array", "items": { "type": "string" } },
        "budgetExhausted": { "type": "boolean" }
      }
    }
  }
}
