{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-009",
  "title": "Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "datasetId", "datasetVersion", "scorerIds", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "datasetId": { "type": "string" },
    "datasetVersion": { "type": "integer", "minimum": 1 },
    "splitSelector": { "$ref": "./experiment-manifest.schema.json#/$defs/splitSelector" },
    "scorerIds": { "type": "array", "items": { "type": "string" } },
    "baselineRef": { "$ref": "./eval-run-ref.schema.json#/$defs/baselineRef" },
    "promptVersionRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "skillSnapshotRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "toolSnapshotRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "providerProfileRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "createdAt": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
