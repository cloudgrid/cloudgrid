{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-AIE-025",
  "title": "EvalAggregationViewModels",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [{ "$ref": "#/$defs/runSummary" }, { "$ref": "#/$defs/qualityOverview" }],
  "$defs": {
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCounts", "scoreSummaries", "problemCounts", "budgetUsage"],
      "properties": {
        "itemCounts": { "$ref": "#/$defs/itemCounts" },
        "scoreSummaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/scorerScoreSummary" }
        },
        "problemCounts": { "$ref": "#/$defs/problemCounts" },
        "budgetUsage": { "$ref": "#/$defs/budgetUsage" },
        "latency": { "$ref": "#/$defs/latencySummary" },
        "regressions": { "type": "array", "items": { "$ref": "#/$defs/regressionSummary" } }
      }
    },
    "qualityOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments", "trend", "skippedReasons", "candidateSuggestions"],
      "properties": {
        "segments": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/qualitySegment" }
        },
        "trend": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/trendPoint" }
        },
        "skippedReasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reasonCount" }
        },
        "candidateSuggestions": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/candidateSuggestionSummary" }
        }
      }
    },
    "itemCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "errored", "skipped", "needsReview", "quarantined"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "errored": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "needsReview": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 }
      }
    },
    "scorerScoreSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scorerId", "scorerVersion", "passRate", "meanScore", "support"],
      "properties": {
        "scorerId": { "type": "string" },
        "scorerVersion": { "type": "integer", "minimum": 1 },
        "resultKind": { "type": "string" },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanScore": { "type": "number" },
        "p50": { "type": "number" },
        "p95": { "type": "number" },
        "support": { "type": "integer", "minimum": 0 },
        "visualization": { "$ref": "./eval-result-payload.schema.json#/properties/visualization" }
      }
    },
    "problemCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelQuality": { "type": "integer", "minimum": 0 },
        "itemQuality": { "type": "integer", "minimum": 0 },
        "scorerConfig": { "type": "integer", "minimum": 0 },
        "infrastructure": { "type": "integer", "minimum": 0 }
      }
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "estimatedUsd": { "type": "number", "minimum": 0 }
      }
    },
    "latencySummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50Ms": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 },
        "maxMs": { "type": "number", "minimum": 0 }
      }
    },
    "regressionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count"],
      "properties": {
        "kind": { "type": "string", "enum": ["quality", "latency", "cost", "required_scorer"] },
        "count": { "type": "integer", "minimum": 0 },
        "blocker": { "type": "boolean" }
      }
    },
    "qualitySegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "passRate", "support"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanScore": { "type": "number" },
        "support": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "p95LatencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "trendPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucketStart", "support"],
      "properties": {
        "bucketStart": { "type": "string", "format": "date-time" },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanScore": { "type": "number" },
        "support": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "p95LatencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "reasonCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "candidateSuggestionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "clusterId": { "type": "string" },
        "datasetId": { "type": "string" }
      }
    }
  }
}
