{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-007",
  "title": "LogSearchQuery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "service": { "type": "string", "description": "Exact service name filter." },
    "traceId": { "type": "string", "description": "Exact trace ID filter." },
    "spanId": { "type": "string", "description": "Exact span ID filter." },
    "severity": { "type": "string", "description": "Severity text filter." },
    "from": { "type": "string", "format": "date-time", "description": "Inclusive start time." },
    "to": { "type": "string", "format": "date-time", "description": "Inclusive end time." },
    "search": {
      "type": "string",
      "description": "Case-insensitive text search over body and string attributes."
    },
    "attributes": {
      "type": "array",
      "items": { "$ref": "attribute-filter.schema.json" }
    },
    "sort": {
      "type": "string",
      "enum": ["timestamp_desc", "timestamp_asc", "severity_desc"],
      "default": "timestamp_desc"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50,
      "description": "Page size."
    },
    "cursor": { "type": "string", "description": "Opaque pagination cursor." }
  }
}
