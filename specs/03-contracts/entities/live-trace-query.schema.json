{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudgrid.dev/schemas/live-trace-query.schema.json",
  "title": "LiveTraceQuery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "service": { "type": "string" },
    "query": { "type": "string" },
    "operationName": { "type": "string" },
    "spanName": { "type": "string" },
    "from": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["ok", "error", "unset"] },
    "minDurationMs": { "type": "number", "minimum": 0 },
    "maxDurationMs": { "type": "number", "minimum": 0 },
    "attributes": {
      "type": "array",
      "items": { "$ref": "attribute-filter.schema.json" }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 100
    }
  }
}
