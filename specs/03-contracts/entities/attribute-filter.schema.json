{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec/cloudgrid/ent/ENT-010",
  "title": "AttributeFilter",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "operator"],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "Attribute key to filter on. Dot characters are literal key characters, not object traversal."
    },
    "operator": {
      "type": "string",
      "enum": ["eq", "neq", "contains", "exists", "gt", "gte", "lt", "lte", "in", "not_in"],
      "description": "Filter operator."
    },
    "value": {
      "description": "JSON-compatible comparison value. Required for all operators except exists."
    }
  }
}
