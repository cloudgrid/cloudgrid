CLOUDGRID_IMAGE_REGISTRY=ghcr.io/cloudgrid-dev
CLOUDGRID_IMAGE_TAG=v1.0.0-beta

CLOUDGRID_BFF_PORT=3000
CLOUDGRID_PUBLIC_URL=http://localhost:3000
CLOUDGRID_MESSAGE_BRIDGE_REQUEST_TIMEOUT_MS=6000
CLOUDGRID_AI_CHAT_HARNESS_MODE=provider

CLOUDGRID_OTLP_HTTP_PORT=4318
CLOUDGRID_OTLP_GRPC_PORT=4317
CLOUDGRID_OTLP_GRPC_MAX_MESSAGE_BYTES=4194304
CLOUDGRID_OTLP_GRPC_COMPRESSION=gzip
CLOUDGRID_OTLP_LOCAL_PROJECT_ID=default
# Optional JSON map for local multi-project ingest token routing.
# CLOUDGRID_OTLP_LOCAL_PROJECT_TOKENS={"replace-with-32-plus-random-chars":"default"}

CLOUDGRID_NATS_IMAGE_TAG=2.14.0
CLOUDGRID_NATS_PORT=4222
CLOUDGRID_NATS_MONITOR_PORT=8222
CLOUDGRID_NATS_MAX_PAYLOAD=8388608

CLOUDGRID_SURREALDB_IMAGE_TAG=v3.0.5
CLOUDGRID_SURREALDB_PORT=8000
CLOUDGRID_SURREALDB_NAMESPACE=observability
CLOUDGRID_SURREALDB_DATABASE=cloudgrid
CLOUDGRID_SURREALDB_USERNAME=root
CLOUDGRID_SURREALDB_PASSWORD=root

# Required when running deployed mode and storing managed AI provider API keys.
# CLOUDGRID_PROVIDER_SECRET_ENCRYPTION_KEY=

CLOUDGRID_SELF_OBSERVABILITY_ENABLED=false
CLOUDGRID_SELF_OBSERVABILITY_COMPANY_ID=local
CLOUDGRID_SELF_OBSERVABILITY_PROJECT_ID=cloudgrid-system
CLOUDGRID_SELF_OBSERVABILITY_OTLP_ENDPOINT=http://otlp-collector:4318

# Enable with: docker compose --profile ai-eval ...
# CLOUDGRID_AI_EVAL_HARNESS_URL=http://host.docker.internal:8090
