CLOUDGRID_NATS_IMAGE_TAG=2.14.0
CLOUDGRID_NATS_PORT=4222
CLOUDGRID_NATS_MONITOR_PORT=8222
CLOUDGRID_NATS_URL=nats://localhost:4222
CLOUDGRID_BFF_HOST=0.0.0.0
CLOUDGRID_BFF_PORT=3000
CLOUDGRID_GRAPHQL_MAX_DEPTH=12
CLOUDGRID_GRAPHQL_MAX_COMPLEXITY=500
CLOUDGRID_GRAPHQL_RESPONSE_MEDIA_TYPE=compatible
CLOUDGRID_FRONTEND_DEV_PORT=5173
CLOUDGRID_DEPLOYMENT_MODE=local
CLOUDGRID_AUTH_MODE=local
CLOUDGRID_SELF_OBSERVABILITY_ENABLED=true
CLOUDGRID_SELF_OBSERVABILITY_COMPANY_ID=local
CLOUDGRID_SELF_OBSERVABILITY_PROJECT_ID=cloudgrid-system
CLOUDGRID_SELF_OBSERVABILITY_OTLP_ENDPOINT=http://localhost:4318
CLOUDGRID_SELF_OBSERVABILITY_EXPORT_INTERVAL_SECONDS=10
CLOUDGRID_SELF_OBSERVABILITY_TRACES_ENABLED=true
CLOUDGRID_SELF_OBSERVABILITY_LOGS_ENABLED=true
CLOUDGRID_SELF_OBSERVABILITY_METRICS_ENABLED=true
# Required only when self-observability is enabled in deployed mode.
# CLOUDGRID_SELF_OBSERVABILITY_OTLP_BEARER_TOKEN=
# Required only when CLOUDGRID_DEPLOYMENT_MODE=deployed and CLOUDGRID_AUTH_MODE=sso.
# CLOUDGRID_AUTH_PROVIDERS=github,google,azure
# CLOUDGRID_AUTH_COMPANY_ID=acme
# CLOUDGRID_AUTH_GITHUB_CLIENT_ID=
# CLOUDGRID_AUTH_GITHUB_CLIENT_SECRET=
# CLOUDGRID_AUTH_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback
# CLOUDGRID_AUTH_GOOGLE_ISSUER=https://accounts.google.com
# CLOUDGRID_AUTH_GOOGLE_AUDIENCE=
# CLOUDGRID_AUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# CLOUDGRID_AUTH_GOOGLE_CLIENT_ID=
# CLOUDGRID_AUTH_GOOGLE_CLIENT_SECRET=
# CLOUDGRID_AUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# CLOUDGRID_AUTH_AZURE_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# CLOUDGRID_AUTH_AZURE_AUDIENCE=
# CLOUDGRID_AUTH_AZURE_CLIENT_ID=
# CLOUDGRID_AUTH_AZURE_CLIENT_SECRET=
# CLOUDGRID_AUTH_AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
# CLOUDGRID_SESSION_SECRET=
# CLOUDGRID_SESSION_TTL_SECONDS=28800
CLOUDGRID_PUBLIC_URL=http://localhost:3000
CLOUDGRID_INVITATION_EMAIL_MODE=disabled
CLOUDGRID_INVITATION_EMAIL_REQUIRE_DELIVERY=false
# Required when deployed SSO invitation email delivery uses SMTP.
# CLOUDGRID_INVITATION_EMAIL_FROM=CloudGrid <noreply@example.com>
# CLOUDGRID_INVITATION_EMAIL_REPLY_TO=
# CLOUDGRID_INVITATION_EMAIL_SMTP_HOST=smtp.example.com
# CLOUDGRID_INVITATION_EMAIL_SMTP_PORT=587
# CLOUDGRID_INVITATION_EMAIL_SMTP_USERNAME=
# CLOUDGRID_INVITATION_EMAIL_SMTP_PASSWORD=
# CLOUDGRID_INVITATION_EMAIL_SMTP_TLS=starttls
# CLOUDGRID_INVITATION_EMAIL_SMTP_TIMEOUT_MS=10000
# CLOUDGRID_INVITATION_EMAIL_MAX_ATTEMPTS=5
# CLOUDGRID_INVITATION_EMAIL_RETRY_BASE_SECONDS=60
CLOUDGRID_OTLP_HTTP_ADDR=0.0.0.0:4318
CLOUDGRID_OTLP_MAX_REQUEST_BYTES=4194304
CLOUDGRID_OTLP_MAX_SPANS_PER_REQUEST=10000
CLOUDGRID_OTLP_MAX_LOGS_PER_REQUEST=10000
CLOUDGRID_OTLP_MAX_METRIC_POINTS_PER_REQUEST=20000
CLOUDGRID_OTLP_PUBLISH_TIMEOUT_MS=1000
CLOUDGRID_OTLP_GRPC_ADDR=0.0.0.0:4317
CLOUDGRID_OTLP_GRPC_MAX_MESSAGE_BYTES=4194304
CLOUDGRID_OTLP_GRPC_COMPRESSION=gzip
CLOUDGRID_PROJECT_STATUS_CACHE_TTL_SECONDS=60
CLOUDGRID_PROJECT_STATUS_CACHE_STALE_SECONDS=120
# Optional single-project local ingest fallback. Default local ingest does not
# need CLOUDGRID_PROJECT_API_KEY. For multiple local projects, configure
# CLOUDGRID_OTLP_LOCAL_PROJECT_TOKENS and set CLOUDGRID_PROJECT_API_KEY in each
# instrumented service.
CLOUDGRID_OTLP_LOCAL_PROJECT_ID=default
# Example shape only. Do not use this token value.
# CLOUDGRID_OTLP_LOCAL_PROJECT_TOKENS={"replace-with-32-plus-random-chars":"default"}
CLOUDGRID_CONTROL_PLANE_HEALTH_HOST=0.0.0.0
CLOUDGRID_CONTROL_PLANE_HEALTH_PORT=8084
CLOUDGRID_STORAGE_READ_HEALTH_HOST=0.0.0.0
CLOUDGRID_STORAGE_READ_HEALTH_PORT=8081
CLOUDGRID_STORAGE_READ_QUERY_TIMEOUT_MS=1500
CLOUDGRID_STORAGE_READ_MAX_PAGE_SIZE=200
CLOUDGRID_STORAGE_READ_MAX_METRIC_POINTS=5000
CLOUDGRID_LIVE_MAX_SUBSCRIPTIONS=2000
CLOUDGRID_LIVE_EVENT_BUFFER_SIZE=100
CLOUDGRID_STORAGE_WRITE_HEALTH_HOST=0.0.0.0
CLOUDGRID_STORAGE_WRITE_HEALTH_PORT=8082
CLOUDGRID_STORAGE_MAINTENANCE_HEALTH_HOST=0.0.0.0
CLOUDGRID_STORAGE_MAINTENANCE_HEALTH_PORT=8087
CLOUDGRID_RETENTION_SCHEDULER_ENABLED=false
CLOUDGRID_RETENTION_SCHEDULER_INTERVAL_SECONDS=3600
# Required only when CLOUDGRID_RETENTION_SCHEDULER_ENABLED=true.
# CLOUDGRID_RETENTION_SCHEDULER_PROJECT_IDS=default
CLOUDGRID_RETENTION_BATCH_LIMIT=1000
CLOUDGRID_RETENTION_LEASE_SECONDS=900
CLOUDGRID_AI_EVAL_ENABLED=false
CLOUDGRID_AI_EVAL_RUNNER_HEALTH_HOST=0.0.0.0
CLOUDGRID_AI_EVAL_RUNNER_HEALTH_PORT=8085
# Required only when CLOUDGRID_AI_EVAL_ENABLED=true.
# CLOUDGRID_AI_EVAL_HARNESS_URL=http://localhost:8090
CLOUDGRID_STORAGE_ADAPTER=surrealdb
CLOUDGRID_FRONTEND_SERVE_STATIC=false
CLOUDGRID_FRONTEND_STATIC_DIR=./apps/backend/public
CLOUDGRID_SURREALDB_IMAGE_TAG=v3.0.5
CLOUDGRID_SURREALDB_PORT=8000
CLOUDGRID_SURREALDB_URL=http://localhost:8000/rpc
CLOUDGRID_SURREALDB_NAMESPACE=observability
CLOUDGRID_SURREALDB_DATABASE=dev
CLOUDGRID_SURREALDB_USERNAME=root
CLOUDGRID_SURREALDB_PASSWORD=root
